<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Effigy</RootNamespace>
    <AssemblyName>Effigy.Kernel</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The SDK stamps the git commit into InformationalVersion, which changed this assembly's
         ModuleVersionId (the StudioCache key) on EVERY commit, even with no kernel edit: a viewer and a
         writer built at different commits then missed every cache entry (~16 s rebuild per live revision).
         Pinned to the value the kernel was built with on 2026-10-24 so existing caches stay warm. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>1.0.0+4af78c252dd5b9b0b362f7292f7798c9be304f20</InformationalVersion>
  </PropertyGroup>

  <!--
    Standalone engine-free Effigy kernel assembly.
    Keeping the kernel in its own deterministic assembly ensures:
      1. Effigy cannot accidentally depend on Silk.NET or desktop UI types.
      2. Editing Marionette.Desktop files does not change typeof(PartStudio).Assembly's
         ModuleVersionId, so ~/.cache/effigy/*.cache stays warm across app builds.
  -->
  <ItemGroup>
    <Compile Include="Effigy/**/*.cs" />
  </ItemGroup>

</Project>
