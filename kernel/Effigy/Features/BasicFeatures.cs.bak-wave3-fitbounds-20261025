using System;
using System.Collections.Generic;
using System.Linq;

namespace Effigy;

/// <summary>
/// Creates a primitive solid. Onshape's own Primitives feature works this way — one dropdown, and
/// the dialog shows only the fields that shape actually has.
///
/// Parameters deliberately changes with Shape rather than showing every field greyed out. That is
/// the behaviour being copied: a box dialog asks for three lengths and nothing else.
/// </summary>
public sealed class PrimitiveFeature : Feature
{
	public override string TypeName => Shape.Value;

	public readonly ChoiceParam Shape = new( "Shape",
		new[] { "Box", "Cylinder", "Sphere", "Wedge", "Tube", "Torus", "Cone", "Capsule", "Plane" } );

	public readonly FloatParam SizeX = new( "Width", 1f, 0.0001f, unit: "u" );
	public readonly FloatParam SizeY = new( "Depth", 1f, 0.0001f, unit: "u" );
	public readonly FloatParam SizeZ = new( "Height", 1f, 0.0001f, unit: "u" );
	public readonly FloatParam Radius = new( "Radius", 0.5f, 0.0001f, unit: "u" );
	public readonly FloatParam InnerRadius = new( "Inner radius", 0.3f, 0f, unit: "u" );
    public readonly FloatParam TubeRadius = new( "Tube radius", 0.5f, 0.0001f, unit: "u" );
	public readonly IntParam Segments = new( "Segments", 16, 3, 512 );
	public readonly IntParam Divisions = new( "Divisions", 4, 1, 64 );
	public readonly Vec3Param Position = new( "Position", Vec3.Zero );

	/// <summary>
	/// Per-axis scale, applied about the primitive's own origin before it is moved into place.
	///
	/// NOT THE SAME THING AS THE SIZE PARAMETERS, and worth having alongside them. Width/Depth/
	/// Height build the shape at a size; this stretches whatever was built, which is the only way
	/// to get an ellipsoid out of a sphere or an oval tube out of a round one — those are defined
	/// by a radius and have no per-axis size to set.
	/// </summary>
	public readonly Vec3Param Scale = new( "Scale", Vec3.One );

	/// <summary>
	/// Whether the dialog keeps the three scale axes equal as you edit one of them.
	///
	/// A UI CONVENIENCE THAT IS PERSISTED, not something the kernel enforces. Scale stays the
	/// single truth about the shape — Execute reads all three axes and never consults this — so a
	/// document always builds exactly what its three numbers say. This only rides along so the
	/// dialog can remember that you were editing that primitive uniformly.
	/// </summary>
	public readonly BoolParam UniformScale = new( "Uniform scale", false );

	public readonly IntParam Material = new( "Material slot", 0, 0, 63 ) { Slider = false };

	/// <summary>A turn about an axis through the primitive's own origin, applied before Position —
	/// a cylinder lying along x is an axle, a wedge on its side is a roof. Folded away: most
	/// primitives stand as they come.</summary>
	public readonly Vec3Param RotationAxis = new( "Rotation axis", new Vec3( 0, 0, 1 ) );
	public readonly FloatParam RotationAngle = new( "Rotation", 0f, unit: "deg" );

	/// <summary>The slot, folded away with the other features' — a primitive is placed and sized,
	/// and painted later from the Materials panel.</summary>
	public override IReadOnlyList<IParam> AdvancedParameters => new IParam[] { RotationAxis, RotationAngle, Material };

	public override IReadOnlyList<IParam> Parameters => Shape.Value switch
	{
		"Box" => new IParam[] { Shape, SizeX, SizeY, SizeZ, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		"Cylinder" => new IParam[] { Shape, Radius, SizeZ, Segments, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		"Sphere" => new IParam[] { Shape, Radius, Divisions, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		"Wedge" => new IParam[] { Shape, SizeX, SizeY, SizeZ, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		"Tube" => new IParam[] { Shape, Radius, InnerRadius, SizeZ, Segments, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
        "Torus" => new IParam[] { Shape, Radius, TubeRadius, Segments, Divisions, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		"Cone" => new IParam[] { Shape, Radius, SizeZ, Segments, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		"Capsule" => new IParam[] { Shape, Radius, SizeZ, Segments, Divisions, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		"Plane" => new IParam[] { Shape, SizeX, SizeY, Segments, Position, Scale, UniformScale, RotationAxis, RotationAngle, Material },
		_ => new IParam[] { Shape }
	};

	protected override void Execute( FeatureContext ctx )
	{
		var mesh = Shape.Value switch
		{
			"Box" => Primitives.Box( SizeX.Clamped, SizeY.Clamped, SizeZ.Clamped, Material.Clamped ),
			"Cylinder" => Primitives.Cylinder( Radius.Clamped, SizeZ.Clamped, Segments.Clamped, Material.Clamped ),
			"Sphere" => Primitives.QuadSphere( Radius.Clamped, Divisions.Clamped, Material.Clamped ),
			"Wedge" => Primitives.Wedge( SizeX.Clamped, SizeY.Clamped, SizeZ.Clamped, Material.Clamped ),
			"Tube" => BuildTube(),
            "Torus" => BuildTorus(),
			"Cone" => BuildCone(),
			"Capsule" => BuildCapsule(),
			"Plane" => Primitives.Plane( SizeX.Clamped, SizeY.Clamped, Segments.Clamped, Segments.Clamped, Material.Clamped ),
			_ => throw new FeatureException( new FeatureDiagnostic(
				DiagnosticSeverity.Error,
				$"unknown shape '{Shape.Value}'",
				"The shape dropdown has a value this feature does not build.",
				"Shape",
				remedies: new[] { "Pick Box, Cylinder, Sphere, Wedge, Tube, Torus, Cone, Capsule or Plane" } ) )
		};

		var scale = Scale.Value;

		if ( scale.x == 0f || scale.y == 0f || scale.z == 0f )
		{
			FailOn( "Scale",
				"Scale cannot be zero on any axis",
				$"Scale is ({scale.x:0.###}, {scale.y:0.###}, {scale.z:0.###}). A zero axis flattens the solid to nothing.",
				"Set every scale axis to a non-zero value" );
		}

		// SCALE FIRST, ABOUT THE PRIMITIVE'S OWN ORIGIN. Applied after the translate it would
		// multiply the position too, so nudging a scaled box would move it by the scale factor and
		// the number in the Position field would stop meaning where the box is.
		if ( scale.x != 1f || scale.y != 1f || scale.z != 1f )
			MeshTransform.Apply( mesh, Xform.Scale( scale ) );

		if ( RotationAngle.Value != 0f && RotationAxis.Value.LengthSquared > 1e-8f )
			MeshTransform.Apply( mesh, Xform.Rotate( RotationAxis.Value.Normal, RotationAngle.Value * MathF.PI / 180f ) );

		if ( Position.Value.LengthSquared > 0f )
			MeshTransform.Apply( mesh, Xform.Translate( Position.Value ) );

		ctx.Bodies.Add( new Body( ctx.NewBodyId(), Name, mesh ) );
	}

	PolyMesh BuildTube()
	{
		// Caught here rather than left to Primitives, so the message names the parameter the user
		// can actually see in the dialog.
		if ( InnerRadius.Clamped >= Radius.Clamped )
		{
			FailOn( "Inner radius",
				"Inner radius must be smaller than radius",
				$"Inner radius is {InnerRadius.Clamped:0.###} and radius is {Radius.Clamped:0.###}.",
				"Reduce Inner radius",
				"Increase Radius" );
		}

		return Primitives.Tube( Radius.Clamped, InnerRadius.Clamped, SizeZ.Clamped, Segments.Clamped, Material.Clamped );
	}

	PolyMesh BuildTorus()
	{
		if ( TubeRadius.Clamped >= Radius.Clamped )
		{
			FailOn( "Tube radius",
				"Tube radius must be smaller than radius",
				$"Tube radius is {TubeRadius.Clamped:0.###} and radius is {Radius.Clamped:0.###}.",
				"Reduce Tube radius",
				"Increase Radius" );
		}

		return Primitives.Torus( Radius.Clamped, TubeRadius.Clamped, Segments.Clamped, Divisions.Clamped, Material.Clamped );
	}

	PolyMesh BuildCone()
	{
		if ( Radius.Clamped <= 0f )
		{
			FailOn( "Radius",
				"Radius must be greater than 0",
				$"Radius is {Radius.Clamped:0.###}.",
				"Increase Radius" );
		}
		if ( SizeZ.Clamped <= 0f )
		{
			FailOn( "Height",
				"Height must be greater than 0",
				$"Height is {SizeZ.Clamped:0.###}.",
				"Increase Height" );
		}

		return Primitives.Cone( Radius.Clamped, SizeZ.Clamped, Segments.Clamped, Material.Clamped );
	}

	PolyMesh BuildCapsule()
	{
		// Height is the total pole-to-pole height; the straight section is
		// height - 2*radius, so a shorter height cannot be a capsule at all.
		if ( SizeZ.Clamped < 2f * Radius.Clamped )
		{
			FailOn( "Height",
				"Height must be at least twice the radius for a capsule",
				$"Height is {SizeZ.Clamped:0.###} and radius is {Radius.Clamped:0.###}, so the straight section would be {SizeZ.Clamped - 2f * Radius.Clamped:0.###}.",
				"Increase Height",
				"Reduce Radius" );
		}
		if ( Divisions.Clamped < 1 )
		{
			FailOn( "Divisions",
				"Cap segments must be at least 1",
				$"Divisions is {Divisions.Clamped}.",
				"Increase Divisions" );
		}

		return Primitives.Capsule( Radius.Clamped, SizeZ.Clamped, Segments.Clamped, Divisions.Clamped, Material.Clamped );
	}
}

/// <summary>Move, rotate and scale bodies. Onshape's Transform.</summary>
public sealed class TransformFeature : Feature
{
	public override string TypeName => "Transform";

	public override GeometryKind Accepts => GeometryKind.Body;

	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly Vec3Param Translate = new( "Translate", Vec3.Zero );
	public readonly Vec3Param RotationAxis = new( "Rotation axis", new Vec3( 0, 0, 1 ) );
	public readonly FloatParam RotationAngle = new( "Angle", 0f, unit: "deg" );
	public readonly Vec3Param Scale = new( "Scale", Vec3.One );

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Bodies, Translate, RotationAxis, RotationAngle, Scale };

	protected override void Execute( FeatureContext ctx )
	{
		var scale = Scale.Value;

		if ( scale.x == 0f || scale.y == 0f || scale.z == 0f )
		{
			FailOn( "Scale",
				"Scale cannot be zero on any axis",
				$"Scale is ({scale.x:0.###}, {scale.y:0.###}, {scale.z:0.###}). A zero axis flattens the solid to nothing.",
				"Set every scale axis to a non-zero value" );
		}

		// A zero axis with an angle used to rotate by nothing at all (Xform.Rotate falls back to the
		// identity), so the angle field looked broken. No angle, no axis needed.
		if ( RotationAngle.Value != 0f && RotationAxis.Value.LengthSquared < 1e-12f )
		{
			FailOn( "Rotation axis",
				"Rotation axis can't be zero",
				$"The angle is {RotationAngle.Value:0.###}°, but the axis (0, 0, 0) points nowhere, so there is nothing to turn about.",
				"Set Rotation axis to the direction to turn about - (0, 0, 1) turns about up",
				"Set Angle to 0 to not rotate" );
		}

		// Scale, then rotate, then translate — the order a user expects, and the one that keeps a
		// rotation about the origin from being skewed by a non-uniform scale applied after it.
		var xform =
			Xform.Translate( Translate.Value )
			* Xform.Rotate( RotationAxis.Value, RotationAngle.Value * MathF.PI / 180f )
			* Xform.Scale( scale );

		foreach ( var body in RequireBodies( ctx, Bodies ) )
			MeshTransform.Apply( body.Mesh, xform );
	}
}

/// <summary>Shared variation for pattern features: skip, and jitter applied to a placed copy about its own centre. Spacing/step is never jittered — jitter moves the instance, never the step.</summary>
static class PatternVariation
{
	public static bool Skip( int i, int skipEvery, float skipProb, Random rng )
	{
		if ( skipEvery > 0 && i % skipEvery == 0 )
			return true;

		if ( skipProb > 0f && (float)rng.NextDouble() < skipProb )
			return true;

		return false;
	}

	public static Vec3 Centroid( PolyMesh mesh )
	{
		var c = new Vec3( 0, 0, 0 );

		if ( mesh.Positions.Count == 0 )
			return c;

		foreach ( var p in mesh.Positions )
			c += p;

		return c * (1f / mesh.Positions.Count);
	}

	public static int TriCount( PolyMesh mesh )
	{
		var t = 0;

		foreach ( var f in mesh.Faces )
			t += Math.Max( 0, f.Count - 2 );

		return t;
	}

	public static PolyMesh Jittered( PolyMesh original, Xform placement, float scaleJitter, float rotJitterDeg, Vec3 rotAxis, float posJitter, float posStep, Vec3 posDirA, Vec3 posDirB, Random rng )
	{
		var copy = MeshTransform.Transformed( original, placement );
		var c = Centroid( copy );

		if ( scaleJitter > 0f )
		{
			var f = MathF.Max( 0.05f, 1f + (float)(rng.NextDouble() * 2 - 1) * scaleJitter );
			MeshTransform.Apply( copy, Xform.Translate( c ) * Xform.Scale( new Vec3( f, f, f ) ) * Xform.Translate( -c ) );
		}

		if ( rotJitterDeg > 0f )
		{
			var a = (float)(rng.NextDouble() * 2 - 1) * rotJitterDeg * MathF.PI / 180f;
			MeshTransform.Apply( copy, Xform.RotateAbout( c, rotAxis, a ) );
		}

		if ( posJitter > 0f && posStep > 0f )
		{
			var o = posDirA * ((float)(rng.NextDouble() * 2 - 1) * posJitter * posStep)
				+ posDirB * ((float)(rng.NextDouble() * 2 - 1) * posJitter * posStep);
			MeshTransform.Apply( copy, Xform.Translate( o ) );
		}

		return copy;
	}
}

/// <summary>Copies along a direction. Onshape's Linear pattern.</summary>
public sealed class LinearPatternFeature : Feature
{
	public override string TypeName => "Linear pattern";

	public override GeometryKind Accepts => GeometryKind.Body;

	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly Vec3Param Direction = new( "Direction", new Vec3( 1, 0, 0 ) );
	public readonly FloatParam Spacing = new( "Spacing", 1f, unit: "u" );
	public readonly IntParam Count = new( "Instances", 3, 1, 4096 );
	public readonly BoolParam Merge = new( "Merge into one body", false );
	public readonly IntParam Seed = new( "Seed", 0, 0, 1000000 );
	public readonly FloatParam ScaleJitter = new( "Scale jitter", 0f, 0f, 1f );
	public readonly FloatParam RotJitter = new( "Rot jitter", 0f, 0f, 180f, "deg" );
	public readonly FloatParam PosJitter = new( "Pos jitter", 0f, 0f, 0.5f );
	public readonly IntParam SkipEvery = new( "Skip every", 0, 0, 4096 );
	public readonly FloatParam SkipProb = new( "Skip probability", 0f, 0f, 1f );
	public readonly FloatParam FitLength = new( "Fit length", 0f, 0f, 100000f, "u" );

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Bodies, Direction, Spacing, Count, Merge, Seed, ScaleJitter, RotJitter, PosJitter, SkipEvery, SkipProb, FitLength };

	protected override void Execute( FeatureContext ctx )
	{
		if ( Direction.Value.LengthSquared < 1e-12f )
		{
			FailOn( "Direction",
				"Direction cannot be zero",
				"A linear pattern copies along a direction, and this one has no length, so there is nowhere to put the copies.",
				"Set Direction to the axis you want the copies to run along" );
		}

		var dir = Direction.Value.Normal;
		var sources = RequireBodies( ctx, Bodies );
		var step = FitLength.Clamped > 0f && Count.Clamped > 1 ? FitLength.Clamped / (Count.Clamped - 1) : Spacing.Value;
		var rng = new Random( Seed.Clamped );
		var perp = MathF.Abs( dir.y ) < 0.9f ? Vec3.Cross( dir, new Vec3( 0, 1, 0 ) ).Normal : Vec3.Cross( dir, new Vec3( 1, 0, 0 ) ).Normal;
		var perp2 = Vec3.Cross( dir, perp );

		// Instance 0 is the original, so a count of 3 means the original plus two copies — which
		// is what Onshape's instance count means too.
		foreach ( var source in sources )
		{
			// Snapshot BEFORE the loop. With Merge on, the loop appends into source.Mesh, so
			// reading source.Mesh each iteration would copy the copies too and the instance count
			// would double rather than increment: 6, 12, 24, 48 faces instead of 6, 12, 18, 24.
			var original = source.Mesh.Clone();
			var emitted = 0;

			for ( var i = 1; i < Count.Clamped; i++ )
			{
				if ( PatternVariation.Skip( i, SkipEvery.Clamped, SkipProb.Clamped, rng ) )
					continue;

				var copy = PatternVariation.Jittered( original, Xform.Translate( dir * (step * i) ), ScaleJitter.Clamped, RotJitter.Clamped, dir, PosJitter.Clamped, step, perp, perp2, rng );
				emitted++;

				if ( Merge.Value )
					MeshWeldMerge.WeldInto( source.Mesh, copy );
				else
					ctx.Bodies.Add( new Body( ctx.NewBodyId(), $"{Name} {i}", copy ) );
			}

			var totalTris = Merge.Value ? PatternVariation.TriCount( source.Mesh ) : PatternVariation.TriCount( original ) * emitted;

			if ( totalTris > 200000 )
				Warn( $"Linear pattern emitted about {totalTris} triangles.", "Large patterns get heavy to edit, save and render.", "Lower Instances", "Use a lower-poly source" );
		}
	}
}

/// <summary>Copies around an axis. Onshape's Circular pattern.</summary>
public sealed class CircularPatternFeature : Feature
{
	public override string TypeName => "Circular pattern";

	public override GeometryKind Accepts => GeometryKind.Body;

	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly Vec3Param AxisPoint = new( "Axis through", Vec3.Zero );
	public readonly Vec3Param AxisDirection = new( "Axis", new Vec3( 0, 0, 1 ) );
	public readonly IntParam Count = new( "Instances", 4, 1, 4096 );
	public readonly FloatParam TotalAngle = new( "Angle", 360f, unit: "deg" );
	public readonly BoolParam Merge = new( "Merge into one body", false );
	public readonly IntParam Seed = new( "Seed", 0, 0, 1000000 );
	public readonly FloatParam ScaleJitter = new( "Scale jitter", 0f, 0f, 1f );
	public readonly FloatParam RotJitter = new( "Rot jitter", 0f, 0f, 180f, "deg" );
	public readonly FloatParam PosJitter = new( "Pos jitter", 0f, 0f, 0.5f );
	public readonly IntParam SkipEvery = new( "Skip every", 0, 0, 4096 );
	public readonly FloatParam SkipProb = new( "Skip probability", 0f, 0f, 1f );

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Bodies, AxisPoint, AxisDirection, Count, TotalAngle, Merge, Seed, ScaleJitter, RotJitter, PosJitter, SkipEvery, SkipProb };

	protected override void Execute( FeatureContext ctx )
	{
		if ( AxisDirection.Value.LengthSquared < 1e-12f )
		{
			FailOn( "Axis",
				"Axis cannot be zero",
				"A circular pattern spins around an axis, and this one has no length.",
				"Set Axis to the direction to spin around" );
		}

		var sources = RequireBodies( ctx, Bodies );

		var count = Count.Clamped;

		// A full turn puts instance N back on instance 0, so the step divides by count. A partial
		// sweep spreads the instances across the arc inclusive of both ends instead.
		var full = MathF.Abs( MathF.Abs( TotalAngle.Value ) - 360f ) < 1e-3f;
		var step = count <= 1 ? 0f : TotalAngle.Value / (full ? count : count - 1);
		var rng = new Random( Seed.Clamped );
		var axisDir = AxisDirection.Value.Normal;

		foreach ( var source in sources )
		{
			// Snapshot before the loop — same compounding trap as the linear pattern.
			var original = source.Mesh.Clone();
			var origCentroid = PatternVariation.Centroid( original );
			var emitted = 0;

			for ( var i = 1; i < count; i++ )
			{
				if ( PatternVariation.Skip( i, SkipEvery.Clamped, SkipProb.Clamped, rng ) )
					continue;

				var xform = Xform.RotateAbout(
					AxisPoint.Value, AxisDirection.Value, step * i * MathF.PI / 180f );
				var placedCentroid = xform.TransformPoint( origCentroid );
				var radialVec = placedCentroid - AxisPoint.Value;
				radialVec -= axisDir * Vec3.Dot( radialVec, axisDir );
				var radius = radialVec.Length;
				var radial = radius > 1e-6f ? radialVec * (1f / radius) : new Vec3( 1, 0, 0 );
				var arcStep = MathF.Abs( step ) * MathF.PI / 180f * radius;
				var copy = PatternVariation.Jittered( original, xform, ScaleJitter.Clamped, RotJitter.Clamped, axisDir, PosJitter.Clamped, arcStep, radial, axisDir, rng );
				emitted++;

				if ( Merge.Value )
					MeshWeldMerge.WeldInto( source.Mesh, copy );
				else
					ctx.Bodies.Add( new Body( ctx.NewBodyId(), $"{Name} {i}", copy ) );
			}

			var totalTris = Merge.Value ? PatternVariation.TriCount( source.Mesh ) : PatternVariation.TriCount( original ) * emitted;

			if ( totalTris > 200000 )
				Warn( $"Circular pattern emitted about {totalTris} triangles.", "Large patterns get heavy to edit, save and render.", "Lower Instances", "Use a lower-poly source" );
		}
	}
}

/// <summary>Copies along a named Spline, source +z along the curve tangent, with a
/// parallel-transport frame so the run does not twist. Spacing 0 means fit Count
/// samples along the whole curve; Spacing above 0 steps by arc length (capped by
/// Instances). The source body itself stays where it was; copies ride the curve.
/// Variation knobs match Linear/Circular patterns: jitter moves the instance,
/// never the step, and Skip counts samples from 1.</summary>
public sealed class CurvePatternFeature : Feature
{
	public override string TypeName => "Curve pattern";

	public override GeometryKind Accepts => GeometryKind.Body;

	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly StringParam Curve = new( "Curve", "" );
	public readonly IntParam Count = new( "Instances", 8, 1, 4096 );
	public readonly FloatParam Spacing = new( "Spacing", 0f, 0f, 100000f, "u" );
	public readonly BoolParam Merge = new( "Merge into one body", false );
	public readonly IntParam Seed = new( "Seed", 0, 0, 1000000 );
	public readonly FloatParam ScaleJitter = new( "Scale jitter", 0f, 0f, 1f );
	public readonly FloatParam RotJitter = new( "Rot jitter", 0f, 0f, 180f, "deg" );
	public readonly FloatParam PosJitter = new( "Pos jitter", 0f, 0f, 0.5f );
	public readonly IntParam SkipEvery = new( "Skip every", 0, 0, 4096 );
	public readonly FloatParam SkipProb = new( "Skip probability", 0f, 0f, 1f );

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Bodies, Curve, Count, Spacing, Merge, Seed, ScaleJitter, RotJitter, PosJitter, SkipEvery, SkipProb };

	protected override void Execute( FeatureContext ctx )
	{
		var sources = RequireBodies( ctx, Bodies );

		if ( string.IsNullOrWhiteSpace( Curve.Value ) )
			Fail( "Curve pattern needs a curve.", "Curve is empty, so there is no path to run along.", "Name a Spline feature that has run before this one" );

		if ( !ctx.Splines.TryGetValue( Curve.Value, out var spline ) )
			Fail( "Curve pattern's curve is not above it.", $"Curve names '{Curve.Value}', which is not a Spline feature that has run before this one.", "Add the Spline first", "Check the name in Curve" );

		var polyline = spline.Sample( 8 );

		if ( polyline.Count < 2 )
			Fail( "Curve pattern's curve has fewer than two points.", "A curve needs a path to run along.", "Give the Spline two or more points" );

		var n = polyline.Count;
		var closed = spline.Closed;
		var lengths = new List<float> { 0f };
		var total = 0f;

		for ( var i = 0; i < n; i++ )
		{
			var next = closed ? polyline[(i + 1) % n] : i + 1 < n ? polyline[i + 1] : polyline[i];
			var segLen = (next - polyline[i]).Length;
			total += segLen;
			lengths.Add( total );
		}

		if ( total <= 0f )
			Fail( "Curve pattern's curve has no length.", "All of its points sit in one place.", "Spread the Spline points out" );

		Vec3 PointAt( float d )
		{
			var seg = 0;

			while ( seg < n - 1 && lengths[seg + 1] < d )
				seg++;

			var segLen = lengths[seg + 1] - lengths[seg];
			var t = segLen <= 0f ? 0f : (d - lengths[seg]) / segLen;
			var a = polyline[seg];
			var b = closed ? polyline[(seg + 1) % n] : polyline[Math.Min( seg + 1, n - 1 )];
			return a + (b - a) * t;
		}

		var samples = new List<Vec3>();
		float stepLen;

		if ( Spacing.Clamped > 0f )
		{
			stepLen = Spacing.Clamped;
			var steps = closed ? (int)MathF.Floor( total / stepLen ) : (int)MathF.Floor( total / stepLen ) + 1;
			steps = Math.Max( 1, Math.Min( steps, Count.Clamped ) );

			for ( var k = 0; k < steps; k++ )
				samples.Add( PointAt( k * stepLen ) );
		}
		else
		{
			var count = Count.Clamped;
			stepLen = closed ? total / count : total / Math.Max( 1, count - 1 );

			for ( var k = 0; k < count; k++ )
				samples.Add( PointAt( k * stepLen ) );
		}

		var m = samples.Count;
		var tangents = new List<Vec3>();
		var xs = new List<Vec3>();

		for ( var i = 0; i < m; i++ )
		{
			var prev = closed ? samples[(i - 1 + m) % m] : samples[Math.Max( 0, i - 1 )];
			var next = closed ? samples[(i + 1) % m] : samples[Math.Min( m - 1, i + 1 )];
			var tangent = next - prev;
			tangent = tangent.LengthSquared < 1e-12f ? new Vec3( 0, 0, 1 ) : tangent.Normal;
			tangents.Add( tangent );

			Vec3 x;

			if ( i == 0 )
			{
				var helper = MathF.Abs( tangent.y ) < 0.9f ? new Vec3( 0, 1, 0 ) : new Vec3( 1, 0, 0 );
				x = Vec3.Cross( helper, tangent ).Normal;
			}
			else
			{
				x = xs[i - 1] - tangent * Vec3.Dot( xs[i - 1], tangent );

				if ( x.LengthSquared < 1e-6f )
				{
					var helper = MathF.Abs( tangent.y ) < 0.9f ? new Vec3( 0, 1, 0 ) : new Vec3( 1, 0, 0 );
					x = Vec3.Cross( helper, tangent ).Normal;
				}
				else
					x = x.Normal;
			}

			xs.Add( x );
		}

		var rng = new Random( Seed.Clamped );

		foreach ( var source in sources )
		{
			var original = source.Mesh.Clone();
			var emitted = 0;

			for ( var i = 0; i < m; i++ )
			{
				if ( PatternVariation.Skip( i + 1, SkipEvery.Clamped, SkipProb.Clamped, rng ) )
					continue;

				var y = Vec3.Cross( tangents[i], xs[i] );
				var frame = new Xform( xs[i], y, tangents[i], samples[i] );
				var copy = PatternVariation.Jittered( original, frame, ScaleJitter.Clamped, RotJitter.Clamped, tangents[i], PosJitter.Clamped, stepLen, xs[i], y, rng );
				emitted++;

				if ( Merge.Value )
					MeshWeldMerge.WeldInto( source.Mesh, copy );
				else
					ctx.Bodies.Add( new Body( ctx.NewBodyId(), $"{Name} {i}", copy ) );
			}

			var totalTris = Merge.Value ? PatternVariation.TriCount( source.Mesh ) : PatternVariation.TriCount( original ) * emitted;

			if ( totalTris > 200000 )
				Warn( $"Curve pattern emitted about {totalTris} triangles.", "Large patterns get heavy to edit, save and render.", "Lower Instances", "Use a lower-poly source" );
		}
	}
}

/// <summary>Reflects bodies in a plane. Onshape's Mirror.</summary>
public sealed class MirrorFeature : Feature
{
	public override string TypeName => "Mirror";

	public override GeometryKind Accepts => GeometryKind.Body;

	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly Vec3Param PlanePoint = new( "Plane through", Vec3.Zero );
	public readonly Vec3Param PlaneNormal = new( "Plane normal", new Vec3( 1, 0, 0 ) );
	public readonly BoolParam KeepOriginal = new( "Keep original", true );
	public readonly BoolParam Merge = new( "Merge into one body", false );

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Bodies, PlanePoint, PlaneNormal, KeepOriginal, Merge };

	protected override void Execute( FeatureContext ctx )
	{
		if ( PlaneNormal.Value.LengthSquared < 1e-12f )
		{
			FailOn( "Plane normal",
				"Plane normal cannot be zero",
				"A mirror needs a plane to reflect across, and a zero normal does not define one.",
				"Set Plane normal to the direction the mirror should face" );
		}

		var xform = Xform.Mirror( PlanePoint.Value, PlaneNormal.Value );
		var sources = RequireBodies( ctx, Bodies );

		foreach ( var source in sources )
		{
			// MeshTransform.Apply reverses winding for us — the mirror flips handedness, and
			// without that reversal every mirrored face would point into the solid.
			var copy = MeshTransform.Transformed( source.Mesh, xform );

			// Bone flip (roadmap J): a mirrored copy used to keep the ORIGINAL side's
			// bone indices, so a mirrored left arm bent with the right arm's bones.
			// Remap before the copy is added or welded, so both paths get flipped
			// weights. Without a rig in the studio there is nothing to flip against,
			// and weights carry by index as before; a skin whose bone indices do not
			// belong to this rig is left alone rather than remapped into nonsense.
			copy.Skin = FlipSkin( copy.Skin, ctx.Rig );

			if ( Merge.Value )
				MeshWeldMerge.WeldInto( source.Mesh, copy );
			else
				ctx.Bodies.Add( new Body( ctx.NewBodyId(), $"{Name}", copy ) );
		}

		// A merged mirror lives IN the source body, so removing the source would delete
		// the result — the old code did exactly that for Merge + Keep original off.
		if ( !KeepOriginal.Value && !Merge.Value )
		{
			foreach ( var source in sources )
				ctx.Bodies.Remove( source );
		}
	}

	/// <summary>
	/// Mirror a skin's bone indices to their mirror partners: every weight on arm_L
	/// becomes a weight on arm_R, and back, by <see cref="Skeleton.MirrorPartners"/>.
	/// Centre bones map to themselves, so a spine weight survives unchanged. Null
	/// skin, an empty rig, or a skin naming bones outside the rig returns the skin
	/// untouched — flipping against the wrong rig would be worse than not flipping.
	/// Public so tests can prove the flip without building a whole studio around it.
	/// </summary>
	public static SkinWeights FlipSkin( SkinWeights skin, Skeleton rig )
	{
		if ( skin is null || rig is null || rig.Count == 0 )
			return skin;

		var partners = rig.MirrorPartners( out _ );

		foreach ( var weights in skin.Vertices )
			foreach ( var w in weights )
				if ( w.Bone < 0 || w.Bone >= partners.Length )
					return skin;

		var flipped = new SkinWeights();

		foreach ( var weights in skin.Vertices )
			flipped.Vertices.Add( weights.Select( w => new BoneWeight( partners[w.Bone], w.Weight ) ).ToArray() );

		return flipped;
	}
}

/// <summary>
/// Catmull-Clark subdivision as a history feature.
///
/// Onshape has no equivalent, and this is the deliberate place where the tool stops being CAD.
/// Putting subdivision IN the tree rather than after it is what keeps the pipeline honest: roll
/// the bar back above this feature and you are editing the low-poly cage, roll it forward and you
/// see the dense surface. The cage is what the sculpt eventually bakes down onto, so it has to
/// stay reachable rather than being consumed by an export step.
/// </summary>
public sealed class SubdivideFeature : Feature
{
	public override string TypeName => "Subdivide";

	/// <summary>Faces as well as bodies: an empty Bodies list means the whole document to Execute,
	/// so picking is how you say which part - see the refusal in the editor's AddFeature.</summary>
	public override GeometryKind Accepts => GeometryKind.Face | GeometryKind.Body;

	/// <summary>
	/// Which faces to subdivide. EMPTY MEANS WHOLE BODY OR ALL FACES, depending on <see cref="AllFaces"/>,
	/// and the whole-body form is the old behaviour and the honest default — a subdivision surface
	/// is a property of a cage, not of a corner of one.
	///
	/// Picking faces switches the operation from smooth to linear, and the two really are different
	/// operations rather than a flag on one. See CatmullClark.SubdivideFaces: you cannot apply the
	/// limit rules to part of a mesh without moving the vertices the rest of it is standing on. So
	/// this is density where you need it — a face about to be sculpted, a panel about to be bent —
	/// and the whole-body form remains the one that smooths.
	///
	/// Held as FaceRefs, like every other face pick, so the choice survives the rebuild that
	/// recreates the faces it names.
	/// </summary>
	public List<FaceRef> Faces = new();

	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly IntParam Levels = new( "Levels", 1, 0, 6 );

	/// <summary>
	/// Subdivide EVERY face, not the whole body. Only read when <see cref="Faces"/> is empty — a
	/// picked face already names its region, and a pick is more specific than "everything".
	///
	/// The whole-body form (this off, no picks) runs the full Catmull-Clark and SMOOTHS: it moves
	/// the original vertices onto the limit surface. This is the density version of the same idea —
	/// midpoints and centroids, so the shape stays exactly where it is and every face just gets
	/// more polygons. You want it when the whole cage is too coarse but the silhouette is already
	/// right, and it is why it is a tick rather than "pick 40 faces".
	/// </summary>
	public readonly BoolParam AllFaces = new( "All faces", false );

	/// <summary>
	/// The clearer name for the linear path <see cref="AllFaces"/> selects: split every face
	/// without moving any vertex, so the size is preserved exactly. Either flag selects it;
	/// neither is a second, different operation. The default (both off) is unchanged: the full
	/// Catmull-Clark that smooths and shrinks the cage toward its limit surface.
	/// </summary>
	public readonly BoolParam Preserve = new( "Preserve size", false );

	/// <summary>
	/// Volume-preserving smooth subdivision (organic P3): after the Catmull-Clark
	/// step, rescale the mesh about its centroid to restore its pre-subdivision
	/// volume exactly (for a closed mesh). The smoothed shape is kept; only the
	/// shrink is undone. Off by default so existing smooth-subdivision behaviour
	/// is unchanged; Preserve size already preserves shape exactly by splitting
	/// without moving vertices.
	/// </summary>
	public readonly BoolParam Volume = new( "Preserve volume", false );

	/// <summary>
	/// Creases on the smooth path (wave 3, research P1). DeRose semi-sharp creases
	/// that the Catmull-Clark engine already implemented but Subdivide never
	/// exposed: an edge stays a hard fold for N levels, then rounds.
	///
	/// Three ways to name them, all optional and all off by default, so a
	/// feature with none of them set rebuilds byte-identically to before:
	/// <list type="bullet">
	/// <item><see cref="AutoCreaseAngle"/>: tag every edge whose dihedral angle
	/// exceeds it (default suggestion 30, matching EditOp's sharp:30) at
	/// <see cref="CreaseSharpness"/>. This is what makes the feature usable at
	/// scale — a box cage becomes a correctly smoothed box without hand-picking
	/// its 12 edges.</item>
	/// <item><see cref="CreaseEdges"/>: explicit cage edges, "a-b[:sharpness];…"
	/// with a, b cage vertex indices. Explicit edges override auto-creases
	/// where they disagree.</item>
	/// <item><see cref="CornerVertices"/> and <see cref="BoundaryMode"/> (P5):
	/// vertices pinned through every level, and how open borders behave.</item>
	/// </list>
	/// Creases are a property of the smooth rule only. On the linear paths
	/// (face picks, All faces, Preserve size) they are ignored with a warning,
	/// never silently applied to nothing. Crease sets are stored in these
	/// parameters, so they survive save → reload → rebuild like any other
	/// parameter; what does NOT survive is a raw edge index after upstream
	/// geometry changes — unresolvable edges are counted and warned about,
	/// the same resolve-and-warn story face picks already have.
	/// </summary>
	public readonly FloatParam AutoCreaseAngle = new( "Auto crease angle", 0f, 0f, 180f, "°" );
	public readonly FloatParam CreaseSharpness = new( "Crease sharpness", 2f, 0f, 6f );
	public readonly StringParam CreaseEdges = new( "Crease edges", "" );
	public readonly BoolParam FitLimit = new( "Fit limit", false );
	public readonly BoolParam PinCreaseEnds = new( "Pin crease ends", true );
	public readonly StringParam CornerVertices = new( "Corner vertices", "" );
	public readonly ChoiceParam BoundaryMode = new( "Boundary mode", new[] { "Curve", "Pin border", "Pin corners" }, 0 );
	public readonly IntParam Polish = new( "Polish", 0, 0, 10 );

	public override IReadOnlyList<IParam> Parameters => new IParam[] { Bodies, Levels, AllFaces, Preserve, Volume, AutoCreaseAngle, CreaseSharpness, CreaseEdges, FitLimit, PinCreaseEnds, CornerVertices, BoundaryMode, Polish };

	/// <summary>What this feature will cost at the current settings, for a UI that warns before
	/// rather than after. Levels are exponential and the jump from 4 to 6 is 16x.</summary>
	public (int Vertices, int Faces) PredictCost( IEnumerable<Body> bodies )
	{
		var v = 0;
		var f = 0;
		var list = bodies as IList<Body> ?? bodies.ToList();

		if ( Faces.Count > 0 )
		{
			// Local subdivision only touches the bodies that were picked on, so the bodies it did
			// not touch still cost exactly what they already are.
			var picked = Resolve( list, out _ );

			foreach ( var body in list )
			{
				var (bv, bf) = picked.TryGetValue( body, out var indices )
					? CatmullClark.PredictLocalCost( body.Mesh, indices, Levels.Clamped )
					: (body.Mesh.VertexCount, body.Mesh.FaceCount);

				v += bv;
				f += bf;
			}

			return (v, f);
		}

		foreach ( var body in list.Where( Bodies.Matches ) )
		{
			var (bv, bf) = (AllFaces.Value || Preserve.Value)
				? CatmullClark.PredictLocalCost( body.Mesh, AllIndices( body.Mesh ), Levels.Clamped )
				: CatmullClark.PredictCost( body.Mesh, Levels.Clamped );

			v += bv;
			f += bf;
		}

		return (v, f);
	}

	/// <summary>Picked faces grouped by the body they landed on. <paramref name="lost"/> counts the
	/// references that no longer resolve — geometry upstream changed under them.</summary>
	Dictionary<Body, List<int>> Resolve( IEnumerable<Body> bodies, out int lost )
	{
		var byBody = new Dictionary<Body, List<int>>();
		lost = 0;

		foreach ( var reference in Faces )
		{
			if ( !FacePlane.TryResolveFace( bodies, reference, out var body, out var faceIndex ) )
			{
				lost++;
				continue;
			}

			if ( !byBody.TryGetValue( body, out var indices ) )
				byBody[body] = indices = new List<int>();

			indices.Add( faceIndex );
		}

		return byBody;
	}

	protected override void Execute( FeatureContext ctx )
	{
		if ( Levels.Clamped == 0 )
		{
			// Allowed — it is how you switch the smoothing off without deleting the feature — but
			// said, so a Subdivide that does nothing does not read as a broken one.
			Warn( "Levels is 0, so nothing is subdivided",
				"Each level splits every face into four and smooths; zero levels leaves the part as it is.",
				"Set Levels to 1 or more to smooth the part" );
			return;
		}

		if ( Faces.Count > 0 )
		{
			// A picked face already names its body, so the Bodies filter has nothing left to decide and
			// is not consulted here. Two picks on the same body are subdivided in ONE call rather than
			// one call each: the second call would be running against a mesh whose face indices the
			// first has already renumbered.
			if ( SmoothOptionsSet() )
				Warn( "Creases, fit limit, polish, corners and boundary mode do not apply to picked faces",
					"The picked-face path is linear densify, not the smooth rule, so those options are ignored here.",
					"Clear the picks to subdivide the whole body if the smooth options are wanted" );

			var picked = Resolve( ctx.Bodies, out var lost );

			if ( picked.Count == 0 )
			{
				Fail(
					"None of the picked faces are still there",
					"Every face this feature subdivides was removed or replaced by a change further up the tree.",
					"Pick the faces again",
					"Or clear the picks to subdivide the whole body" );
			}

			foreach ( var (body, indices) in picked )
				body.Mesh = CatmullClark.SubdivideFaces( body.Mesh, indices, Levels.Clamped );

			if ( lost > 0 )
			{
				Warn(
					$"{lost} picked {(lost == 1 ? "face is" : "faces are")} no longer there",
					"A change further up the tree removed or replaced them, so they were skipped.",
					"Pick them again if the extra density is still wanted" );
			}

			return;
		}

		// No picks. AllFaces chooses between densifying every face (linear, shape unchanged) and
		// the whole-body Catmull-Clark that smooths.
		if ( (AllFaces.Value || Preserve.Value) && SmoothOptionsSet() )
			Warn( "Creases, fit limit, polish, corners and boundary mode do not apply to the linear path",
				"All faces / Preserve size split every face without moving any vertex, so the smooth rule — and everything attached to it — is ignored here.",
				"Turn All faces and Preserve size off to subdivide the whole body smoothly" );

		if ( !AllFaces.Value && !Preserve.Value && FitLimit.Value
			&& (AutoCreaseAngle.Value > 0f || !string.IsNullOrWhiteSpace( CreaseEdges.Value )) )
			Warn( "Fit limit ignores creases",
				"The limit-surface fit is computed for the smooth rule; a creased cage's limit is not modelled, so a fitted cage can fight its creases slightly.",
				"Use fit limit for smooth block-outs, and creases for hard edges, rather than both at full strength" );

		foreach ( var body in RequireBodies( ctx, Bodies ) )
		{
			if ( AllFaces.Value || Preserve.Value )
				body.Mesh = CatmullClark.SubdivideFaces( body.Mesh, AllIndices( body.Mesh ), Levels.Clamped );
			else
			{
				var before = Volume.Value ? PressureBalloon.Volume( body.Mesh ) : 0f;
				body.Mesh = SmoothSubdivide( body.Mesh );
				if ( Volume.Value && before > 1e-9f )
				{
					var after = PressureBalloon.Volume( body.Mesh );
					if ( after > 1e-9f && float.IsFinite( after ) )
					{
						var s = MathF.Pow( before / after, 1f / 3f );
						var c = body.Mesh.Positions.Aggregate( Vec3.Zero, ( a, b ) => a + b ) / Math.Max( 1, body.Mesh.VertexCount );
						for ( var v = 0; v < body.Mesh.VertexCount; v++ ) body.Mesh.Positions[v] = c + (body.Mesh.Positions[v] - c) * s;
					}
				}
			}
		}
	}

	/// <summary>Whether any smooth-rule option is set. Only used to warn on the
	/// linear paths, where those options are ignored; a feature with none of
	/// them set takes the old path untouched.</summary>
	bool SmoothOptionsSet() =>
		AutoCreaseAngle.Value > 0f
		|| !string.IsNullOrWhiteSpace( CreaseEdges.Value )
		|| FitLimit.Value
		|| !string.IsNullOrWhiteSpace( CornerVertices.Value )
		|| BoundaryMode.Index != 0
		|| Polish.Value > 0;

	/// <summary>Resolve the crease set for one cage. Auto-creases come first;
	/// explicit edges override them. <paramref name="lost"/> counts explicit
	/// edges that are not in this cage — auto-creases can never be lost, they
	/// are computed from the cage in front of us.</summary>
	Dictionary<EdgeKey, float> ResolveCreases( PolyMesh mesh, out int lost )
	{
		lost = 0;
		var result = new Dictionary<EdgeKey, float>();
		var edgeFaces = mesh.BuildEdgeFaces();
		var sharp = CreaseSharpness.Clamped;

		if ( AutoCreaseAngle.Value > 0f )
		{
			var cos = MathF.Cos( AutoCreaseAngle.Value * MathF.PI / 180f );
			var normals = new Vec3[mesh.FaceCount];

			for ( var f = 0; f < mesh.FaceCount; f++ )
				normals[f] = mesh.FaceNormal( mesh.Faces[f] );

			foreach ( var (key, faces) in edgeFaces )
			{
				if ( faces.Count != 2 )
					continue;

				if ( Vec3.Dot( normals[faces[0]], normals[faces[1]] ) < cos )
					result[key] = sharp;
			}
		}

		if ( !string.IsNullOrWhiteSpace( CreaseEdges.Value ) )
		{
			foreach ( var raw in CreaseEdges.Value.Split( ';' ) )
			{
				var token = raw.Trim();

				if ( token.Length == 0 )
					continue;

				var parts = token.Split( ':' );
				var ends = parts[0].Split( '-' );

				if ( ends.Length != 2
					|| !int.TryParse( ends[0].Trim(), out var a )
					|| !int.TryParse( ends[1].Trim(), out var b ) )
				{
					lost++;
					continue;
				}

				var s = sharp;

				if ( parts.Length > 1 && !TryFloat( parts[1].Trim(), out s ) )
				{
					lost++;
					continue;
				}

				var key = new EdgeKey( a, b );

				if ( a < 0 || b < 0 || a >= mesh.VertexCount || b >= mesh.VertexCount || !edgeFaces.ContainsKey( key ) )
				{
					lost++;
					continue;
				}

				result[key] = Math.Clamp( s, 0f, 6f );
			}
		}

		return result;
	}

	/// <summary>Vertices pinned through every level, by original cage index.
	/// Original vertices keep their indices at every level (SubdivideOnce's
	/// layout is originals first, in order), so one set serves all levels.
	/// Sources: named corner vertices, the boundary mode, and — when on —
	/// the endpoints of crease chains, which otherwise round off at their ends
	/// because a vertex with a single crease gets no crease treatment.</summary>
	HashSet<int> ResolvePinned( PolyMesh mesh, Dictionary<EdgeKey, float> creases, out int lost )
	{
		lost = 0;
		var pinned = new HashSet<int>();

		if ( !string.IsNullOrWhiteSpace( CornerVertices.Value ) )
		{
			foreach ( var raw in CornerVertices.Value.Split( new[] { ',', ';' } ) )
			{
				var token = raw.Trim();

				if ( token.Length == 0 )
					continue;

				if ( !int.TryParse( token, out var v ) || v < 0 || v >= mesh.VertexCount )
				{
					lost++;
					continue;
				}

				pinned.Add( v );
			}
		}

		if ( BoundaryMode.Index != 0 )
		{
			var boundaryCount = new Dictionary<int, int>();

			foreach ( var (key, faces) in mesh.BuildEdgeFaces() )
			{
				if ( faces.Count != 1 )
					continue;

				boundaryCount[key.A] = boundaryCount.TryGetValue( key.A, out var ca ) ? ca + 1 : 1;
				boundaryCount[key.B] = boundaryCount.TryGetValue( key.B, out var cb ) ? cb + 1 : 1;
			}

			foreach ( var (v, count) in boundaryCount )
			{
				if ( BoundaryMode.Index == 1 || count != 2 )
					pinned.Add( v );
			}
		}

		if ( PinCreaseEnds.Value )
		{
			var incident = new Dictionary<int, int>();

			foreach ( var key in creases.Keys )
			{
				incident[key.A] = incident.TryGetValue( key.A, out var ca ) ? ca + 1 : 1;
				incident[key.B] = incident.TryGetValue( key.B, out var cb ) ? cb + 1 : 1;
			}

			foreach ( var (v, count) in incident )
			{
				if ( count == 1 )
					pinned.Add( v );
			}
		}

		return pinned;
	}

	static bool TryFloat( string text, out float value ) =>
		float.TryParse( text, System.Globalization.NumberStyles.Float,
			System.Globalization.CultureInfo.InvariantCulture, out value );

	/// <summary>The smooth path, level by level, so pinned vertices can be
	/// restored after each level and crease vertices tracked for polish.
	/// With no creases, no pins, no fit and no polish this runs the same
	/// SubdivideOnce steps the old one-call path ran, in the same order.</summary>
	PolyMesh SmoothSubdivide( PolyMesh cage )
	{
		var mesh = cage.Clone();
		var creases = ResolveCreases( mesh, out var lostCreases );

		if ( lostCreases > 0 )
			Warn( $"{lostCreases} crease edge(s) could not be resolved",
				"A cage edge named by Crease edges is not in this body.",
				"Check the cage vertex indices, or re-pick the edges" );

		var pinned = ResolvePinned( mesh, creases, out var lostCorners );

		if ( lostCorners > 0 )
			Warn( $"{lostCorners} corner vertex/vertices could not be resolved",
				"A vertex named by Corner vertices is not in this body.",
				"Check the cage vertex indices" );

		if ( FitLimit.Value )
		{
			var miss = SubdivisionLimit.FitToLimit( mesh );
			var (min, max) = ModelMeasure.Bounds( mesh );
			var size = (max - min).Length;

			if ( miss > 0.01f * Math.Max( size, 1e-6f ) )
				Warn( $"Fit limit left a miss of {miss:0.###} units",
					"The cage is fighting the limit surface — it is too coarse for the shape it claims.",
					"Add cage density near the worst vertex, or accept the miss" );
		}

		// Vertices polish must never move: crease vertices (originals and the
		// edge points that land on crease edges, tracked level by level) plus
		// every pinned vertex. Without creases this set is empty and polish is
		// plain Taubin.
		var creaseVerts = new HashSet<int>( pinned );

		foreach ( var key in creases.Keys )
		{
			creaseVerts.Add( key.A );
			creaseVerts.Add( key.B );
		}

		var live = creases;

		for ( var level = 0; level < Levels.Clamped; level++ )
		{
			var before = mesh.Positions.ToArray();
			var edgeFaces = mesh.BuildEdgeFaces();
			var sorted = new List<EdgeKey>( edgeFaces.Keys );
			sorted.Sort( ( a, b ) => a.A != b.A ? a.A.CompareTo( b.A ) : a.B.CompareTo( b.B ) );
			var edgeIndex = new Dictionary<EdgeKey, int>();

			for ( var i = 0; i < sorted.Count; i++ )
				edgeIndex[sorted[i]] = i;

			var vertCount = mesh.VertexCount;
			mesh = CatmullClark.Subdivide( mesh, 1, live, out var remaining );

			foreach ( var p in pinned )
			{
				if ( p < before.Length && p < mesh.VertexCount )
					mesh.Positions[p] = before[p];
			}

			var next = new HashSet<int>();

			foreach ( var v in creaseVerts )
			{
				if ( v < vertCount )
					next.Add( v );
			}

			foreach ( var key in live.Keys )
			{
				if ( edgeIndex.TryGetValue( key, out var ei ) )
					next.Add( vertCount + ei );
			}

			foreach ( var p in pinned )
				next.Add( p );

			creaseVerts = next;
			live = remaining;
		}

		for ( var p = 0; p < Polish.Clamped; p++ )
		{
			var saved = new Dictionary<int, Vec3>();

			foreach ( var v in creaseVerts )
			{
				if ( v < mesh.VertexCount )
					saved[v] = mesh.Positions[v];
			}

			MeshSmooth.Taubin( mesh, 1 );

			foreach ( var (v, pos) in saved )
				mesh.Positions[v] = pos;
		}

		return mesh;
	}

	/// <summary>Every face index of a mesh, as a list — the "all faces" version of a pick list.</summary>
	static int[] AllIndices( PolyMesh mesh )
	{
		var all = new int[mesh.FaceCount];

		for ( var i = 0; i < all.Length; i++ )
			all[i] = i;

		return all;
	}
}

/// <summary>
/// Merge one mesh into another and weld the seam (Backlog B15, A6.2).
///
/// Plain <see cref="MeshTransform.Append"/> leaves the two halves topologically separate:
/// a mirrored half-model keeps its own copy of every centreline vertex, the mirror-plane
/// faces survive as interior duplicates, and a pattern's closing seam stays split. This
/// appends, then welds within 1e-3, then drops the interior faces the weld makes
/// coincident — a face pair with the same vertices in opposite windings is the wall
/// between two halves of one solid, not a boundary, so both go.
///
/// What survives the weld, and what does not: positions, skin weights, vertex colours
/// and paint ride <see cref="MeshWeld.Weld"/>; morphs and UV2 are remapped here because
/// that weld drops them, and that drop is exactly the old "mirror drops morphs" bug.
/// Per-corner UV2 mappings (FaceUV2) do not survive — their indices name the old UV2
/// list — so the vertex UV2 list is kept and the corner mapping is dropped.
/// Bone bindings are carried by index, not by name: a PolyMesh has no skeleton, so the
/// _L/_R bone-name flip cannot happen inside this merge itself. MirrorFeature does it
/// before the weld (FlipSkin against the studio rig), so a merged mirror arrives here
/// already flipped; any other caller of WeldInto still gets weights carried faithfully
/// by index, which is the part this merge owns.
/// </summary>
internal static class MeshWeldMerge
{
	public static void WeldInto( PolyMesh target, PolyMesh source )
	{
		var targetVerts = target.Positions.Count;
		var targetUv2 = target.HasUV2 ? new List<Vec2>( target.UV2 ) : null;
		var sourceUv2 = source.HasUV2 ? new List<Vec2>( source.UV2 ) : null;

		MeshTransform.Append( target, source );

		// Seams AFTER Append: Append already shifted the source's seams by the offset,
		// so this snapshot is in post-append indices, the indices the weld map speaks.
		var targetSeams = target.Seams is { Count: > 0 } ? new HashSet<EdgeKey>( target.Seams ) : null;

		// Morphs as Append merged them (by name, padded with no offset on the side that
		// lacks the key) — snapshot before the weld, which would drop them.
		var morphs = target.Morphs.Select( m => (m.Name, Deltas: (Vec3[])m.Deltas?.Clone(), m.Driver) ).ToList();

		var welded = MeshWeld.Weld( target, 1e-3f );

		// Rebuild the old->welded index map from positions: the weld keeps each
		// component's lowest-index vertex position exactly, so a spatial lookup on the
		// welded positions recovers the map without the weld having to return one.
		var map = WeldMap( target.Positions, welded.Positions, 1e-3f );

		var faces = DropInteriorDuplicates( welded.Faces );

		var used = new bool[welded.VertexCount];
		foreach ( var f in faces )
			foreach ( var i in f.Indices )
				used[i] = true;

		// Compact again after the interior faces go: vertices only those faces used are
		// kept, in order, and every parallel array follows the same compaction.
		var compact = new int[welded.VertexCount];
		Array.Fill( compact, -1 );
		var survivors = new List<int>();

		for ( var v = 0; v < welded.VertexCount; v++ )
		{
			if ( used[v] )
			{
				compact[v] = survivors.Count;
				survivors.Add( v );
			}
		}

		var finalMap = new int[target.VertexCount];
		for ( var v = 0; v < finalMap.Length; v++ )
			finalMap[v] = map[v] >= 0 && compact[map[v]] >= 0 ? compact[map[v]] : -1;

		target.Positions = survivors.Select( v => welded.Positions[v] ).ToList();
		target.Faces = faces.Select( f => new Face(
			f.Indices.Select( i => compact[i] ).ToArray(),
			(Vec2[])f.UVs.Clone(), f.Material ) ).ToList();
		target.Skin = welded.Skin is null ? null : new SkinWeights
		{
			Vertices = survivors.Select( v => (BoneWeight[])welded.Skin[v].Clone() ).ToList()
		};
		target.VertexColors = welded.VertexColors is null ? null
			: survivors.Select( v => welded.VertexColors[v] ).ToArray();
		target.Paint = welded.Paint;

		// Morphs: first old vertex to claim a welded slot wins, which is the component's
		// lowest index — the same survivor the weld kept for positions and weights.
		var mergedMorphs = new List<MeshMorph>();

		foreach ( var (name, deltas, driver) in morphs )
		{
			if ( deltas is null )
				continue;

			var merged = new Vec3[survivors.Count];
			var claimed = new bool[survivors.Count];

			for ( var v = 0; v < deltas.Length && v < finalMap.Length; v++ )
			{
				var to = finalMap[v];

				if ( to >= 0 && !claimed[to] )
				{
					merged[to] = deltas[v];
					claimed[to] = true;
				}
			}

			mergedMorphs.Add( new MeshMorph { Name = name, Deltas = merged, Driver = driver?.Clone() } );
		}

		target.Morphs = mergedMorphs;

		// UV2, vertex-mapped: target's list padded with the source's, then first-wins
		// through the same map. The split is by VERTEX count, not by UV2 list length —
		// a UV2 list may be shorter than its mesh. FaceUV2 (per-corner) cannot follow
		// the remap, so it is dropped and the vertex list stands.
		if ( targetUv2 is not null || sourceUv2 is not null )
		{
			var preCount = map.Length;
			var pre = new List<Vec2>( preCount );

			for ( var v = 0; v < preCount; v++ )
			{
				if ( v < targetVerts && targetUv2 is not null && v < targetUv2.Count )
					pre.Add( targetUv2[v] );
				else if ( v >= targetVerts && sourceUv2 is not null && v - targetVerts < sourceUv2.Count )
					pre.Add( sourceUv2[v - targetVerts] );
				else
					pre.Add( Vec2.Zero );
			}

			var uv2 = new Vec2[survivors.Count];
			var claimedUv = new bool[survivors.Count];

			for ( var v = 0; v < pre.Count && v < finalMap.Length; v++ )
			{
				var to = finalMap[v];

				if ( to >= 0 && !claimedUv[to] )
				{
					uv2[to] = pre[v];
					claimedUv[to] = true;
				}
			}

			target.UV2 = uv2.ToList();
			target.FaceUV2 = null;
		}

		if ( targetSeams is not null )
		{
			var seams = new HashSet<EdgeKey>();

			foreach ( var e in targetSeams )
			{
				var a = e.A < finalMap.Length ? finalMap[e.A] : -1;
				var b = e.B < finalMap.Length ? finalMap[e.B] : -1;

				if ( a >= 0 && b >= 0 && a != b )
					seams.Add( new EdgeKey( a, b ) );
			}

			target.Seams = seams;
		}
	}

	static int[] WeldMap( IReadOnlyList<Vec3> oldPositions, IReadOnlyList<Vec3> weldedPositions, float tol )
	{
		var cells = new Dictionary<(long, long, long), List<int>>();
		var scale = 1f / tol;

		for ( var v = 0; v < weldedPositions.Count; v++ )
		{
			var p = weldedPositions[v];
			var key = ((long)MathF.Floor( p.x * scale ), (long)MathF.Floor( p.y * scale ), (long)MathF.Floor( p.z * scale ));

			if ( !cells.TryGetValue( key, out var list ) )
				cells[key] = list = new List<int>();

			list.Add( v );
		}

		var map = new int[oldPositions.Count];
		var tol2 = tol * tol;

		for ( var v = 0; v < oldPositions.Count; v++ )
		{
			var p = oldPositions[v];
			var cell = ((long)MathF.Floor( p.x * scale ), (long)MathF.Floor( p.y * scale ), (long)MathF.Floor( p.z * scale ));
			map[v] = -1;

			for ( var dx = -1; dx <= 1 && map[v] < 0; dx++ )
			for ( var dy = -1; dy <= 1 && map[v] < 0; dy++ )
			for ( var dz = -1; dz <= 1 && map[v] < 0; dz++ )
			{
				if ( !cells.TryGetValue( (cell.Item1 + dx, cell.Item2 + dy, cell.Item3 + dz), out var list ) )
					continue;

				foreach ( var u in list )
				{
					if ( (weldedPositions[u] - p).LengthSquared <= tol2 )
					{
						map[v] = u;
						break;
					}
				}
			}
		}

		return map;
	}

	/// <summary>
	/// Drop faces the weld made coincident: within a group sharing one vertex set, a
	/// pair in opposite windings is an interior wall and the whole group goes; a group
	/// of same-winding copies keeps one face.
	/// </summary>
	static List<Face> DropInteriorDuplicates( IReadOnlyList<Face> faces )
	{
		var groups = new Dictionary<string, List<Face>>();

		foreach ( var f in faces )
		{
			var key = string.Join( ",", f.Indices.OrderBy( i => i ) );
			if ( !groups.TryGetValue( key, out var list ) )
				groups[key] = list = new List<Face>();

			list.Add( f );
		}

		var result = new List<Face>();

		foreach ( var group in groups.Values )
		{
			if ( group.Count == 1 )
			{
				result.Add( group[0] );
				continue;
			}

			var hasOpposite = false;

			for ( var i = 0; i < group.Count && !hasOpposite; i++ )
			for ( var j = i + 1; j < group.Count && !hasOpposite; j++ )
				if ( IsReverseOf( group[i].Indices, group[j].Indices ) )
					hasOpposite = true;

			if ( !hasOpposite )
				result.Add( group[0] );
		}

		return result;
	}

	static bool IsReverseOf( int[] a, int[] b )
	{
		if ( a.Length != b.Length )
			return false;

		var start = Array.IndexOf( b, a[0] );

		if ( start < 0 )
			return false;

		for ( var k = 0; k < a.Length; k++ )
			if ( b[(start - k + a.Length * 2) % a.Length] != a[k] )
				return false;

		return true;
	}
}
