using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;

namespace Effigy;

/// <summary>
/// Shapes fused into one skin: spheres, ellipsoids, capsules, cones, tubes, boxes, cylinders and tori smooth-unioned, with
/// cutters smooth-subtracted, meshed by <see cref="SurfaceNets"/> at a voxel size.
///
/// WHY THIS IS A FEATURE. The implicit kernel (<see cref="Sdf"/>, <see cref="SdfBlend"/>,
/// <see cref="SdfSubtract"/>) built every creature the test harness made, and none of it could be
/// reached from a build script, the CLI or the MCP: an agent modelling a heart or a gut pile had
/// to write C#. A feature is what the script's `add` already finds by reflection and what a saved
/// document already round-trips, so the whole kernel arrives through one class.
///
/// THE SHAPES ARE TEXT, one per `;`, because that is what a script line and a dialog field can both
/// hold. Points are x,y,z; a leading `-` makes a shape a cutter:
///
///   sphere 0,0,10 5
///   ellipsoid 0,0,10 6,4,8
///   capsule 0,0,0 0,0,12 3
///   cone 0,0,0 4 0,0,10 1.5          (round cone: end A, its radius, end B, its radius)
///   tube 0,0,0|4,0,6|0,0,12 2|1.5|1  (polyline through |-separated points; one radius or one per point)
///   box 0,0,5 8,4,2 r=0.3            (centre and full size; r= rounds the edges inside that size)
///   cylinder 0,0,0 0,0,3 2 r=0.2     (two ends and a radius; flat caps, r= rounds the rim)
///   torus 0,0,5 4 0.5                (centre, ring radius, tube radius; lies around Z)
///   -sphere 0,-5,10 2.5              (cut a hole)
///   paint box 0,0,6 2,2,1 mat=3      (no surface of its own: skin inside it takes slot 3)
///
/// Any shape may end with mat=N for the material slot of the skin it makes. Ellipsoid, box,
/// cylinder and torus take rot=x,y,z (degrees, XYZ order) about their centre.
///
/// A SHAPE WITH k= HAS ITS OWN BLEND AND COMES AFTER THE REST, in the order written. The shapes
/// without k= fuse at Blend and are cut at Cut blend first; then each k= shape joins (or, with a
/// leading '-', cuts) what is there so far with its own radius. A face wants a soft skull (k 1)
/// and a tight lip line (k 0.1), and an eyelid added after its socket was cut:
///
///   ellipsoid 0,0,1 4,3,4; -ellipsoid 3.8,1.2,0.1 0.5,0.8,0.5 k=0.2; ellipsoid 3.3,1.2,0.1 0.5,0.7,0.4 k=0.1
///
/// FILTERS: one filter over the fused field, before meshing, via the Filter parameter:
/// taper:Z:0.5 fattens the cross-section toward +Z, growth:0.3:0.5:7 grows fold ridges
/// out of the skin, repeat:X:3 tiles the field 3 times along X. See SdfFilter.
///
/// PAINT EXISTS FOR WHAT HAS NO SHAPE. A face takes the slot of the shape nearest its corner, so a
/// window, label or inlay flush with the shell (nothing proud of it) can never get a slot of its own
/// without changing the skin. A paint shape is not part of the field: after meshing, every face
/// whose centre lies inside it (within half a voxel) takes its slot, and a later paint wins over an
/// earlier one.
///
/// THE RESULT HAS NO UVS. A voxel skin has no parameterisation to inherit; unwrap it (UV project,
/// Unwrap) before baking. Said in the warning rather than left for the bake to refuse.
/// </summary>
public sealed class BlobFeature : Feature
{
	public override string TypeName => "Blob";

	public readonly StringParam Shapes = new( "Shapes", "sphere 0,0,10 6" );
	public readonly FloatParam Blend = new( "Blend", 2f, 0f, unit: "u" );
	// Small on purpose. A smooth subtract eats up to a quarter of its blend from the wall it cuts,
	// so the old 0.5 u erased any shell thinner than about 0.25 u (6 mm): a hollow handle, a
	// button well, a battery bay. Hard-surface parts want crisp cuts; raise it for soft creature work.
	public readonly FloatParam CutBlend = new( "Cut blend", 0.05f, 0f, unit: "u" );
	public readonly FloatParam Voxel = new( "Voxel", 0.5f, 0.01f, unit: "u" );
	public readonly IntParam Smooth = new( "Smooth passes", 2, 0, 20 );
	public readonly FloatParam Noise = new( "Noise", 0f, 0f, unit: "u" );
	public readonly FloatParam NoiseSize = new( "Noise size", 6f, 0.01f, unit: "u" );
	public readonly IntParam Seed = new( "Seed", 1, 0, 100000 ) { Slider = false };
	public readonly IntParam Material = new( "Material slot", 0, 0, 63 ) { Slider = false };

	/// <summary>One SDF filter over the fused field, before meshing: taper:AXIS:amount,
	/// growth:amp:freq[:seed[:sharpness]], or repeat:AXIS:count. Empty means no filter.</summary>
	public readonly StringParam Filter = new( "Filter", "" );

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Shapes, Blend, CutBlend, Voxel, Smooth, Noise, NoiseSize, Seed, Material, Filter };

	public override IReadOnlyList<IParam> AdvancedParameters => new IParam[] { Smooth, Seed, Material };

	/// <summary>A sampling grid past this many voxels takes minutes and gigabytes; refuse it with
	/// the voxel size that would fit rather than hang the rebuild.</summary>
	const long MaxVoxels = 60_000_000;

	protected override void Execute( FeatureContext ctx )
	{
		var adds = new List<Sdf>();
		var cuts = new List<Sdf>();
		var paints = new List<Sdf>();
		var ordered = new List<(Sdf Leaf, bool Cut, float K)>();

		foreach ( var (text, index) in (Shapes.Value ?? "").Split( ';' ).Select( ( s, i ) => (s.Trim(), i) ) )
		{
			if ( text.Length == 0 )
				continue;

			if ( text.StartsWith( "paint ", StringComparison.OrdinalIgnoreCase ) )
			{
				if ( !text.Contains( "mat=", StringComparison.OrdinalIgnoreCase ) )
					BadShape( index + 1, text, "a paint shape needs mat=N, the slot it paints" );
				paints.Add( ParseShape( text[6..].Trim(), index + 1 ) );
				continue;
			}

			var cutter = text.StartsWith( '-' );
			var leaf = ParseShape( cutter ? text[1..].Trim() : text.TrimStart( '+' ).Trim(), index + 1, out var own );
			if ( own is float k )
				ordered.Add( (leaf, cutter, k) );
			else
				(cutter ? cuts : adds).Add( leaf );
		}

		// No plain shape to start from: the first k= shape that adds is the start.
		if ( adds.Count == 0 && ordered.FindIndex( o => !o.Cut ) is var first and >= 0 )
		{
			adds.Add( ordered[first].Leaf );
			ordered.RemoveAt( first );
		}

		if ( adds.Count == 0 )
		{
			FailOn( "Shapes",
				"There is nothing to fuse",
				"Blob needs at least one shape that is not a cutter.",
				"Add a shape: sphere 0,0,10 6",
				"Or remove the leading '-' from one of the cutters" );
		}

		Sdf field = adds.Count == 1 ? adds[0] : new SdfBlend( Blend.Clamped, adds.ToArray() );

		if ( cuts.Count > 0 )
			field = new SdfSubtract( field, CutBlend.Clamped, cuts.ToArray() );

		foreach ( var (leaf, cut, k) in ordered )
			field = cut ? new SdfSubtract( field, k, leaf ) : new SdfBlend( k, field, leaf );

		if ( Noise.Value > 0f )
			field = new SdfDisplace( field, Noise.Clamped, 1f / NoiseSize.Clamped, 3, Seed.Clamped );

		if ( !string.IsNullOrWhiteSpace( Filter.Value ) )
		{
			try { field = SdfFilter.Parse( field, Filter.Value.Trim() ); }
			catch ( ArgumentException ex )
			{
				FailOn( "Filter", ex.Message, "The filter line is not one I know.",
					"Use taper:AXIS:amount, growth:amp:freq[:seed[:sharpness]], or repeat:AXIS:count" );
			}
		}

		var voxel = Voxel.Clamped;
		var size = field.Max - field.Min + Vec3.One * voxel * 4f;
		var voxels = (long)(size.x / voxel + 1) * (long)(size.y / voxel + 1) * (long)(size.z / voxel + 1);

		if ( voxels > MaxVoxels )
		{
			var fits = MathF.Cbrt( size.x * size.y * size.z / MaxVoxels );
			FailOn( "Voxel", MathF.Ceiling( fits * 100f ) / 100f,
				"The voxel is too small for the size of the blob",
				$"Meshing would sample {voxels:N0} voxels; the limit is {MaxVoxels:N0}.",
				$"Set Voxel to {fits:0.##} or more" );
		}

		var result = SurfaceNets.Mesh( field, voxel );
		var mesh = result.Mesh;

		if ( mesh.FaceCount == 0 && cuts.Count > 0 && CutBlend.Clamped > 0f )
		{
			// Before blaming the shapes, see whether the blend did it: the same cutters with a
			// sharp cut. Only paid when the build has already failed.
			var sharp = new SdfSubtract( adds.Count == 1 ? adds[0] : new SdfBlend( Blend.Clamped, adds.ToArray() ), 0f, cuts.ToArray() );
			if ( SurfaceNets.Mesh( sharp, voxel ).Mesh.FaceCount > 0 )
			{
				var suggested = MathF.Min( CutBlend.Clamped * 0.1f, 0.01f );
				FailOn( "Cut blend", suggested,
					"The cut blend erased the walls",
					$"Cut blend {CutBlend.Clamped:0.###} u rounds every cut, and that eats walls thinner than about {CutBlend.Clamped * 0.5f:0.###} u. With a sharp cut the blob has a surface.",
					$"Lower Cut blend (cutblend={suggested:0.###}), or 0 for a sharp cut",
					"Or make the walls between the shapes and the cutters thicker" );
			}
		}

		if ( mesh.FaceCount == 0 )
		{
			Fail(
				"The shapes made no surface",
				$"The cutters removed everything, or every shape is smaller than one voxel ({voxel:0.###} u).",
				"Make the shapes bigger than the voxel, or the voxel smaller",
				"Check the cutters do not cover the whole blob",
				"If the walls are thin, lower Cut blend" );
		}

		if ( Smooth.Clamped > 0 )
			MeshSmooth.Taubin( mesh, Smooth.Clamped );

		// Each face takes the slot of the shape nearest its first corner: a tooth leaf's skin stays
		// tooth even where the blend has run it into gum.
		foreach ( var face in mesh.Faces )
			face.Material = result.Nearest[face.Indices[0]]?.Material ?? Material.Clamped;

		var painted = Paint( mesh, paints, voxel * 0.5f );

		ctx.Bodies.Add( new Body( ctx.NewBodyId(), Name, mesh ) );

		var addCount = adds.Count + ordered.Count( o => !o.Cut );
		var cutCount = cuts.Count + ordered.Count( o => o.Cut );
		Warning = $"{mesh.FaceCount:N0} quads from {addCount} shape(s)" + (cutCount > 0 ? $" and {cutCount} cutter(s)" : "")
			+ (paints.Count > 0 ? $", {painted:N0} painted by {paints.Count} paint shape(s)" : "")
			+ ". It has no UVs yet: add a UV project (Unwrap) before baking.";
	}

	/// <summary>Give every face whose centre is inside a paint shape that shape's slot; later paints
	/// win. Returns how many faces were painted.</summary>
	public static int Paint( PolyMesh mesh, IReadOnlyList<Sdf> paints, float reach )
	{
		if ( paints.Count == 0 )
			return 0;

		var count = 0;

		foreach ( var face in mesh.Faces )
		{
			var c = Vec3.Zero;
			foreach ( var v in face.Indices )
				c += mesh.Positions[v];
			c /= face.Indices.Length;

			for ( var i = paints.Count - 1; i >= 0; i-- )
			{
				if ( !paints[i].InBounds( c, reach ) || paints[i].Eval( c ) > reach )
					continue;

				face.Material = paints[i].Material;
				count++;
				break;
			}
		}

		return count;
	}

	Sdf ParseShape( string text, int number ) => ParseShape( text, number, out _ );

	Sdf ParseShape( string text, int number, out float? ownBlend )
	{
		ownBlend = null;
		var words = text.Split( (char[])null, StringSplitOptions.RemoveEmptyEntries ).ToList();
		var material = Material.Clamped;
		var round = 0f;
		Xform? rotation = null;
		var rotated = false;

		for ( var i = words.Count - 1; i >= 0; i-- )
		{
			var w = words[i];
			if ( w.StartsWith( "mat=", StringComparison.OrdinalIgnoreCase ) )
				material = (int)Num( w[4..], number, text );
			else if ( w.StartsWith( "k=", StringComparison.OrdinalIgnoreCase ) )
				ownBlend = MathF.Max( 0f, Num( w[2..], number, text ) );
			else if ( w.StartsWith( "r=", StringComparison.OrdinalIgnoreCase ) )
				round = Num( w[2..], number, text );
			else if ( w.StartsWith( "rot=", StringComparison.OrdinalIgnoreCase ) )
			{
				var deg = Pt( w[4..], number, text );
				rotation = Xform.FromEulerXyz( deg * (MathF.PI / 180f) );
				rotated = true;
			}
			else
				continue;

			words.RemoveAt( i );
		}

		if ( words.Count == 0 )
			BadShape( number, text, "it is empty" );

		var kind = words[0].ToLowerInvariant();
		var a = words.Skip( 1 ).ToList();

		if ( rotated && kind is not ("ellipsoid" or "box" or "cylinder" or "torus") )
			BadShape( number, text, $"rot= turns an ellipsoid, box, cylinder or torus; a {kind} has nothing to turn" );
		if ( round != 0f && kind is not ("box" or "cylinder") )
			BadShape( number, text, $"r= rounds a box or a cylinder; a {kind} is already round" );

		SdfLeaf leaf = kind switch
		{
			"sphere" when a.Count == 2 => new SdfSphere( Pt( a[0], number, text ), Num( a[1], number, text ) ),
			"ellipsoid" when a.Count == 2 => new SdfEllipsoid( Pt( a[0], number, text ), Pt( a[1], number, text ), rotation ),
			"capsule" when a.Count == 3 => new SdfCapsule( Pt( a[0], number, text ), Pt( a[1], number, text ), Num( a[2], number, text ) ),
			"cone" when a.Count == 4 => new SdfRoundCone( Pt( a[0], number, text ), Num( a[1], number, text ), Pt( a[2], number, text ), Num( a[3], number, text ) ),
			"tube" when a.Count == 2 => Tube( a[0], a[1], number, text ),
			"box" when a.Count == 2 => new SdfBox( Pt( a[0], number, text ), Pt( a[1], number, text ), round, rotation ),
			"cylinder" when a.Count == 3 => Cylinder( Pt( a[0], number, text ), Pt( a[1], number, text ), Num( a[2], number, text ), round, rotation ),
			"torus" when a.Count == 3 => new SdfTorus( Pt( a[0], number, text ), Num( a[1], number, text ), Num( a[2], number, text ), rotation ),
			"cellular" when a.Count == 4 => new SdfCellular( Num( a[2], number, text ), Num( a[3], number, text ), Pt( a[0], number, text ), Pt( a[1], number, text ) ),
			"cellular" when a.Count == 5 => new SdfCellular( Num( a[2], number, text ), Num( a[3], number, text ), Pt( a[0], number, text ), Pt( a[1], number, text ), (int)Num( a[4], number, text ) ),
			"sphere" or "ellipsoid" or "capsule" or "cone" or "tube" or "box" or "cylinder" or "torus" or "cellular" => BadShape( number, text, $"{kind} takes {Usage( kind )}" ),
			_ => BadShape( number, text, $"'{kind}' is not a shape; use sphere, ellipsoid, capsule, cone, tube, box, cylinder, torus or cellular" ),
		};

		leaf.Material = material;
		leaf.Tag = $"shape{number}";
		return leaf;
	}

	/// <summary>A cylinder's rot= turns its two ends about their midpoint.</summary>
	static SdfLeaf Cylinder( Vec3 a, Vec3 b, float radius, float round, Xform? rotation )
	{
		if ( rotation is { } r )
		{
			var mid = (a + b) * 0.5f;
			a = mid + r.TransformDirection( a - mid );
			b = mid + r.TransformDirection( b - mid );
		}

		return new SdfCylinder( a, b, radius, round );
	}

	SdfLeaf Tube( string pointsText, string radiiText, int number, string text )
	{
		var points = pointsText.Split( '|', StringSplitOptions.RemoveEmptyEntries ).Select( p => Pt( p, number, text ) ).ToList();
		var radii = radiiText.Split( '|', StringSplitOptions.RemoveEmptyEntries ).Select( r => Num( r, number, text ) ).ToList();

		if ( points.Count < 2 )
			BadShape( number, text, "a tube needs two or more points, separated by |" );

		if ( radii.Count == 1 )
			radii = Enumerable.Repeat( radii[0], points.Count ).ToList();

		if ( radii.Count != points.Count )
			BadShape( number, text, $"a tube needs one radius, or one per point ({points.Count})" );

		return new SdfTube( points, radii );
	}

	static string Usage( string kind ) => kind switch
	{
		"sphere" => "a centre and a radius: sphere 0,0,10 5",
		"ellipsoid" => "a centre and three radii: ellipsoid 0,0,10 6,4,8",
		"capsule" => "two ends and a radius: capsule 0,0,0 0,0,12 3",
		"cone" => "an end, its radius, the other end, its radius: cone 0,0,0 4 0,0,10 1.5",
		"box" => "a centre and a full size: box 0,0,5 8,4,2 [r=0.3] [rot=0,0,45]",
		"cylinder" => "two ends and a radius: cylinder 0,0,0 0,0,3 2 [r=0.2] [rot=90,0,0]",
		"torus" => "a centre, a ring radius and a tube radius: torus 0,0,5 4 0.5 [rot=90,0,0]",
			"cellular" => "bounds min and max, a scale and a thickness, plus an optional seed: cellular 0,0,0 6,6,6 0.8 0.3 [7]",
		_ => "points and radii: tube 0,0,0|4,0,6|0,0,12 2|1.5|1",
	};

	static Vec3 Pt( string s, int number, string text )
	{
		if ( !ModelMeasure.TryParseVec3( s, out var p ) )
			BadShape( number, text, $"'{s}' is not a point x,y,z" );
		return p;
	}

	static float Num( string s, int number, string text )
	{
		if ( !float.TryParse( s, NumberStyles.Float, CultureInfo.InvariantCulture, out var v ) )
			BadShape( number, text, $"'{s}' is not a number" );
		return v;
	}

	static SdfLeaf BadShape( int number, string text, string why )
	{
		FailOn( "Shapes", $"Shape {number} cannot be read", $"'{text}': {why}.", "Fix that shape, or remove it" );
		return null;
	}
}

/// <summary>
/// One sculpt stroke, as data: a brush dragged along a path of points over a body, replayed on
/// every rebuild.
///
/// WHY A STROKE IS A FEATURE. The editor's sculpt keeps its result in a sidecar of per-level deltas
/// (<see cref="SculptFeature"/>), which is right for a hand on a mouse and useless to an agent: there
/// is no line it can write that puts a crease in. A stroke written as points is reproducible, can be
/// edited and re-run like any other parameter, and survives the body above it changing, because it
/// is re-projected onto whatever surface is there when it runs.
///
/// THE PATH IS PROJECTED, NOT TRUSTED. Each point is resampled along the path at Spacing × radius
/// and moved to the nearest point on the body, so a path sketched an inch off the skin still lands
/// on it. A path that lands nowhere is an error, not a stroke that quietly did nothing.
///
/// DENSITY IS THE CALLER'S. Brushes move vertices; a radius smaller than two edges has nothing to
/// move and the stroke says so. Put a Subdivide above it.
/// </summary>
public sealed class StrokeFeature : Feature
{
	public override string TypeName => "Stroke";

	public override GeometryKind Accepts => GeometryKind.Body;

	public readonly BodySelectionParam Bodies = new( "Bodies" );

	/// <summary>The path, in model space. Landmarks are allowed in a script.</summary>
	public List<Vec3> Points = new();

	public readonly ChoiceParam Brush = new( "Brush", Enum.GetNames( typeof( BrushKind ) ), (int)BrushKind.Draw );
	public readonly FloatParam Radius = new( "Radius", 1f, 0.001f, unit: "u" );
	public readonly FloatParam Strength = new( "Strength", 0.5f, 0f, 10f );
	public readonly BoolParam Invert = new( "Invert", false );
	public readonly ChoiceParam Falloff = new( "Falloff", Enum.GetNames( typeof( BrushFalloff ) ) );
	/// <summary>Mirror planes. The first four are the single planes older files stored by index; the
	/// rest are combinations. See <see cref="BrushSymmetry.Choices"/>.</summary>
	public readonly ChoiceParam Mirror = new( "Mirror", BrushSymmetry.ChoiceNames() );

	/// <summary>Radial symmetry: the stroke repeats this many times evenly round the radial axis
	/// through the origin. 1 is off.</summary>
	public readonly IntParam Radial = new( "Radial copies", 1, 1, 64 );
	public readonly ChoiceParam RadialAxis = new( "Radial axis", new[] { "X", "Y", "Z" }, 2 );
	public readonly FloatParam Spacing = new( "Spacing", 0.25f, 0.02f, 4f );
	public readonly ChoiceParam Mask = new( "Only", new[] { "Everywhere", "Creases", "Ridges" } );
	public readonly StringParam Alpha = new( "Alpha PNG", "" );
	public readonly FloatParam AlphaScale = new( "Alpha scale", 1f, 0.01f, 100f );
	/// <summary>Stamp rotation in the surface plane, in degrees. 0 is the old behaviour.</summary>
	public readonly FloatParam AlphaRotation = new( "Alpha rotation", 0f, -360f, 360f );
	/// <summary>Pattern repeats per stamp footprint. 1 is the old behaviour; above 1 the pattern tiles.</summary>
	public readonly FloatParam AlphaDensity = new( "Alpha density", 1f, 0.25f, 16f );
	/// <summary>Maximum extra rotation per dab, in degrees, seeded by Alpha seed. 0 (default) is off.</summary>
	public readonly FloatParam AlphaJitter = new( "Alpha jitter", 0f, 0f, 180f );
	/// <summary>Seed for per-dab alpha jitter. Same seed and path rebuild identically.</summary>
	public readonly IntParam AlphaSeed = new( "Alpha seed", 0 );
	/// <summary>Read Strength on the shared calibrated scale (see BrushCalibration) instead of raw kernel units.</summary>
	public readonly BoolParam Calibrated = new( "Calibrated", false );

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Bodies, Brush, Radius, Strength, Invert, Falloff, Mirror, Radial, RadialAxis, Spacing, Mask, Alpha, AlphaScale, AlphaRotation, AlphaDensity, AlphaJitter, AlphaSeed, Calibrated };

	public override IReadOnlyList<IParam> AdvancedParameters => new IParam[] { Falloff, RadialAxis, Spacing, Mask, Alpha, AlphaScale, AlphaRotation, AlphaDensity, AlphaJitter, AlphaSeed, Calibrated };

	protected override void Execute( FeatureContext ctx )
	{
		if ( Points.Count == 0 )
		{
			Fail(
				"The stroke has no path",
				"A stroke is a brush dragged along points, and none are set.",
				"Set points: points=x,y,z;x,y,z (or @landmarks)" );
		}

		var alpha = LoadAlpha();
		var radius = Radius.Clamped;
		var path = Resample( Points, MathF.Max( radius * Spacing.Clamped, 1e-4f ) );
		var kind = (BrushKind)Brush.Index;
		var touched = 0;
		var missed = new List<string>();
		var coarse = new List<string>();
		var coarseIds = new List<string>();
		var coarsest = 0f;

		foreach ( var body in RequireBodies( ctx, Bodies ) )
		{
			var mesh = body.Mesh;
			var bvh = MeshBVH.Build( mesh );
			var stroke = new BrushStroke
			{
				Kind = kind,
				Falloff = (BrushFalloff)Falloff.Index,
				MirrorAxes = BrushSymmetry.Choices[Math.Clamp( Mirror.Index, 0, BrushSymmetry.Choices.Length - 1 )],
				Radial = Radial.Clamped,
				RadialAxis = (MirrorAxis)(RadialAxis.Index + 1),
				Alpha = alpha,
				Calibrated = Calibrated.Value,
			};

			// Reach: far enough to forgive a path drawn off the skin, near enough that a path over one
			// body is not pulled onto another across a gap.
			var (lo, hi) = ModelMeasure.Bounds( mesh );
			var reach = MathF.Max( radius * 4f, (hi - lo).Length * 0.05f );
			var strength = Invert.Value ? -Strength.Clamped : Strength.Clamped;

			if ( kind is BrushKind.Grab or BrushKind.ElasticGrab )
			{
				// A grab takes hold where the path starts and drags that patch to where it ends; the end
				// may lie off the skin (that is the point of a grab), so it is not projected.
				if ( path.Count > 1 && bvh.NearestSurface( mesh, path[0], reach ) is { } hold )
					stroke.Samples.Add( new BrushSample( hold.Point, hold.Normal, radius, strength, path[^1] - path[0] ) );
			}
			else
			{
				for ( var i = 0; i < path.Count; i++ )
				{
					// A snake hook pulls each patch on toward the next path point.
					var drag = kind == BrushKind.SnakeHook && i + 1 < path.Count ? path[i + 1] - path[i] : Vec3.Zero;
					if ( bvh.NearestSurface( mesh, path[i], reach ) is { } hit )
						stroke.Samples.Add( new BrushSample( hit.Point, hit.Normal, radius, strength, drag ) );
				}
			}

			// Per-dab alpha jitter: each dab turns by a bounded, seeded amount, so repeated
				// stamps stop tiling like wallpaper. Same seed and path rebuild identically.
			if ( AlphaJitter.Clamped > 0f )
				for ( var si = 0; si < stroke.Samples.Count; si++ )
				{
					var s = stroke.Samples[si];
					stroke.Samples[si] = new BrushSample( s.Position, s.Normal, s.Radius, s.Strength, s.Direction,
						(JitterHash( AlphaSeed.Value, si ) - 0.5f) * 2f * AlphaJitter.Clamped );
				}

			if ( stroke.Samples.Count == 0 )
			{
				missed.Add( body.Name ?? body.Id );
				continue;
			}

			var mask = Mask.Index switch
			{
				1 => AutoMask.Cavity( mesh ),
				2 => AutoMask.Cavity( mesh, inverted: true ),
				_ => null,
			};

			var undo = Effigy.Brush.Apply( mesh, stroke, mask: mask, bvh: bvh );
			touched += undo.Count;

			if ( undo.Count == 0 )
			{
				var edge = MeanEdge( mesh );
				coarse.Add( edge > radius * 0.5f
					? $"{body.Name ?? body.Id}: the brush is {radius:0.##} across and its edges are {edge:0.##} long, so no vertex sits under it"
					: $"{body.Name ?? body.Id}: every vertex under it was masked out, or the strength is zero" );

				if ( edge > radius * 0.5f )
				{
					coarseIds.Add( body.Id );
					coarsest = MathF.Max( coarsest, edge );
				}
			}
		}

		// A stroke that moved nothing anywhere is an error: it is in the history claiming to be a
		// crease, and the skin is untouched. One that missed only some of its bodies is a warning.
		if ( touched == 0 && coarseIds.Count > 0 )
		{
			Fail(
				RemedyAction.SubdivideAbove( coarseIds, coarsest, radius * 0.5f ),
				"The stroke moved nothing",
				string.Join( "; ", coarse ) + ".",
				"Put a Subdivide above this, or make the radius bigger",
				"Check Strength and Only" );
		}

		if ( touched == 0 )
		{
			Fail(
				"The stroke moved nothing",
				coarse.Count > 0
					? string.Join( "; ", coarse ) + "."
					: "No point on the path is near the surface of the bodies it names.",
				coarse.Count > 0 ? "Put a Subdivide above this, or make the radius bigger" : "Move the points onto the body, or use landmarks like @Body.front",
				coarse.Count > 0 ? "Check Strength and Only" : "Check the Bodies selection" );
		}

		if ( missed.Count + coarse.Count > 0 )
		{
			Warn(
				"The stroke missed some bodies",
				string.Join( "; ", missed.Select( m => $"{m}: the path is nowhere near it" ).Concat( coarse ) ) + ".",
				"Take those bodies out of the selection, or move the path onto them" );
		}
	}

	BrushAlpha LoadAlpha()
	{
		var path = (Alpha.Value ?? "").Trim();

		if ( path.Length == 0 )
			return null;

		// A proc: name that is not a built-in stamp is an unknown stamp, not a missing file:
		// without this it falls through to the PNG branch and fails as "no file at proc:...".
		if ( path.StartsWith( "proc:", StringComparison.OrdinalIgnoreCase ) && !BrushAlpha.IsProcedural( path ) )
			FailOn( "Alpha",
				"Unknown procedural alpha",
				$"'{path}' is not a built-in stamp.",
				"Pick one of: " + string.Join( ", ", BrushAlpha.ProceduralNames ),
				"Or clear Alpha for a plain brush" );

		if ( LineworkAlpha.IsAlphaSpec( path ) )
		{
			if ( !LineworkAlpha.TryResolveSpec( path, out var spec, out var specError ) )
				FailOn( "Alpha",
					"The alpha spec is not usable",
					specError,
					"Give 'proc:<name>' for a built-in stamp, or 'linework:<path-or-id>' for a drawing",
					"Or clear Alpha for a plain brush" );

			spec.Scale = AlphaScale.Clamped;
			spec.RotationDegrees = AlphaRotation.Clamped;
			spec.Density = AlphaDensity.Clamped;
			return spec;
		}

		if ( !File.Exists( path ) )
		{
			FailOn( "Alpha PNG",
				"The alpha image is not there",
				$"No file at {Path.GetFullPath( path )}.",
				"Give a full path to a greyscale PNG",
				"Or clear Alpha PNG for a plain brush" );
		}

		var alpha = BrushAlpha.FromPng( File.ReadAllBytes( path ) );
		alpha.Scale = AlphaScale.Clamped;
		alpha.RotationDegrees = AlphaRotation.Clamped;
		alpha.Density = AlphaDensity.Clamped;
		return alpha;
	}

	/// <summary>Deterministic 0..1 hash of (seed, index) for per-dab jitter: no Random, so a
	/// saved feature rebuilds the same jitter on every machine and every run.</summary>
	static float JitterHash( int seed, int index )
	{
		var x = MathF.Sin( seed * 127.1f + index * 311.7f ) * 43758.5453f;
		return x - MathF.Floor( x );
	}

	static List<Vec3> Resample( List<Vec3> points, float step )
	{
		var output = new List<Vec3> { points[0] };

		for ( var i = 1; i < points.Count; i++ )
		{
			var a = points[i - 1];
			var b = points[i];
			var n = Math.Max( 1, (int)MathF.Ceiling( (b - a).Length / step ) );

			for ( var k = 1; k <= n; k++ )
				output.Add( a + (b - a) * (k / (float)n) );
		}

		return output;
	}

	internal static float MeanEdge( PolyMesh mesh )
	{
		double sum = 0;
		long count = 0;

		foreach ( var f in mesh.Faces )
			for ( var i = 0; i < f.Count; i++ )
			{
				sum += (mesh.Positions[f.Indices[i]] - mesh.Positions[f.Indices[(i + 1) % f.Count]]).Length;
				count++;
			}

		return count == 0 ? 0f : (float)(sum / count);
	}
}

/// <summary>
/// The secondary and tertiary skin passes of <see cref="SurfaceDetail"/> as a feature: grain (tissue
/// lumps and a Worley crease network), pustule clusters, an even scatter of domes or pits, and sag
/// folds — masked to creases or ridges, to a share of the skin, and to a reach around a point.
///
/// WHY THE MASKS MATTER MORE THAN THE PASSES. The judges' first lesson was that detail spread evenly
/// reads as noise: sculptors keep most skin calm. So Busy defaults below one (about 40% of the skin
/// takes the pass, in broad patches) and Near/Reach confine a pass to where it means something.
///
/// Sizes are in model units (inches on a creature). A pass finer than the mesh moves nothing; the
/// feature measures that and says to subdivide, rather than leaving the skin untouched in silence.
/// </summary>
public sealed class DetailFeature : Feature
{
	public override string TypeName => "Surface detail";

	public override GeometryKind Accepts => GeometryKind.Body;

	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly ChoiceParam Pass = new( "Pass", new[] { "Grain", "Pustules", "Scatter", "Sag folds", "Direction folds", "Anchored folds", "Pores" } );

	/// <summary>Grain: the crease cells' width. Pustules: the biggest one's radius. Scatter: each
	/// stamp's radius. Sag folds: the distance between fold crests.</summary>
	public readonly FloatParam Size = new( "Size", 1f, 0.001f, unit: "u" );

	/// <summary>Grain: how deep the creases are cut. Scatter and folds: the height; negative pits.</summary>
	public readonly FloatParam Depth = new( "Depth", 0.05f, unit: "u" );

	public readonly FloatParam Lumps = new( "Lumps", 0.05f, 0f, unit: "u" );
	public readonly FloatParam LumpSize = new( "Lump size", 3f, 0.01f, unit: "u" );
	public readonly IntParam Clusters = new( "Clusters", 3, 1, 200 );
	public readonly IntParam PerCluster = new( "Per cluster", 8, 1, 500 );
	public readonly FloatParam Spread = new( "Spread", 3f, 0.01f, unit: "u" );
	public readonly FloatParam Spacing = new( "Spacing", 2f, 0.01f, unit: "u" );
	public readonly BoolParam Pits = new( "Pits, not domes", false );
	public readonly FloatParam Busy = new( "Busy", 0.4f, 0.01f, 1f );
	public readonly FloatParam BusySize = new( "Busy patch size", 16f, 0.1f, unit: "u" );
	public readonly ChoiceParam Only = new( "Only", new[] { "Everywhere", "Creases", "Ridges" } );
	public readonly Vec3Param Near = new( "Near", Vec3.Zero );
	public readonly FloatParam Reach = new( "Reach", 0f, 0f, unit: "u" );
	public readonly Vec3Param Up = new( "Up", new Vec3( 0, 0, 1 ) );
	/// <summary>Direction folds: direction of compression / muscle pull; crests run perpendicular to it.</summary>
	public readonly Vec3Param Direction = new( "Direction", new Vec3( 0, 1, 0 ) );
	/// <summary>Direction folds: rolled-lip height as a share of Depth.</summary>
	public readonly FloatParam Lip = new( "Lip", 0.5f, 0f, 2f );
	/// <summary>Direction folds: extra amplitude on the bunched side, 0..1.</summary>
	public readonly FloatParam Bunch = new( "Bunch", 0.5f, 0f, 1f );
	public readonly IntParam Seed = new( "Seed", 1, 0, 100000 ) { Slider = false };

	public override IReadOnlyList<IParam> Parameters =>
		new IParam[] { Bodies, Pass, Size, Depth, Lumps, LumpSize, Clusters, PerCluster, Spread, Spacing, Pits, Busy, BusySize, Only, Near, Reach, Up, Direction, Lip, Bunch, Seed };

	public override IReadOnlyList<IParam> AdvancedParameters =>
		new IParam[] { Lumps, LumpSize, Clusters, PerCluster, Spread, Spacing, Pits, BusySize, Up, Direction, Lip, Bunch, Seed };

	protected override void Execute( FeatureContext ctx )
	{
		var moved = 0f;
		var coarse = new List<string>();
		var coarseIds = new List<string>();
		var coarsest = 0f;

		foreach ( var body in RequireBodies( ctx, Bodies ) )
		{
			var mesh = body.Mesh;
			var before = mesh.Positions.ToArray();
			var mask = BuildMask( mesh );
			bool Where( int v ) => mask[v] > 0.5f;

			switch ( Pass.Index )
			{
				case 0:
					SurfaceDetail.Grain( mesh, Lumps.Clamped, 1f / LumpSize.Clamped, Size.Clamped, Depth.Value, Seed.Clamped, v => mask[v] );
					break;

				case 1:
				{
					var stamps = SurfaceDetail.Clusters( mesh, Where, Clusters.Clamped, PerCluster.Clamped, Spread.Clamped, Size.Clamped * 0.3f, Size.Clamped, Seed.Clamped );
					SurfaceDetail.Stamps( mesh, Pits.Value ? stamps.Select( s => s with { Height = -s.Height } ) : stamps );
					break;
				}

				case 2:
				{
					var height = MathF.Abs( Depth.Value ) * (Pits.Value || Depth.Value < 0f ? -1f : 1f);
					var picked = SurfaceDetail.PoissonOnSurface( mesh, Spacing.Clamped, Where, Seed.Clamped );
					SurfaceDetail.Stamps( mesh, picked.Select( v => new SurfaceStamp( before[v], Size.Clamped, height ) ) );
					break;
				}

				case 3:
					SurfaceDetail.SagFolds( mesh, mask, new FoldOptions { Spacing = Size.Clamped, Amplitude = Depth.Value, Up = Up.Value, Seed = Seed.Clamped } );
					break;

				case 4:
					SurfaceDetail.DirectionFolds( mesh, mask, new DirectionFoldOptions { Direction = Direction.Value, Spacing = Size.Clamped, Amplitude = Depth.Value, Lip = Lip.Clamped, Bunch = Bunch.Clamped, Seed = Seed.Clamped } );
					break;

				case 5:
				{
					// Anchor = Near point; folds hang on the side below it along Up. Distance is
					// the drop below the anchor; vertices above it are out of reach.
					var dist = new float[mesh.VertexCount];
					for ( var v = 0; v < mesh.VertexCount; v++ )
					{
						var d = Vec3.Dot( Near.Value - mesh.Positions[v], Up.Value );
						dist[v] = d > 0f ? d : float.MaxValue;
					}
					SurfaceDetail.AnchoredFolds( mesh, dist, v => dist[v] < float.MaxValue,
						new AnchoredFoldOptions { Count = Clusters.Clamped, First = Size.Clamped, Spacing = Size.Clamped, Amplitude = Depth.Value, Up = Up.Value, Seed = Seed.Clamped } );
					break;
				}

				case 6:
					SurfaceDetail.Pores( mesh, mask, new PoreOptions { Spacing = Spacing.Clamped, Depth = Depth.Value, Seed = Seed.Clamped } );
					break;

				default:
					SurfaceDetail.SagFolds( mesh, mask, new FoldOptions { Spacing = Size.Clamped, Amplitude = Depth.Value, Up = Up.Value, Seed = Seed.Clamped } );
					break;
			}

			var most = 0f;
			for ( var v = 0; v < mesh.VertexCount; v++ )
				most = MathF.Max( most, (mesh.Positions[v] - before[v]).Length );

			moved = MathF.Max( moved, most );

			var edge = StrokeFeature.MeanEdge( mesh );
			if ( edge > Size.Clamped * 0.5f )
			{
				coarse.Add( $"{body.Name ?? body.Id}: the detail is {Size.Clamped:0.##} across and its edges are {edge:0.##} long, so no vertex sits under it" );
				coarseIds.Add( body.Id );
				coarsest = MathF.Max( coarsest, edge );
			}
		}

		var subdivide = coarseIds.Count > 0 ? RemedyAction.SubdivideAbove( coarseIds, coarsest, Size.Clamped * 0.5f ) : null;

		if ( moved <= 1e-6f && subdivide is not null )
		{
			Fail(
				subdivide,
				"The detail pass moved nothing",
				"The detail is finer than the mesh: " + string.Join( ", ", coarse ) + ".",
				"Put a Subdivide above this, or make Size bigger",
				"Widen Reach, raise Busy, or set Only to Everywhere" );
		}

		if ( moved <= 1e-6f )
		{
			Fail(
				"The detail pass moved nothing",
				coarse.Count > 0
					? "The detail is finer than the mesh: " + string.Join( ", ", coarse ) + "."
					: "The masks left no skin for it: Only, Busy and Reach together exclude every vertex.",
				"Put a Subdivide above this, or make Size bigger",
				"Widen Reach, raise Busy, or set Only to Everywhere" );
		}

		// Sculpt/paint reporting, 2026-10-25: a detail finer than the mesh is
			// an error in Stroke's own words, not a parenthetical note. Stroke
			// fails "the brush is X across and its edges are Y long, so no
			// vertex sits under it" with Subdivide / bigger-radius remedies;
			// Detail now fails the same way, with the Subdivide remedy action
			// attached, whether or not a few vertices happened to move. The
			// moved-nothing case below is kept for masks that exclude all skin.
		if ( coarse.Count > 0 )
		{
			Fail(
				subdivide,
				"The detail is finer than the mesh",
				string.Join( "; ", coarse ) + ".",
				"Put a Subdivide above this, or make Size bigger",
				"Widen Reach, raise Busy, or set Only to Everywhere" );
		}
	}

	float[] BuildMask( PolyMesh mesh )
	{
		var n = mesh.VertexCount;
		var mask = Busy.Clamped >= 0.999f
			? Enumerable.Repeat( 1f, n ).ToArray()
			: SurfaceDetail.BusyMask( mesh, Busy.Clamped, 1f / BusySize.Clamped, Seed.Clamped + 5 );

		if ( Only.Index > 0 )
		{
			var cavity = AutoMask.Cavity( mesh, inverted: Only.Index == 2 );
			for ( var v = 0; v < n; v++ ) mask[v] *= cavity[v];
		}

		if ( Reach.Value > 0f )
		{
			for ( var v = 0; v < n; v++ )
			{
				var t = Math.Clamp( 1f - (mesh.Positions[v] - Near.Value).Length / Reach.Value, 0f, 1f );
				mask[v] *= t * t * (3f - 2f * t);
			}
		}

		return mask;
	}
}

/// <summary>
/// Muscle bulge: a flexed muscle belly on an existing body. Vertices near the
/// origin-to-insertion axis are pushed along their normals, thickest mid-belly
/// (sin profile) and fading toward the tendons, so a limb reads flexed rather
/// than uniformly fat. With Preserve volume on, the mesh is then rescaled about
/// its centroid to restore its pre-bulge volume, so bulge shortens/thickens
/// instead of inflating. This is the static half of pose-driven bulge; the
/// pose-driven half already exists as Corrective Shape Key (angle driver).
/// </summary>
public sealed class MuscleBulgeFeature : Feature
{
	public override string TypeName => "Muscle bulge";
	public override GeometryKind Accepts => GeometryKind.Body;
	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly Vec3Param Origin = new( "Origin", Vec3.Zero );
	public readonly Vec3Param Insertion = new( "Insertion", new Vec3( 0, 0, 10 ) );
	public readonly FloatParam Radius = new( "Radius", 3f, 0.01f, unit: "u" );
	public readonly FloatParam Bulge = new( "Bulge", 0.5f, unit: "u" );
	public readonly BoolParam PreserveVolume = new( "Preserve volume", true );
	public override IReadOnlyList<IParam> Parameters => new IParam[] { Bodies, Origin, Insertion, Radius, Bulge, PreserveVolume };
	protected override void Execute( FeatureContext ctx )
	{
		var axis = Insertion.Value - Origin.Value;
		var len = axis.Length;
		if ( len < 1e-6f ) { Fail( "Muscle bulge has no axis", "Origin and Insertion are the same point.", "Move Insertion away from Origin" ); return; }
		var dir = axis / len;
		foreach ( var body in RequireBodies( ctx, Bodies ) )
		{
			var mesh = body.Mesh;
			var normals = SurfaceDetail.VertexNormals( mesh );
			var before = PreserveVolume.Value ? MathF.Abs( PressureBalloon.Volume( mesh ) ) : 0f;
			for ( var v = 0; v < mesh.VertexCount; v++ )
			{
				var rel = mesh.Positions[v] - Origin.Value;
				var t = Math.Clamp( Vec3.Dot( rel, dir ) / len, 0f, 1f );
				var closest = Origin.Value + dir * (t * len);
				var radial = mesh.Positions[v] - closest;
				var r = radial.Length;
				var profile = MathF.Pow( MathF.Max( 0f, MathF.Sin( MathF.PI * t ) ), 0.7f );
				var w = r <= Radius.Clamped ? 1f : MathF.Exp( -((r - Radius.Clamped) / Radius.Clamped) * ((r - Radius.Clamped) / Radius.Clamped) );
				mesh.Positions[v] += normals[v] * (Bulge.Value * profile * w);
			}
			if ( PreserveVolume.Value && before > 1e-9f )
			{
				var after = MathF.Abs( PressureBalloon.Volume( mesh ) );
				if ( after > 1e-9f && float.IsFinite( after ) )
				{
					var s = MathF.Pow( before / after, 1f / 3f );
					var c = mesh.Positions.Aggregate( Vec3.Zero, ( a, b ) => a + b ) / Math.Max( 1, mesh.VertexCount );
					for ( var v = 0; v < mesh.VertexCount; v++ ) mesh.Positions[v] = c + (mesh.Positions[v] - c) * s;
				}
			}
		}
	}
}

/// <summary>
/// Break symmetry: tertiary detail differs left from right, as real skin does.
/// Each side of the chosen axis gets a different noise field, so detail (not
/// primary proportions) stops mirroring. Strength is in model units along the
/// normal; keep it small relative to the form.
/// </summary>
public sealed class AsymmetryFeature : Feature
{
	public override string TypeName => "Break symmetry";
	public override GeometryKind Accepts => GeometryKind.Body;
	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly ChoiceParam Axis = new( "Axis", new[] { "X", "Y", "Z" } );
	public readonly FloatParam Strength = new( "Strength", 0.05f, 0f, unit: "u" );
	public readonly FloatParam Scale = new( "Scale", 3f, 0.1f, unit: "u" );
	public readonly IntParam Seed = new( "Seed", 1, 0, 100000 ) { Slider = false };
	public override IReadOnlyList<IParam> Parameters => new IParam[] { Bodies, Axis, Strength, Scale, Seed };
	protected override void Execute( FeatureContext ctx )
	{
		var ax = Axis.Index switch { 1 => new Vec3( 0, 1, 0 ), 2 => new Vec3( 0, 0, 1 ), _ => new Vec3( 1, 0, 0 ) };
		var n1 = new Noise3( Seed.Clamped );
		var n2 = new Noise3( Seed.Clamped + 101 );
		foreach ( var body in RequireBodies( ctx, Bodies ) )
		{
			var mesh = body.Mesh;
			var normals = SurfaceDetail.VertexNormals( mesh );
			var c = mesh.Positions.Aggregate( Vec3.Zero, ( a, b ) => a + b ) / Math.Max( 1, mesh.VertexCount );
			for ( var v = 0; v < mesh.VertexCount; v++ )
			{
				var side = Vec3.Dot( mesh.Positions[v] - c, ax ) >= 0f;
				var noise = side ? n1 : n2;
				mesh.Positions[v] += normals[v] * (Strength.Value * noise.Sample( mesh.Positions[v] * (1f / Scale.Clamped) ));
			}
		}
	}
}

/// <summary>
/// Whole-mesh sculpt filter, exposing <see cref="MeshFilter"/> to scripts,
/// including SurfaceSmooth (HC-Laplacian: smooths without the shrink of plain
/// Laplacian). Strength is per iteration, in the filter's own units.
/// </summary>
public sealed class MeshFilterFeature : Feature
{
	public override string TypeName => "Mesh filter";
	public override GeometryKind Accepts => GeometryKind.Body;
	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly ChoiceParam Filter = new( "Filter", Enum.GetNames( typeof( MeshFilterKind ) ) );
	public readonly FloatParam Strength = new( "Strength", 0.5f, -1f, 1f );
	public readonly IntParam Iterations = new( "Iterations", 1, 1, 20 );
	public override IReadOnlyList<IParam> Parameters => new IParam[] { Bodies, Filter, Strength, Iterations };
	protected override void Execute( FeatureContext ctx )
	{
		var kind = (MeshFilterKind)Math.Clamp( Filter.Index, 0, Enum.GetNames( typeof( MeshFilterKind ) ).Length - 1 );
		foreach ( var body in RequireBodies( ctx, Bodies ) )
			MeshFilter.Apply( body.Mesh, kind, Strength.Value, Iterations.Clamped );
	}
}

/// <summary>
/// Path mark: veins, stretch marks, and scars as first-class passes over a
/// path, instead of hand-painted lines. Vein raises a soft tube-like ridge
/// and recolours nearby faces to the given slot; Stretch Mark sinks pale
/// striations; Scar raises a pale keloid ridge. Path is "x,y,z; x,y,z; ...".
/// </summary>
public sealed class PathMarkFeature : Feature
{
	public override string TypeName => "Path mark";
	public override GeometryKind Accepts => GeometryKind.Body;
	public readonly BodySelectionParam Bodies = new( "Bodies" );
	public readonly ChoiceParam Kind = new( "Kind", new[] { "Vein", "Stretch mark", "Scar" } );
	public readonly StringParam Path = new( "Path", "" );
	public readonly FloatParam Width = new( "Width", 0.5f, 0.01f, unit: "u" );
	public readonly FloatParam Height = new( "Height", 0.1f, unit: "u" );
	public readonly IntParam Slot = new( "Material slot", 1, 0, 63 ) { Slider = false };
	public override IReadOnlyList<IParam> Parameters => new IParam[] { Bodies, Kind, Path, Width, Height, Slot };
	protected override void Execute( FeatureContext ctx )
	{
		var pts = new List<Vec3>();
		foreach ( var piece in (Path.Value ?? "").Split( ';', StringSplitOptions.RemoveEmptyEntries ) )
		{
			if ( !ModelMeasure.TryParseVec3( piece.Trim(), out var p ) )
			{ FailOn( "Path", "A path point cannot be read", $"'{piece.Trim()}' is not x,y,z.", "Write points as x,y,z separated by ;" ); return; }
			pts.Add( p );
		}
		if ( pts.Count < 2 ) { Fail( "Path mark needs a path", "Fewer than two points were given.", "Give two or more points separated by ;" ); return; }
		float DistToPath( Vec3 p )
		{
			var best = float.MaxValue;
			for ( var i = 0; i + 1 < pts.Count; i++ )
			{
				var ab = pts[i + 1] - pts[i];
				var t = Math.Clamp( ab.LengthSquared > 1e-12f ? Vec3.Dot( p - pts[i], ab ) / ab.LengthSquared : 0f, 0f, 1f );
				best = Math.Min( best, (p - (pts[i] + ab * t)).Length );
			}
			return best;
		}
		var sign = Kind.Index == 1 ? -1f : 1f;
		foreach ( var body in RequireBodies( ctx, Bodies ) )
		{
			var mesh = body.Mesh;
			var normals = SurfaceDetail.VertexNormals( mesh );
			for ( var v = 0; v < mesh.VertexCount; v++ )
			{
				var d = DistToPath( mesh.Positions[v] );
				if ( d > Width.Clamped * 2f ) continue;
				var w = MathF.Exp( -(d / Width.Clamped) * (d / Width.Clamped) );
				mesh.Positions[v] += normals[v] * (sign * Height.Value * w);
			}
			for ( var f = 0; f < mesh.FaceCount; f++ )
			{
				var face = mesh.Faces[f];
				var c = Vec3.Zero;
				foreach ( var i in face.Indices ) c += mesh.Positions[i];
				c /= Math.Max( 1, face.Count );
				if ( DistToPath( c ) <= Width.Clamped ) face.Material = Slot.Clamped;
			}
		}
	}
}
