		_gl.TexParameter( TextureTarget.Texture2D, TextureParameterName.TextureMagFilter, (int)GLEnum.Nearest );
		_gl.TexParameter( TextureTarget.Texture2D, TextureParameterName.TextureWrapS, (int)GLEnum.ClampToEdge );
		_gl.TexParameter( TextureTarget.Texture2D, TextureParameterName.TextureWrapT, (int)GLEnum.ClampToEdge );
	}

	/// <summary>Upload a worker-prepared HDR environment on the owning GL thread.
	/// Prepare with IblBaker.Prepare(WorldEnvironment.LoadRadiance(path)) off-thread.</summary>
	public unsafe void SetEnvironment(IblBaker.PreparedEnvironment environment)
	{
		ArgumentNullException.ThrowIfNull(environment);
		environment.Validate();
		lock (_environmentGate) if (_disposed) throw new ObjectDisposedException(nameof(SceneRenderer));
		var irradiance = (Vector3[])environment.Irradiance.Clone();
		uint cube = 0, lut = 0;
		_gl.GetInteger(GetPName.ActiveTexture, out int activeTexture);
		try
		{
		cube = _gl.GenTexture();
		_gl.ActiveTexture(TextureUnit.Texture8);
		_gl.BindTexture(TextureTarget.TextureCubeMap, cube);
		for (int level = 0; level < environment.Specular.Length; level++)
		{
			var mip = environment.Specular[level];
			for (int face = 0; face < 6; face++)
				fixed (Vector3* pixels = mip.Faces[face])
					_gl.TexImage2D((TextureTarget)((int)TextureTarget.TextureCubeMapPositiveX + face), level,
						InternalFormat.Rgb16f, (uint)mip.Size, (uint)mip.Size, 0, PixelFormat.Rgb, PixelType.Float, pixels);
		}
		_gl.TexParameter(TextureTarget.TextureCubeMap, TextureParameterName.TextureMaxLevel, environment.Specular.Length - 1);
		_gl.TexParameter(TextureTarget.TextureCubeMap, TextureParameterName.TextureMinFilter, (int)GLEnum.LinearMipmapLinear);
		_gl.TexParameter(TextureTarget.TextureCubeMap, TextureParameterName.TextureMagFilter, (int)GLEnum.Linear);
		_gl.TexParameter(TextureTarget.TextureCubeMap, TextureParameterName.TextureWrapS, (int)GLEnum.ClampToEdge);
		_gl.TexParameter(TextureTarget.TextureCubeMap, TextureParameterName.TextureWrapT, (int)GLEnum.ClampToEdge);
		_gl.TexParameter(TextureTarget.TextureCubeMap, TextureParameterName.TextureWrapR, (int)GLEnum.ClampToEdge);
		_gl.Enable(EnableCap.TextureCubeMapSeamless);
		lut = _gl.GenTexture();
		_gl.ActiveTexture(TextureUnit.Texture10);
		_gl.BindTexture(TextureTarget.Texture2D, lut);
		fixed (Vector2* pixels = environment.Brdf)
			_gl.TexImage2D(TextureTarget.Texture2D, 0, InternalFormat.RG16f, (uint)environment.LutSize,
				(uint)environment.LutSize, 0, PixelFormat.RG, PixelType.Float, pixels);
		_gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMinFilter, (int)GLEnum.Linear);
		_gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMagFilter, (int)GLEnum.Linear);
		_gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureWrapS, (int)GLEnum.ClampToEdge);
		_gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureWrapT, (int)GLEnum.ClampToEdge);
		if (_envMap != 0) _gl.DeleteTexture(_envMap);
		if (_brdfLut != 0) _gl.DeleteTexture(_brdfLut);
		_envMap = cube; _brdfLut = lut;
		cube = 0; lut = 0;
		_environmentLevels = environment.Specular.Length;
		_irradiance = irradiance;
		ResetTemporalHistory();
		}
		finally
		{
			if (cube != 0) _gl.DeleteTexture(cube);
			if (lut != 0) _gl.DeleteTexture(lut);
			_gl.ActiveTexture((TextureUnit)activeTexture);
		}
	}

	/// <summary>Wave-2 look wiring: the named environment preset this renderer should
	/// show, or null for the default procedural sky. Setting it starts the same async
	/// bake-and-promote path as <see cref="LoadEnvironmentAsync"/>, through
	/// <see cref="IblBaker.PreparePreset"/> — before this flag, presets were numeric-only
	/// (a caller could bake one, but the renderer had no preset to select).</summary>
	public string EnvironmentPreset { get; private set; }

	/// <summary>Switch the sky to a named environment preset (see
	/// <see cref="IblBaker.PreparePreset"/> for the names), promoted on the next Draw.
	/// Unknown names fail from the preset lookup, on the worker, not mid-frame.</summary>
	public async System.Threading.Tasks.Task LoadEnvironmentPresetAsync(string name,
		System.Threading.CancellationToken cancellationToken = default)
	{
		ArgumentException.ThrowIfNullOrWhiteSpace(name);
		int revision;
		lock (_environmentGate)
		{
			if (_disposed) throw new ObjectDisposedException(nameof(SceneRenderer));
			revision = ++_environmentRevision;
			_pendingEnvironment = null;
		}
		var prepared = await System.Threading.Tasks.Task.Run(() =>
		{
			cancellationToken.ThrowIfCancellationRequested();
			var result = IblBaker.PreparePreset(name, cancellationToken: cancellationToken);
			cancellationToken.ThrowIfCancellationRequested();
			return result;
		}, cancellationToken).ConfigureAwait(false);
		lock (_environmentGate)
			if (!_disposed && revision == _environmentRevision && !cancellationToken.IsCancellationRequested)
			{
				_pendingEnvironment = prepared;
				EnvironmentPreset = name;
			}
	}

	/// <summary>Wave-2 look wiring: fire a particle cue in the live viewport. Before this,
	/// <see cref="ParticleSystem.TriggerCue"/> had no production caller in the viewport
	/// path — only tests and fixtures. The first cue creates one shared system and one
	/// sprite particle layer on <see cref="Live"/> (stepped by the frame loop's
	/// <c>Live.Advance</c>); later cues reuse it. Returns the emitter, or null when the
	/// cue names no preset, so an unrelated timeline mark never becomes an explosion.</summary>
	public ParticleEmitter TriggerParticleCue(string cueName, Vector3 origin, Vector3 direction = default)
	{
		if (string.IsNullOrWhiteSpace(cueName)) return null;
		if (_particleLayer is null)
		{
			_particleSystem = new ParticleSystem( new ParticleSystemSettings() );
			_particleLayer = new ParticleLayer(_particleSystem)
				{ Material = new LiveMaterial(Vector3.One, Alpha: .5f, Blend: true) { Sprite = true } };
			Live.Layers.Add(_particleLayer);
		}
		return _particleSystem.TriggerCue(cueName, origin, direction == default ? null : direction);
	}
	ParticleSystem _particleSystem;
	ParticleLayer _particleLayer;

	/// <summary>Decode and bake without GL access. The newest completed request is
	/// promoted by Draw on its GL thread; stale requests cannot replace a newer sky.</summary>
	public async System.Threading.Tasks.Task LoadEnvironmentAsync(string path,
		System.Threading.CancellationToken cancellationToken = default)
	{
		int revision;
		lock (_environmentGate)
		{
			if (_disposed) throw new ObjectDisposedException(nameof(SceneRenderer));
			revision = ++_environmentRevision;
			_pendingEnvironment = null;
		}
		var prepared = await System.Threading.Tasks.Task.Run(() =>
		{
			cancellationToken.ThrowIfCancellationRequested();
			var source = WorldEnvironment.LoadRadiance(path);
			var result = IblBaker.Prepare(source, cancellationToken: cancellationToken);
			cancellationToken.ThrowIfCancellationRequested();
			return result;
		}, cancellationToken).ConfigureAwait(false);
		lock (_environmentGate)
			if (!_disposed && revision == _environmentRevision && !cancellationToken.IsCancellationRequested)
				_pendingEnvironment = prepared;
	}

	/// <summary>Per-frame inputs shared by every pass.</summary>
	readonly record struct Frame( ViewportMesh Mesh, MarionettePlayer Player, OrbitCamera Camera, int Width, int Height, float Exposure, uint Target );

	readonly List<RenderPassKind> _lastFrame = new( 8 );
	// R10: per-pass CPU/GPU time and allocation.
	readonly RenderStats _stats;
	public RenderStats Stats => _stats;
	/// <summary>The passes the last <see cref="Draw"/> executed, in order.</summary>
	public IReadOnlyList<RenderPassKind> LastFramePasses => _lastFrame;

	public void Draw( ViewportMesh mesh, MarionettePlayer player, OrbitCamera camera, int width, int height, float exposure, uint target = 0 )
	{
		IblBaker.PreparedEnvironment pending;
		lock (_environmentGate) { pending = _pendingEnvironment; _pendingEnvironment = null; }
		if (pending is not null) SetEnvironment(pending);
		_taa.Enabled = AntiAliasing == AntiAliasingMode.Temporal;
		if (AntiAliasing != AntiAliasingMode.Msaa4 && _msaa.Framebuffer != 0) _msaa.Dispose();
		if (!ReferenceEquals(_temporalMesh, mesh)) { ResetTemporalHistory(); _temporalMesh = mesh; }
		// R7: cut / resize / reload detection, before SSR samples last frame's colour.
		if ( _motionBlur.Track( camera, mesh, player, width, height ) ) { _taa.Reset(); _bloom.ResetHistory(); Live.ResetHistory = true; }
		long frameAlloc = GC.GetAllocatedBytesForCurrentThread();
		_stats.BeginFrame();
		var frame = new Frame( mesh, player, camera, width, height, exposure, target );
		_lastFrame.Clear();
		var order = RenderPassOrder.Default;
		for ( int p = 0; p < order.Count; p++ )
		{
			var pass = order[p];
			_stats.Begin( pass );
			switch ( pass )
			{
				case RenderPassKind.Shadow: ShadowPass( frame ); break;
				case RenderPassKind.DepthPrePass: DepthPrePass( frame ); break;
				case RenderPassKind.Lit: LitPass( frame ); ApplyVolumes( frame ); break;
				case RenderPassKind.PostChain: PostChain( frame ); break;
				default: throw new InvalidOperationException( "Unhandled render pass " + pass );
			}
			_stats.End( pass );
			_lastFrame.Add( pass );
		}
		_stats.EndFrame( GC.GetAllocatedBytesForCurrentThread() - frameAlloc );
	}

	readonly Dictionary<string, float> _mergedWeights = new( StringComparer.Ordinal );

	/// <summary>A clip's morph weights with the mesh's own (the Face Poser's) on top, so a face set on
	/// the sliders still shows while a clip plays.</summary>
	IReadOnlyDictionary<string, float> MergedWeights( IReadOnlyDictionary<string, float> clip, Dictionary<string, float> mesh )
	{
		if ( mesh.Count == 0 ) return clip;
		_mergedWeights.Clear();
		if ( clip is not null ) foreach ( var kv in clip ) _mergedWeights[kv.Key] = kv.Value;
		foreach ( var kv in mesh ) _mergedWeights[kv.Key] = kv.Value;
		return _mergedWeights;
	}

	void ShadowPass( in Frame f )
	{
		f.Mesh.ApplyMorphWeights( _gl, f.Player is null ? f.Mesh.MorphWeights : MergedWeights( f.Player.MorphWeights, f.Mesh.MorphWeights ) );
		_shadow.LightDirection = KeyDirection;
		// R9: live geometry is built once per frame here, before the first pass that draws it.
		if ( !Live.IsEmpty )
		{
			var view = f.Camera.ViewMatrix();
			var inv = Matrix4x4.Invert( view, out var camWorld ) ? camWorld : Matrix4x4.Identity;
			Live.Build( _gl, new LiveView( f.Camera.Eye, new Vector3( inv.M11, inv.M12, inv.M13 ), new Vector3( inv.M21, inv.M22, inv.M23 ), -new Vector3( inv.M31, inv.M32, inv.M33 ) ) );
		}
		_shadow.Draw( f.Mesh, f.Player, Live.IsEmpty ? null : Live );
	}

	void DrawScene( ViewportMesh mesh, Action beforeTranslucent = null ) =>
		mesh.DrawBatched( _gl, _shader, _albedo, _roughness, _metallic, _emission, _normalY, _uvScale, _uvOffset, _uvRotation, _alphaMode, _alphaCutoff, _baseAlpha, _normalStrength, _ps1Occlusion, _ps1Wear, _ps1WearColor, _ps1Grime, _ps1GrimeFilm, _ps1Glow, _doubleSided, _lobes, beforeTranslucent );

	/// <summary>Between the opaque and translucent groups of the lit pass: snapshot the HDR scene
	/// so refraction reads finished opaque colour without a feedback loop.</summary>
	void CopyOpaque()
	{
		_gl.BindFramebuffer( FramebufferTarget.ReadFramebuffer, _litFramebuffer );
		_gl.BindFramebuffer( FramebufferTarget.DrawFramebuffer, _opaqueCopy.Framebuffer );
		_gl.BlitFramebuffer( 0, 0, _opaqueCopy.Width, _opaqueCopy.Height, 0, 0, _opaqueCopy.Width, _opaqueCopy.Height, ClearBufferMask.ColorBufferBit, BlitFramebufferFilter.Nearest );
		_gl.BindFramebuffer( FramebufferTarget.Framebuffer, _litFramebuffer );
	}

	/// <summary>Sizes the frame targets, sets the lit shader's frame uniforms and sampler units
	/// (the pre-pass uses the same shader), then writes scene depth for SSAO/SSR.</summary>
	void DepthPrePass( in Frame f )
	{
		int width = f.Width, height = f.Height;
		// Size the bloom targets before any sampler bindings: creation binds its textures
		// onto whichever unit is active, so it must not run between the bindings below.
		_bloom.Ensure( width, height );
		_gl.BindFramebuffer( FramebufferTarget.Framebuffer, f.Target );
		_gl.Viewport( 0, 0, (uint)width, (uint)height );
