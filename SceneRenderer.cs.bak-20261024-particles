		_gl.ActiveTexture( TextureUnit.Texture7 );
		_gl.BindTexture( TextureTarget.Texture2D, _depthTarget.DepthTexture );
		_litFramebuffer = multisampled ? _msaa.Framebuffer : _bloom.ColorFbo;
		_gl.BindFramebuffer( FramebufferTarget.Framebuffer, _litFramebuffer );
		_gl.Viewport( 0, 0, (uint)f.Width, (uint)f.Height );
		_gl.Enable( EnableCap.DepthTest );
		_gl.ClearColor( 0.14f, 0.145f, 0.16f, 1 );
		_gl.Clear( ClearBufferMask.ColorBufferBit | ClearBufferMask.DepthBufferBit );
		if ( WireframeMode == 2 )
		{
			_gl.PolygonMode( GLEnum.FrontAndBack, PolygonMode.Line );
			DrawScene( f.Mesh );
			_gl.PolygonMode( GLEnum.FrontAndBack, PolygonMode.Fill );
			if (multisampled) _msaa.Resolve(_bloom.ColorFbo);
			return;
		}
		DrawScene( f.Mesh, _copyOpaqueCallback );
		DrawProps( f, depthOnly: false );
		if ( !Live.IsEmpty )
		{
			Live.Draw( _gl, _shader, LiveUniforms, _lobes, translucent: false, _liveSkinned );
			Live.Draw( _gl, _shader, LiveUniforms, _lobes, translucent: true, _liveSkinned );
		}
		if ( GroundShadow )
		{
			Ground.Shade( _frameViewProjection, f.Camera, _shadow.ViewProjection, _shadow.DepthRange, _shadow.WorldTexelSize, MathF.Max( 0, ShadowRadius ), 0, 12, f.Width, f.Height );
			_shader.Use();
		}
		if ( WireframeMode == 1 )
		{
			_gl.Enable( EnableCap.PolygonOffsetLine );
			_gl.PolygonOffset( -1.5f, -2.0f );
			_gl.PolygonMode( GLEnum.FrontAndBack, PolygonMode.Line );
			DrawScene( f.Mesh );
			_gl.PolygonMode( GLEnum.FrontAndBack, PolygonMode.Fill );
			_gl.Disable( EnableCap.PolygonOffsetLine );
		}
		if (multisampled) _msaa.Resolve(_bloom.ColorFbo);
	}

	/// <summary>Draws the clip's reference props through the same lit shader, the same
	/// material path and the same uniforms as the character. A prop is a static model with
	/// its own ModelDoc; the clip places it, and the clip's own unit applies to its
	/// position, so the placement goes through the same measurement the bones do.</summary>
	void DrawProps( in Frame f, bool depthOnly )
	{
		if ( Props.Count == 0 ) return;
		var clip = f.Player?.Clip;
		if ( clip is null ) return;
		// Reference props own a model transform; character bone weights must not
		// deform their independent mesh, even when the character itself is skinned.
		_shader.SetInt( _skinned, 0 );
		float positionScale = f.Player!.ClipPositionScale;
		float frame = clip.FrameRate > 0 ? f.Player.Time * clip.FrameRate : 0f;
		foreach ( var prop in Props )
		{
			if ( !prop.Visible ) continue;
			var mesh = prop.Mesh;
			if ( mesh.TriangleCount == 0 ) continue;
			// Upload is a no-op once the mesh is on the GPU, so this stays cheap.
			mesh.Upload( _gl );
			_shader.SetMatrix( _model, prop.WorldMatrix( clip, frame, positionScale, f.Player.RigFromClipModel ) );
			mesh.DrawBatched( _gl, _shader, _albedo, _roughness, _metallic, _emission, _normalY, _uvScale, _uvOffset, _uvRotation, _alphaMode, _alphaCutoff, _baseAlpha, _normalStrength, _ps1Occlusion, _ps1Wear, _ps1WearColor, _ps1Grime, _ps1GrimeFilm, _ps1Glow, _doubleSided, _lobes );
		}
		_shader.SetMatrix( _model, Matrix4x4.Identity );
		_shader.SetInt( _skinned, _liveSkinned );
	}

	/// <summary>Bloom, depth of field, view transform and the single display encode into the
	/// caller's target, then scene depth is copied back for overlays.</summary>
	void PostChain( in Frame f )	{
		int width = f.Width, height = f.Height;
		uint target = f.Target;
		if (_taa.Enabled)
			_motionBlur.RenderVelocity(f.Mesh, width, height, Live.IsEmpty ? null : Live, _frameViewProjection);
		_taa.Resolve(_gl, _bloom.ColorTex, _depthTarget.DepthTexture, _bloom.ColorFbo,
			width, height, _frameViewProjection, f.Mesh.MorphWeights.Count > 0 || Live.HasDynamic
				|| (f.Player is not null && f.Player.MorphWeights.Count > 0),
			_taa.Enabled ? _motionBlur.VelocityTexture : 0, _taa.Enabled ? _motionBlur.VelocityDepthTexture : 0);
		if ( MotionBlurShutter > 0 )
			_motionBlur.Apply( f.Mesh, MotionBlurShutter, _bloom.ColorFbo, _bloom.ColorTex, width, height, f.Camera.Near, f.Camera.Far, Live.IsEmpty ? null : Live );
		_bloom.Process();
		_bloom.StoreHistory();
		// Wave-2 camera wiring: the orbit camera's own focus distance and f-stop (from
		// PartTrackEvaluator.ApplyToOrbitCamera) are the fallback when the renderer's
		// explicit DOF settings are off; explicit settings still win.
		float focus = DepthOfFieldFocusDistance > 0 ? DepthOfFieldFocusDistance
			: f.Camera.FocusDistance > 0 ? f.Camera.FocusDistance : f.Camera.Distance;
		float fstop = DepthOfFieldFStop > 0 ? DepthOfFieldFStop : f.Camera.FStop;
		_bloom.FovDegrees = f.Camera.FovDegrees;
