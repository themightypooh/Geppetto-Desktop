		if ( targetSamples == 0 )
		{
			_gl.BindFramebuffer( FramebufferTarget.ReadFramebuffer, _bloom.ColorFbo );
			_gl.BindFramebuffer( FramebufferTarget.DrawFramebuffer, target );
			_gl.BlitFramebuffer( 0, 0, width, height, 0, 0, width, height,
				ClearBufferMask.DepthBufferBit, BlitFramebufferFilter.Nearest );
			_gl.BindFramebuffer( FramebufferTarget.Framebuffer, target );
		}
	}

	/// <summary>R8: composite volumes into the HDR target in linear light, before TAA/bloom/DoF.
	/// Uses the pre-pass depth and the key shadow map; returns before any GL call when empty.</summary>
	void ApplyVolumes( in Frame f )
	{
		if ( Volumes is null || Volumes.IsEmpty ) return;
		_volume.Apply( Volumes, _bloom.ColorFbo, _depthTarget.DepthTexture, _shadow.Texture, _shadow.ViewProjection,
			_frameViewProjection, f.Camera.Eye, KeyDirection, new Vector3( 1.0f, 0.95f, 0.88f ) * 3.0f, f.Exposure, f.Width, f.Height );
	}

