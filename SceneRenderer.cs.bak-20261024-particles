	/// <summary>Shades the scene into the linear HDR colour target.</summary>
	void LitPass( in Frame f )
	{
		bool multisampled = AntiAliasing == AntiAliasingMode.Msaa4;
		if (multisampled) { _msaa.Ensure(f.Width, f.Height); _gl.Enable(EnableCap.Multisample); }
