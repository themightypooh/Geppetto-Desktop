		_ssaoMap = _shader.Uniform( "uDepthMap" ); _screenSize = _shader.Uniform( "uScreenSize" ); _ssaoRadius = _shader.Uniform( "uSsaoRadius" ); _ssaoStrength = _shader.Uniform( "uSsaoStrength" );
		_envMapUniform = _shader.Uniform( "uEnvMap" ); _envMapIntensity = _shader.Uniform( "uEnvMapIntensity" );
		_screenColor = _shader.Uniform( "uScreenColor" ); _view = _shader.Uniform( "uView" ); _projection = _shader.Uniform( "uProjection" ); _invProjection = _shader.Uniform( "uInvProjection" ); _ssrStrength = _shader.Uniform( "uSsrStrength" ); _aoMapUniform = _shader.Uniform( "uAoMap" );
		_opaqueColor = _shader.Uniform( "uOpaqueColor" );
