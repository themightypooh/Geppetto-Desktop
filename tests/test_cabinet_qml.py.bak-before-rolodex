                                     "operation": "line %d: add Blob name=Body" % rev}) + "\n")
        for rev in (1, 2):                           # a step only counts if its model was kept
            open(os.path.join(run, ".live", "revisions", "%08d.effigy" % rev), "w").write("doc")
        saved = self.host._runs
        self.host.runTimer.stop()
        replayed = []
        self.host.replayRun = lambda directory: replayed.append(directory)
        try:
            self.host._runs = [{"dir": run, "status": "ended", "bench": False}]
            self.host.guideShow()
            self.host.guideTour()
            self.assertEqual(replayed, [run], "the tour replays the finished build's kept steps")
            self.assertFalse(self.host.guide["show"], "and the card gets out of the way")
            self.host._runs = []                     # nothing finished: the tour says so, no crash
            self.host.guideTour()
            self.assertIn("no finished build", self.host.status)
        finally:
            self.host._runs = saved
            del self.host.replayRun
            self.host.runTimer.start()
        self.assertEqual(self.qml_errors(), [])


if __name__ == "__main__":
    unittest.main()
