gmap 1
docid a1b2c3d4
name sealed-room
rollback 2147483647
op add-layer layer-walls
	name Walls
	colour #808080
	visible 1
	compilevisible 1
endop
op add-visgroup vis-all
	name All
	colour #4040FF
	visible 1
	compilevisible 1
endop
op add-brush brush-floor
	name Floor
	layer -
	visgroups -
	face -1 0 0 0 concrete/floor 0 0 1 1 0 16 0
	face 1 0 0 512 concrete/floor 0 0 1 1 0 16 0
	face 0 -1 0 0 concrete/floor 0 0 1 1 0 16 0
	face 0 1 0 512 concrete/floor 0 0 1 1 0 16 0
	face 0 0 -1 0 concrete/floor 0 0 1 1 0 16 0
	face 0 0 1 16 concrete/floor 0 0 1 1 0 16 0
endop
