            PerformanceLifecycleTests.Register( registry, settings );
            LiveIkBufferTests.Register( registry, settings );
            HairStrandTests.Register( registry, settings );
            HdrPipelineTests.Register( registry, settings );
            RenderArchitectureTests.Register( registry, settings );
            TwoSidedShadingTests.Register( registry, settings );
            IblTests.Register( registry, settings );
            ScreenSpaceTests.Register( registry, settings );
            ServiceSurfaceTests.Register( registry, settings );
            RendererImageTests.Register( registry, settings );
            AntiAliasingTests.Register( registry, settings );
            FbxClipConversionTests.Register( registry, settings );
            MaterialChannelGpuTests.Register( registry, settings );
            VmdlReaderTests.Register( registry, settings );
            GpuParticleSystemTests.Register( registry, settings );
            VolumeTests.Register( registry, settings );
            LiveSceneTests.Register( registry, settings );
            SurveyMaterialMapTests.Register( registry, settings );
            ViewportHandleTests.Register( registry, settings );
            ResourceBudgetTests.Register( registry, settings );
            PoseAgreementTests.Register( registry, settings );
