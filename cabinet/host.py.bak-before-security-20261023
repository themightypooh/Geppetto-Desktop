def remember_open(model, clip=""):
    """the model (and clip) on screen, so a restarted chest reopens them"""
    try:
        os.makedirs(os.path.dirname(LAST_OPEN), exist_ok=True)
        with open(LAST_OPEN, "w") as f:
            json.dump({"model": model, "clip": clip}, f)
    except OSError:
        pass

def last_open():
    try:
        with open(LAST_OPEN) as f:
            d = json.load(f)
        if os.path.isfile(d.get("model", "")):
            if d.get("clip") and not os.path.isfile(d["clip"]): d["clip"] = ""
            return d
    except (OSError, ValueError):
        pass
    return None

class Viewport(QQuickPaintedItem):
    """shows the latest frame from the serve process, 1:1; `pane` 1 is the host's viewer, 2-4 the split panes"""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setOpaquePainting(True)
        self._pane = 1
        HOST.frameReady.connect(self.update)
        for pane in HOST.panes:
            pane.frameReady.connect(self._pane_frame)

    def _pane_frame(self):
        if self._pane > 1 and self.sender() is HOST.panes[self._pane - 2]:
            self.update()

    def _set_pane(self, n):
        self._pane = max(1, min(1 + len(HOST.panes), int(n)))
        self.update()
    pane = Property(int, lambda self: self._pane, _set_pane)

    def paint(self, p):
        img = HOST.image if self._pane == 1 else HOST.panes[self._pane - 2].image
        if img is None:
            p.fillRect(0, 0, int(self.width()), int(self.height()), Qt.black)
            return
        p.drawImage(QRect(0, 0, int(self.width()), int(self.height())), img)


