    catalogueBusy = Property(bool, lambda self: self._catalogue_busy, notify=chatChanged)
    replay = Property("QVariantMap", lambda self: self._replay, notify=replayChanged)
    # the guide: pages/examples for the card, the pipeline with each stage's live state for the tape
    def _guide_kwargs(self):
        live = next((r for r in self._runs if r.get("status") == "running" and not r.get("bench")), None)
        return {"live": bool(live), "paused": bool(live and live.get("paused")),
                "replaying": bool(self._replay.get("dir")), "has_runs": bool(self._runs),
                "has_model": bool(self.watching or self._mine), "has_kept": bool(self._filed)}

    def _get_guide(self): return guidelib.guide_map(self._guide, **self._guide_kwargs())
    guide = Property("QVariantMap", _get_guide, notify=guideChanged)
    # the op that made the revision on screen ("line 14: add Blob ..."): the tool wheel's tool, in step with
    # the viewport, whether it follows a run, a replay or your bench
    shownOp = Property(str, lambda self: live_runs.revision_op(self.watching, self.displayed_revision)
                       if self.watching and self.displayed_revision else "", notify=shownOpChanged)
    bench = Property("QVariantMap", lambda self: self._bench, notify=benchChanged)
    researchModels = Property("QVariantList", lambda self: [m for m in self._chat_models if m.get("research", True)], notify=chatChanged)
    # s&box-style sub-selection in the viewport: the latest @selection event, the pick mode and its prompt line
    refs = Property("QVariantMap", lambda self: self._refs, notify=refsChanged)
    face = Property("QVariantMap", lambda self: self._face, notify=faceChanged)
    facePane = Property(int, lambda self: self._face_pane, notify=faceChanged)
    ortho = Property(bool, lambda self: self._ortho, notify=refsChanged)
    subSelection = Property("QVariantMap", lambda self: self._sub_sel, notify=subSelectionChanged)
    subMode = Property(str, lambda self: self._sub_mode, notify=subSelectionChanged)
    subPrompt = Property(str, lambda self: self._sub_prompt, notify=subSelectionChanged)
    panesChanged = Signal()
    paneStickerMade = Signal(int, str, float, float, float, float)   # pane number, then as stickerMade
    paneList = Property("QVariantList", lambda self: list(self.panes), constant=True)
    viewLayout = Property(int, lambda self: self._layout, notify=panesChanged)
    linkCameras = Property(bool, lambda self: self._link, notify=panesChanged)
    autoLayout = Property(bool, lambda self: self._auto, notify=panesChanged)
    soloPane = Property(int, lambda self: self._solo, notify=panesChanged)
    scheme = Property(str, lambda self: self._scheme, notify=schemeChanged)    # the enamel colour scheme
