                                    else { fileTag.naming = true; nameIn.text = ""; nameIn.forceActiveFocus() }
                                }
                            }
                        }
                    }
                    Rectangle {
                        visible: fileTag.naming
                        width: col.width; height: 22; color: "#fbf6e2"; border.color: "#4a3a1c"
