    // ---- a finished model's sticker, peeled off the viewport and filed in the MODELING folder ----
    // the send-off's last frame is the model pressed flat, square on; the host cuts it out (stickerMade)
    // and this lifts it off the glass, flies it over to the tool drawer and slips it in behind the
    // folder's cover, where it goes out of sight
    

    // ---- a pane's menu, dropped from its header (click "PANE n v"): make something in it, put a
    // model in it, how the panes split, clear it. One menu for every pane: it holds which pane it is for
    MouseArea {                                  // a click anywhere else puts it away
        anchors.fill: parent; z: 2400
        visible: paneMenu.open
        onPressed: paneMenu.open = false
    }
    Rectangle {
        id: paneMenu
        objectName: "paneMenu"
        property bool open: false
        property int n: 1
        property var rows: []
        z: 2500
        visible: open
        // what pane n holds now: a run (live or done), a model file, or nothing
        function holds(n) {
            if (n === 1) return { run: host.watchedRun, model: host.myScene ? "your scene" : "" };
            const p = host.paneList[n - 2];
            return p ? { run: p.runDir || "", model: p.modelPath || "" } : { run: "", model: "" };
        }
        property string page: ""                 // "" the four choices, "put" the runs, "panes" the split
        function build() {
            const n = paneMenu.n, h = holds(n), r = [];
            if (page === "put") {
                r.push({ k: "back", t: "< BACK" });
                const runs = host.runs.filter(function (x) { return !x.bench && x.latestRevision > 0 }).slice(0, 8);
                for (const x of runs) {
                    // second line: LIVE/DONE, revision, modeller, date — so a row is
                    // identifiable even if two titles ever collide again; never a bare name
                    const det = [(x.status === "running" ? "LIVE" : "DONE"),
                                 x.latestRevision > 0 ? "REV " + x.latestRevision : "",
                                 x.who || x.modeller || "",
                                 x.started > 0 ? Qt.formatDateTime(new Date(x.started * 1000), "MM-dd hh:mm") : ""]
                                .filter(function (v) { return !!v }).join(" \u00b7 ");
                    r.push({ k: "run", dir: x.dir, live: x.status === "running", on: x.dir === h.run, tall: true,
                             t: x.title || x.name || x.dir.split("/").pop(), d: det });
                }
                if (!runs.length) r.push({ k: "", t: "no runs yet" });
                if (h.run || (n > 1 && h.model)) r.push({ k: "clear", t: "EMPTY PANE — RUN KEEPS GOING" });
            } else if (page === "panes") {
                r.push({ k: "back", t: "< BACK" });
                // notes, not options: head rows are grey and unclickable (see row renderer)
                r.push({ head: "NOTE — STARTUP ALWAYS OPENS 1 PANE" });
                const cur = root.solo ? "only pane " + root.solo : host.autoLayout ? "AUTO" : root.layoutN + (root.layoutN === 1 ? " pane" : " panes");
                r.push({ head: "Current: " + cur });
                r.push(root.solo === n ? { k: "all", t: "SHOW ALL  (now only pane " + n + ")" } : { k: "solo", t: "ONLY THIS ONE" });
                // every choice exists, and the active one says so in words, not just "*"
                r.push({ k: "split0", t: host.autoLayout && !root.solo ? "AUTO  (current)" : "AUTO", on: host.autoLayout && !root.solo });
                r.push({ k: "split1", t: !host.autoLayout && !root.solo && root.layoutN === 1 ? "1 pane  (current)" : "1 pane", on: !host.autoLayout && !root.solo && root.layoutN === 1 });
                r.push({ k: "split2", t: !host.autoLayout && !root.solo && root.layoutN === 2 ? "2 panes  (current)" : "2 panes", on: !host.autoLayout && !root.solo && root.layoutN === 2 });
                r.push({ k: "split4", t: !host.autoLayout && !root.solo && root.layoutN === 4 ? "4 panes  (current)" : "4 panes", on: !host.autoLayout && !root.solo && root.layoutN === 4 });
            } else {
                r.push({ k: "draw", t: "DRAW" });
                r.push({ k: "page:put", t: "PUT A RUN HERE  >" });
                r.push({ k: "page:panes", t: "PANES  >" });
            }
            rows = r;
        }
        // the edit tools work on pane 1: a model picked in another pane is moved there first
        function toPane1() {
            const h = holds(paneMenu.n);
            if (paneMenu.n === 1) return;
            if (h.run) host.showRunIn(h.run, 1); else if (h.model) host.openModel(h.model);
        }
        function act(row) {
            const n = paneMenu.n;
            if (row.k === "back") { page = ""; build(); return }
            if (row.k.indexOf("page:") === 0) { page = row.k.slice(5); build(); return }
            switch (row.k) {
            case "draw": host.openDrawingTool(); break;
            case "face": host.faceOpen(host.facePane === n ? 0 : n); break;
            case "run": if (row.live) host.showRunIn(row.dir, n); else host.replayIn(row.dir, n); break;
            case "myscene": host.setMyScene(!host.myScene); break;
            case "all": host.setViewLayout(0); break;
            case "solo": host.setSolo(n); break;
            case "split0": host.setViewLayout(0); break;
            case "split1": host.setViewLayout(1); break;
            case "split2": host.setViewLayout(2); break;
            case "split4": host.setViewLayout(4); break;
            case "link": host.setLinkCameras(!host.linkCameras); break;
            case "clear": host.clearPane(n); break;
            default: return;
            }
            root.activePane = n;
            paneMenu.open = false;
        }
        // under the header it was dropped from, kept inside the window
        function openFor(n, header) {
            paneMenu.n = n; page = ""; build();
            tools.setOpen(true);
            x = Math.max(4, Math.min(tools.x + 24, root.width - width - 4));
            y = Math.max(4, Math.min(tools.y + 80, root.height - height - 4));
            open = true;
        }
        onOpenChanged: root.maskLater()
        width: 230; height: pmCol.height + 12
        radius: 4; color: "#16191c"; border.color: root.amber
        Column {
            id: pmCol
            x: 6; y: 6; width: paneMenu.width - 12
            Repeater {
                model: paneMenu.rows
                Rectangle {
                    required property var modelData
                    readonly property bool head: !!modelData.head
                    width: pmCol.width; height: head ? 22 : modelData.tall ? 44 : 26; radius: 2
                    color: !head && pmRow.containsMouse && modelData.k ? "#3a2f12" : "transparent"
                    Text {
                        x: parent.head ? 4 : 8
                        anchors.verticalCenter: parent.modelData.tall ? undefined : parent.verticalCenter
                        y: parent.modelData.tall ? 3 : 0
                        width: parent.width - 16; elide: Text.ElideRight
                        text: parent.head ? parent.modelData.head : (parent.modelData.on ? "* " : "  ") + parent.modelData.t
                        color: parent.head ? "#8a8f96" : parent.modelData.on ? root.amber : parent.modelData.k ? root.keyText : "#6b6f75"
                        font.family: root.mono; font.bold: true; font.pixelSize: parent.head ? 10 : 12
                    }
                    Text {
                        visible: !parent.head && !!parent.modelData.d
                        x: parent.modelData.tall ? 8 : 164
                        width: parent.modelData.tall ? parent.width - 16 : parent.width - x - 6
                        anchors.verticalCenter: parent.modelData.tall ? undefined : parent.verticalCenter
                        y: parent.modelData.tall ? parent.height - 17 : 0; elide: Text.ElideRight
                        text: parent.modelData.d || ""; color: "#8a8f96"; font.family: root.mono; font.pixelSize: 11
                    }
                    Rectangle { visible: parent.head; x: 4; y: 0; width: parent.width - 8; height: 1; color: "#3a3f45" }
                    MouseArea {
                        id: pmRow; anchors.fill: parent; enabled: !parent.head
                        hoverEnabled: true; cursorShape: parent.modelData.k ? Qt.PointingHandCursor : Qt.ArrowCursor
                        onClicked: paneMenu.act(parent.modelData)
                    }
                }
            }
        }
    }

    // ---- a run card being dragged onto a viewport pane
    Item {
        id: runDrag
        objectName: "runDrag"
        z: 3000
        property var run: null
        property var filed: null                // a slip out of the MODELING folder: {entry, index}
        property int over: 0
        property point at: Qt.point(0, 0)      // the window point it was last over
        visible: !!runDrag.run || !!runDrag.filed
        width: dragTag.implicitWidth + 16; height: 24
        function begin(r) { run = r; filed = null; over = 0 }
        function beginSlip(e, i) { filed = { entry: e, index: i }; run = null; over = 0 }
        function moveTo(p) {
            x = p.x + 12; y = p.y + 8; at = Qt.point(p.x, p.y);
            const n = root.paneAt(p.x, p.y), s = runDrag.filed;
            over = s && s.entry.kind === "model" && n > 1 ? 0 : n;   // a model only goes into pane 1's scene
            if (runDrag.run && !(runDrag.run.latestRevision > 0)) over = 0;   // nothing built yet: no pane to show it in
        }
        function cancel() { run = null; filed = null; over = 0 }
        function finish() {
            const r = runDrag.run, s = runDrag.filed, n = over;
            cancel();
            if ((!r && !s) || !n) return false;
            root.activePane = n;
            if (s) {
                // pane 1: into the scene there, standing where it was let go; a run in 2-4 replays there
                if (n === 1) {
                    const v = viewMouse.mapFromItem(root.contentItem, at.x, at.y);
                    landing.drop(at.x, at.y, s.entry.name || "");
                    host.placeFiled(s.index, v.x, v.y);
                }
                else host.replayIn(s.entry.path, n);
            } else if (r.status === "running") host.showRunIn(r.dir, n); else host.replayIn(r.dir, n);
            return true;
        }
        Rectangle { anchors.fill: parent; radius: 3; color: "#16191c"; border.color: root.amber; opacity: 0.92 }
        Text {
            id: dragTag; anchors.centerIn: parent
            text: (runDrag.run ? (runDrag.run.prompt || runDrag.run.name || "").slice(0, 32)
                   : runDrag.filed ? (runDrag.filed.entry.name || "").slice(0, 32) : "")
                  + (runDrag.over ? (runDrag.filed && runDrag.over === 1 ? "  -> INTO THE SCENE" : "  -> PANE " + runDrag.over)
                                  : "  (drop on " + (runDrag.filed && runDrag.filed.entry.kind === "model" ? "pane 1)" : "a pane)"))
            color: runDrag.over ? root.amber : root.keyText; font.family: root.mono; font.pixelSize: 11
        }
    }

    // ---- a slip let go into the scene: the tag shrinks into the spot, a ring pulses there while it lands
    Item {
        id: landing
        z: 2999
        visible: false
        property string label: ""
        property real since: 0
        function drop(px, py, name) { x = px; y = py; label = name; since = Date.now(); fade.stop(); land.restart() }
        function landed() { if (!land.running) return; land.stop(); fade.restart() }
        // pulse until the bench has it in (a big model takes a few seconds), then fade
        Connections {
            target: host
            function onBenchChanged() { if (landing.visible && !host.bench.busy && Date.now() - landing.since > 400) landing.landed() }
        }
        Timer { running: land.running; interval: 30000; onTriggered: landing.landed() }
        Rectangle {
            id: landRing
            width: 56; height: 56; radius: 28; x: -28; y: -28
            color: "transparent"; border.color: root.amber; border.width: 2
        }
        Rectangle {
            id: landDot
            width: 8; height: 8; radius: 4; x: -4; y: -4; color: root.amber
        }
        Rectangle {
            id: landTag
            x: 12; y: 8; height: 24; width: landText.implicitWidth + 16; radius: 3
            color: "#16191c"; border.color: root.amber
            transformOrigin: Item.TopLeft
            Text { id: landText; anchors.centerIn: parent; text: landing.label + "  -> INTO THE SCENE"
                   color: root.amber; font.family: root.mono; font.pixelSize: 11 }
        }
        SequentialAnimation {
            id: land
            ScriptAction { script: { landing.visible = true; landing.opacity = 1; landTag.scale = 1; landTag.opacity = 0.92
                                     landTag.x = 12; landTag.y = 8; landRing.scale = 0.2; landRing.opacity = 1 } }
            ParallelAnimation {        // the tag tucks itself into the drop point
                NumberAnimation { target: landTag; property: "scale"; to: 0.15; duration: 260; easing.type: Easing.InCubic }
                NumberAnimation { target: landTag; property: "x"; to: 0; duration: 260; easing.type: Easing.InCubic }
                NumberAnimation { target: landTag; property: "y"; to: 0; duration: 260; easing.type: Easing.InCubic }
                NumberAnimation { target: landTag; property: "opacity"; to: 0; duration: 260 }
            }
            SequentialAnimation {      // ripples while the model comes in
                loops: Animation.Infinite
                ParallelAnimation {
                    NumberAnimation { target: landRing; property: "scale"; from: 0.2; to: 1.3; duration: 520; easing.type: Easing.OutCubic }
                    NumberAnimation { target: landRing; property: "opacity"; from: 1; to: 0; duration: 520; easing.type: Easing.OutQuad }
                }
            }
        }
        SequentialAnimation {
            id: fade
            NumberAnimation { target: landing; property: "opacity"; to: 0; duration: 220 }
            ScriptAction { script: landing.visible = false }
        }
    }

