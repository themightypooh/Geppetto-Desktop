// Geppetto's tool chest: one frameless, transparent, normal window on the real desktop.
// The 3D viewport (streamed from `marionette-desktop --serve` by host.py) sits behind the chrome
// bezel of a red enamelled steel chest, under a lid that is the title bar (drag it to move the
// window; the black buttons shut the drawers, minimise, close). Three drawers run out on
// ball-bearing slides onto the desktop: Research (left), Outliner (right), Timeline (bottom).
// Grab a drawer by its chrome bar pull and drag it out by hand, or click its label plate.
// All art is baked by bake.py (art/*.png, art/geom.js) and shown 1:1 with no smoothing.
// Only the chest, the lid and the drawers take the mouse; host.setMask() makes the rest of the
// window click-through.
import QtQuick
import QtQuick.Window
import QtQuick.Controls as C
import QtQuick.Dialogs as D
import Geppetto 1.0
import "art/geom.js" as Geom
import "art/schemes/schemes.js" as Schemes

Window {
    id: root
    readonly property var g0: Geom.G
    readonly property string art: Qt.resolvedUrl("art/")
    // the chest's enamel colour scheme (host.scheme, saved with the view prefs): the enamel pieces
    // (frame, lid bar, drawers, model folder) come from art/schemes/<name>/, everything else is shared
    readonly property string scheme: host.scheme || "red"
    readonly property var schemeInk: Schemes.INK
    function enamel(name) { return scheme === "red" ? art + name : art + "schemes/" + scheme + "/" + name }

    // ---- palette for the non-baked bits (text) -------------------------------------------
    readonly property color ink: "#1d2318"
    readonly property color inkRed: (schemeInk && schemeInk[scheme]) ? schemeInk[scheme] : "#b3261c"
    readonly property color inkFaint: "#424a3c"
    readonly property color panelFill: "#f4f7ee"
    readonly property color sheetEdge: "#5d6655"
    readonly property color tapeText: "#eef0ea"
    readonly property color keyText: "#c9ccd0"
    readonly property color amber: "#f2a91c"
    readonly property color selFill: "#f2a91c"
    readonly property string mono: "DejaVu Sans Mono"

    // ---- layout (screen px) --------------------------------------------------------------
    readonly property int tuck: 24          // how much of an open drawer stays behind the chest
    readonly property int peek: 6           // how much of a shut drawer's front shows
    readonly property int sideDrawerW: root.g0.research.bodyW
    readonly property int cabX: sideDrawerW - tuck + root.g0.pull + 4
    readonly property int barOver: 10       // the lid overlaps the top of the chest
    readonly property int cabY: root.g0.bar.barH - barOver
    readonly property int frameW: root.g0.frame.frameW
    readonly property int frameH: root.g0.frame.frameH

    title: "Geppetto"
    visible: true
    color: "transparent"
    flags: Qt.Window | Qt.FramelessWindowHint
    width: cabX * 2 + frameW + root.g0.shadow
    height: cabY + frameH - tuck + root.g0.timeline.bodyH + root.g0.pull + root.g0.shadow + 4

    // ---- viewport state (the serve process is the truth; these are what we last asked for) --
    property bool showBones: true
    property bool showGrid: true
    property int wire: 0
    readonly property var info: host.info
    property bool spinning: false             // turntable
    property bool followFrame: false          // live: camera stays put across revisions; TRACK turns re-framing back on
    property bool refsOpen: false             // the reference pictures panel over the camera keys
    property bool claudeOpen: false           // the CLAUDE card: talk to Claude Code from here (Ctrl+L)
    property int claudeOpenPane: 0          // TALK fix 2026-10-24: which pane opened chat (0 = global opener, use pane 1)
    onClaudeOpenChanged: { if (claudeOpen) { host.refreshChat(); root.activePane = root.claudeOpenPane > 0 ? root.claudeOpenPane : 1; root.claudeOpenPane = 0 } }   // chat auto-opens with one panel selected, pane 1 unless a pane TALK opened it
    Shortcut { sequence: "Ctrl+L"; context: Qt.ApplicationShortcut; onActivated: { root.claudeOpen = !root.claudeOpen; if (root.claudeOpen) claudePanel.focusInput() } }
    // the run the controls work: the one being watched if it is building, else any that is
    readonly property var liveRun: {
        var any = null;
        for (const r of host.runs) if (r.status === "running" && !r.bench) { if (r.dir === host.watchedRun) return r; any = any || r; }
        return any;
    }
    readonly property string liveDir: liveRun ? liveRun.dir : ""
    // ---- the split viewport: 1, 2 (side by side) or 4 (quad) panes; pane 1 is the main viewer
    // (bench, refs, picking), 2-4 each show one more run with their own camera and controls
    readonly property int layoutN: host.viewLayout
    readonly property int solo: host.soloPane      // 1 pane, po's pick: only that pane shows, full size
    property int activePane: 1                // the pane VIEW NOW / WATCH put a run in: last one clicked
    onLayoutNChanged: if (activePane > layoutN) activePane = 1
    onSoloChanged: if (solo >= 1 && solo <= 4) activePane = solo   // programmatic setSolo must not leave TALK/header pointing at a hidden pane
    readonly property int paneGap: 1          // a hairline seam: the panes butt up, no gutter between them
    function paneRect(n) {                    // pane n's place inside the viewport frame
        const W = root.g0.view.w, H = root.g0.view.h, g = root.paneGap;
        if (layoutN <= 1 || n > layoutN || solo) return { x: 0, y: 0, w: W, h: H };
        const w = Math.floor((W - g) / 2), c = (n - 1) % 2;
        if (layoutN === 2) return { x: c * (w + g), y: 0, w: c ? W - w - g : w, h: H };
        const h = Math.floor((H - g) / 2), rw = n > 2 ? 1 : 0;
        return { x: c * (w + g), y: rw * (h + g), w: c ? W - w - g : w, h: rw ? H - h - g : h };
    }
    function paneAt(gx, gy) {                 // which pane is under a window point (0: none)
        if (solo) return solo;
        for (let n = 1; n <= layoutN; n++) {
            const r = paneRect(n), x = cabX + g0.view.x + r.x, y = cabY + g0.view.y + r.y;
            if (gx >= x && gx < x + r.w && gy >= y && gy < y + r.h) return n;
        }
        return 0;
    }
    // a camera move in pane n, from a key or a command; with LINK CAMS on, every pane on
    // screen turns with it. The mouse never comes through here: a drag or the wheel is in
    // one pane, so it moves that pane only (paneCmd below, LINK CAMS or not)
    function camCmd(n, line) {
        if (host.linkCameras && layoutN > 1) host.camAll(line);
        else if (n <= 1) host.cmd(line);
        else host.paneList[n - 2].cmd(line);
    }
    // a VIEWPORTS "1: Pn" row: what that pane has in it, so po knows which one to pick
    function soloWho(n) {
        const own = n === 1 ? host.p1Owner : (host.paneList[n - 2] ? host.paneList[n - 2].owner : null);
        const run = n === 1 ? host.watchedRun : (host.paneList[n - 2] ? host.paneList[n - 2].runDir : "");
        const model = n === 1 ? (host.myScene ? "your scene" : "") : (host.paneList[n - 2] ? host.paneList[n - 2].modelPath || "" : "");
        const what = own && own.title ? own.title : run ? host.runScript(run) : model ? model.split("/").pop() : "";
        return "only pane " + n + (what ? ": " + what : n > layoutN ? " (hidden now)" : ": empty");
    }
    function runOf(dir) { if (!dir) return null; for (const r of host.runs) if (r.dir === dir) return r; return null }
    // pane 1's own live run, for its HOLD/STOP when the view is split
    readonly property var p1Run: { const r = runOf(host.watchedRun); return r && r.status === "running" && !r.bench ? r : null }
    // a run starts building: pull the tool drawer out, its LIVE BUILD keys pop up on their own
    onLiveDirChanged: if (liveDir !== "") tools.setOpen(true)
    readonly property var clip: host.clip
    readonly property var ph: host.playhead
    readonly property bool ready: info.shm !== undefined
    onReadyChanged: if (ready) {
        host.cmd("bones " + (showBones ? 1 : 0));
        host.cmd("grid " + (showGrid ? 1 : 0));
        host.cmd("wire " + wire);
        host.cmd("spin " + (spinning ? 30 : 0));
        host.cmd("autoframe " + (followFrame ? 1 : 0));
    }

    // a picture of the whole chest for checks: grabToImage renders off to the side, so it never stalls the window
    function snapTo(path) { root.contentItem.grabToImage(function (r) { r.saveToFile(path) }) }
    function row(label, val) {
        var s = String(label);
        while (s.length < 10) s += " ";
        return s + (val === undefined || val === null || val === "" ? "-" : val);
    }

    // ---- the chat window --------------------------------------------------------------------
    function sendChat(input) {
        var t = String(input.text).trim();
        if ((t === "" && host.chatImages.length === 0) || host.chatBusy) return;
        host.sendChat(t);
        input.text = "";
    }
    // the chat and the research can each pop out of the drawer into a window of their own
    property bool chatOut: false
    onChatOutChanged: if (chatOut) host.refreshChat()
    property bool paperOpen: false            // the paper ball, open: the research column and the live run, written on it
    onPaperOpenChanged: if (paperOpen) host.refreshChat()
    property bool researchOut: false
    // the build note: a run's watch written out on paper, tossed from its run bar's NOTE key
    property string buildNoteDir: ""
    property int buildNotePane: 1
    property point buildNoteFrom: Qt.point(0, 0)
    function toggleBuildNote(dir, n, key) {
        if (buildNoteDir === dir) { buildNoteDir = ""; return }
        buildNoteFrom = key ? key.mapToItem(root.contentItem, key.width / 2, key.height / 2) : Qt.point(cabX, cabY)
        buildNotePane = n; buildNoteDir = dir;
    }
    property bool blinkOn: true
    property string keyTip: ""                // the hovered key's tip
    Timer { interval: 300; repeat: true; running: true; onTriggered: root.blinkOn = !root.blinkOn }

    // ---- click-through: only the solid parts take the mouse ------------------------------
    function updateMask() {
        var r = [bar.x, bar.y, root.g0.bar.barW, root.g0.bar.barH, cabX, cabY, frameW, frameH];
        [research, tools, timeline].forEach(function (d) {
            r.push(d.x + d.hitX, d.y + d.hitY, d.hitW, d.hitH);
        });
        if (openNote.visible) r.push(openNote.x, openNote.y, openNote.width, openNote.height);
        if (buildNote.visible) r.push(buildNote.x, buildNote.y, buildNote.width, buildNote.height);
        if (paneMenu.open) r.push(paneMenu.x, paneMenu.y, paneMenu.width, paneMenu.height);
        host.setMask(r);
    }
    function maskLater() { Qt.callLater(updateMask) }
    Component.onCompleted: maskLater()

    // =====================================================================================
    // pieces
    // =====================================================================================

    // Render labels at their final size: tiny raster layers clip glyphs and lose strokes.
    component Px: Item {
        id: px
        property string text: ""
        property color color: root.ink
        property int size: 8                 // art px
        property bool bold: true
        property real maxWidth: 0            // screen px; 0 = one line, no wrap
        property int maxLines: 100
        property real lineH: 9               // art px per line (the sheet is ruled every 9)
        width: maxWidth > 0 ? maxWidth : lbl.implicitWidth
        height: lbl.height
        Text {
                id: lbl
                text: px.text
                color: px.color
                font.family: root.mono
                font.pixelSize: Math.max(14, px.size * 2)
                font.bold: px.bold
                font.hintingPreference: Font.PreferFullHinting
                renderType: Text.QtRendering
                antialiasing: true
                width: px.maxWidth > 0 ? px.maxWidth : implicitWidth
                wrapMode: px.maxWidth > 0 ? Text.Wrap : Text.NoWrap
                maximumLineCount: px.maxLines
                elide: Text.ElideRight
                lineHeightMode: Text.FixedHeight
                lineHeight: Math.max(font.pixelSize + 4, px.lineH * 2)
        }
    }

    // Both selectors use the same catalogue. The popup is parented to the drawer
    // floor, and clamped there, so even a long list cannot escape onto the viewport.
    component ModelSelect: C.ComboBox {
        id: select
        property string selectedId: ""
        property Item popupParent: research.floorItem    // in a popped-out window: that window
        signal picked(string modelId)
        Component.onCompleted: { popup.objectName = objectName + "Popup" }
        textRole: "label"
        valueRole: "id"
        height: 30
        enabled: count > 0
        currentIndex: {
            for (var i = 0; i < count; ++i)
                if (model[i].id === selectedId) return i;
            return -1;
        }
        onActivated: picked(currentValue)
        contentItem: Text {
            text: select.currentIndex < 0 ? (host.catalogueBusy ? "Finding models…" : "No models available") : select.currentText
            color: root.ink; font.family: root.mono; font.pixelSize: 14
            verticalAlignment: Text.AlignVCenter
            elide: Text.ElideMiddle
            leftPadding: 6; rightPadding: 20
        }
        indicator: Text {
            x: select.width - 18; y: 6
            text: "▾"; color: root.ink; font.pixelSize: 15
        }
        background: Rectangle {
            color: "#f4f7ee"; border.width: 2
            border.color: select.activeFocus ? root.amber : root.sheetEdge
        }
        delegate: C.ItemDelegate {
            required property var modelData
            required property int index
            width: select.popup.width - 4; height: 44
            enabled: modelData.available !== false
            highlighted: select.highlightedIndex === index
            contentItem: Text {
                text: modelData.label
                color: parent.enabled ? root.ink : root.inkFaint
                font.family: root.mono; font.pixelSize: 14
                wrapMode: Text.Wrap; maximumLineCount: 2; elide: Text.ElideRight
                verticalAlignment: Text.AlignVCenter
            }
            background: Rectangle { color: parent.highlighted ? root.amber : "#f4f7ee" }
        }
        popup: C.Popup {
            objectName: select.objectName + "Popup"
            parent: select.popupParent
            x: Math.max(2, Math.min(parent.width - width - 2, select.mapToItem(parent, 0, 0).x))
            y: {
                var below = select.mapToItem(parent, 0, select.height).y;
                return Math.max(2, Math.min(parent.height - height - 2, below));
            }
            width: Math.min(select.popupParent.width - 12, Math.max(select.width, 240))
            height: Math.min(select.popupParent.height > 600 ? 400 : 164, contentItem.implicitHeight + 4)
            padding: 2
            closePolicy: C.Popup.CloseOnEscape | C.Popup.CloseOnPressOutside
            contentItem: ListView {
                implicitHeight: contentHeight
                clip: true
                model: select.popup.visible ? select.delegateModel : null
                currentIndex: select.highlightedIndex
                boundsBehavior: Flickable.StopAtBounds
                C.ScrollIndicator.vertical: C.ScrollIndicator {}
            }
            background: Rectangle { color: "#f4f7ee"; border.width: 2; border.color: root.sheetEdge }
        }
    }

    // dithered drop shadow (a 50% checker of near-black)
    component Shade: Image {
        source: root.art + "shadow.png"
        fillMode: Image.Tile
        smooth: false
    }

    // a strip of embossed Dymo tape with white letters
    component Tape: Item {
        id: tp
        property string text: ""
        width: tl.width + 20; height: 24
        Image { anchors.fill: parent; source: root.art + "dymo.png"; fillMode: Image.Tile; smooth: false }
        Px { id: tl; x: 10; y: 4; text: tp.text; color: root.tapeText }
    }

    // ---- the chat window: talk to the local and the hosted models.
    // It never grows: the transcript scrolls inside a fixed window.
    component ChatPanel: Item {
        id: chatBox
        property string tag: "chat"           // objectName prefix: chatBox, chatLog, ...
        property bool popped: false           // true in its own window
        property bool bare: false             // on the unrolled scroll: no sheet, tape or POP OUT of its own
        property Item popupParent: research.floorItem
        property bool closable: false         // a close key in its top right corner
        signal closed()
        readonly property real headH: closable ? 40 : 26
        readonly property int picStrip: host.chatImages.length > 0 ? 40 : 0
        readonly property alias selector: chatSelector
        objectName: tag + "Box"
        Shade { visible: !chatBox.bare; x: 6; y: 6; width: chatBox.width; height: chatBox.height }
        Rectangle { visible: !chatBox.bare; anchors.fill: parent; color: root.sheetEdge }
        Rectangle { visible: !chatBox.bare; anchors.fill: parent; anchors.margins: 2; color: root.panelFill }
        Tape {
            visible: !chatBox.bare
            x: 6; y: -6
            text: "CHAT · " + (host.chatMode ? host.chatMode.toUpperCase() : "BUILD")
            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: host.toggleChatMode()
            }
        }
        // mode toggle button
        Px {
            x: parent.width - (chatBox.closable ? 146 : 94); y: chatBox.closable ? 8 : 4
            text: host.chatMode === "plan" ? "[PLAN]" : "[BUILD]"
            size: 6
            color: host.chatMode === "plan" ? "#c8452f" : "#2f9a6a"
            MouseArea {
                anchors.fill: parent; anchors.margins: -4
                cursorShape: Qt.PointingHandCursor
                onClicked: host.toggleChatMode()
            }
        }
        // out into a window of its own, or back into the drawer
        Px {
            visible: !chatBox.bare
            x: parent.width - 116; y: 4
            text: chatBox.popped ? "DOCK" : "POP OUT"; size: 6
            color: root.inkFaint
            MouseArea {
                anchors.fill: parent; anchors.margins: -4
                cursorShape: Qt.PointingHandCursor
                onClicked: root.chatOut = !chatBox.popped
            }
        }
        Key {
            objectName: chatBox.tag + "Close"
            visible: chatBox.closable
            small: true; label: "X"
            x: parent.width - width + 4; y: -4
            onClicked: chatBox.closed()
        }
        // clear the transcript
        Px {
            x: parent.width - (chatBox.closable ? 100 : 46); y: chatBox.closable ? 8 : 4
            text: "CLEAR"; size: 6
            color: root.inkFaint
            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: host.clearChat()
            }
        }
        // the transcript: a fixed window over the sheet, scrolled to the newest line
        Flickable {
            id: chatLog
            objectName: chatBox.tag + "Log"
            x: 8; y: chatBox.headH
            width: parent.width - 16
            height: parent.height - 100 - chatBox.headH - chatBox.picStrip
            contentHeight: chatLines.height
            boundsBehavior: Flickable.StopAtBounds
            clip: true
            onContentHeightChanged: contentY = Math.max(0, contentHeight - height)
            Column {
                id: chatLines
                width: chatLog.width
                spacing: 4
                Repeater {
                    model: host.chatMessages
                    delegate: Column {
                        id: line
                        required property var modelData
                        width: chatLines.width
                        spacing: 2
                        Row {
                            spacing: 3
                            visible: (line.modelData.images || []).length > 0
                            Repeater {
                                model: line.modelData.images || []
                                delegate: Image {
                                    required property string modelData
                                    width: 72; height: 48
                                    fillMode: Image.PreserveAspectCrop
                                    source: modelData ? "file://" + modelData : ""
                                    sourceSize.width: 144; asynchronous: true; cache: false
                                }
                            }
                        }
                        TextEdit {
                            width: line.width
                            text: (line.modelData.role === "you" ? "you: " : line.modelData.role === "error" ? "! " : "") + line.modelData.text
                            readOnly: true; selectByMouse: true
                            wrapMode: TextEdit.Wrap; textFormat: TextEdit.PlainText
                            font.family: root.mono; font.pixelSize: chatBox.popped ? 16 : 15
                            color: line.modelData.role === "error" ? root.inkRed
                                 : line.modelData.role === "you" ? root.ink : root.inkFaint
                        }
                    }
                }
            }
        }
        // pictures waiting to go with the next message; click one to take it off
        Row {
            x: 8; y: parent.height - 94 - chatBox.picStrip
            spacing: 3; visible: chatBox.picStrip > 0
            Repeater {
                model: host.chatImages
                delegate: Rectangle {
                    required property string modelData
                    required property int index
                    width: 48; height: 36; color: root.sheetEdge
                    Image {
                        anchors.fill: parent; anchors.margins: 1
                        source: modelData ? "file://" + modelData : ""
                        fillMode: Image.PreserveAspectCrop
                        sourceSize.width: 96; asynchronous: true; cache: false
                    }
                    MouseArea {
                        anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                        onClicked: host.removeChatImage(index)
                    }
                }
            }
        }
        D.FileDialog {
            id: chatPic
            title: "Picture for the chat"
            nameFilters: ["Pictures (*.png *.jpg *.jpeg *.webp *.gif)", "All files (*)"]
            onAccepted: host.attachChatImage(selectedFile.toString())
        }
        DropArea {
            anchors.fill: parent
            onDropped: function(drop) {
                for (var i = 0; i < drop.urls.length; i++)
                    host.attachChatImage(drop.urls[i].toString());
            }
            Rectangle {
                anchors.fill: parent; visible: parent.containsDrag
                color: "#66f2a91c"; border.width: 2; border.color: root.amber
            }
        }
        // what you type, and the key that sends it
        Rectangle {
            x: 8; y: parent.height - 94
            width: parent.width - 16 - 88; height: 30
            color: "#f4f7ee"; border.width: 2; border.color: root.sheetEdge
            TextInput {
                id: chatInput
                objectName: chatBox.tag + "Input"
                anchors.fill: parent; anchors.margins: 5; anchors.rightMargin: 36
                color: root.ink; clip: true; maximumLength: 8000
                font.family: root.mono; font.pixelSize: 13; font.bold: true
                renderType: Text.NativeRendering
                onAccepted: root.sendChat(chatInput)
                Keys.onPressed: function(e) {
                    if ((e.modifiers & Qt.ControlModifier) && e.key === Qt.Key_V && host.pasteChatImage())
                        e.accepted = true;
                }
            }
            Px {
                anchors.right: parent.right; anchors.rightMargin: 4; anchors.verticalCenter: parent.verticalCenter
                text: "PIC"; size: 6; color: root.ink
                MouseArea {
                    anchors.fill: parent; anchors.margins: -4
                    cursorShape: Qt.PointingHandCursor
                    onClicked: chatPic.open()
                }
            }
            Px {
                x: 6; y: 6
                visible: chatInput.text === "" && !chatInput.activeFocus
                text: "say something..."; size: 6
                maxWidth: parent.width - 12; maxLines: 1
                color: root.inkFaint
            }
        }
        Key {
            x: parent.width - 92; y: parent.height - 97
            label: host.chatBusy ? "STOP" : "SEND"; lamp: true; lit: (chatInput.text.trim() !== "" || host.chatImages.length > 0) && !host.chatBusy
            onClicked: host.chatBusy ? host.stopChat() : root.sendChat(chatInput)
        }
        Px { x: 8; y: parent.height - 60; visible: host.chatBusy; text: "replying…"; size: 6; color: root.inkFaint }

        ModelSelect {
            id: chatSelector
            objectName: chatBox.tag + "Selector"
            popupParent: chatBox.popupParent
            x: 8; y: parent.height - 38; width: parent.width - 16
            model: host.chatModels; selectedId: host.chatModel
            enabled: count > 0 && !host.chatBusy
            onPicked: function(modelId) { host.setChatModel(modelId) }
        }
    }

    // a new run: a prompt, which local model, and go; then the runs so far
    component ResearchPanel: Column {
        id: rp
        property string tag: ""               // objectName prefix; "" in the drawer
        property bool popped: false
        property Item popupParent: research.floorItem
        readonly property alias selector: researchSelector
        spacing: 18
        function bookHash(dir) { let h = 7; for (let i = 0; i < dir.length; i++) h = (h * 31 + dir.charCodeAt(i)) | 0; return Math.abs(h) }
        // which of the baked books each run is: stable per run, never the same as the one beside it
        readonly property var bookIds: {
            const n = root.g0.books ? root.g0.books.length : 1, ids = [];
            for (const r of host.runs) { let b = rp.bookHash(r.dir) % n; if (ids.length && ids[ids.length - 1] === b) b = (b + 1) % n; ids.push(b) }
            return ids
        }
        // a made-up title for the spine, from what the run was asked to make
        function bookTitle(r) {
            if (r.spine) return String(r.spine).toUpperCase()      // lettered by you (right-click the book)
            const skip = ["a", "an", "the", "of", "with", "and", "make", "model", "create", "me", "please", "for", "in", "on",
                          "to", "low", "poly", "simple", "some", "that", "is", "it", "my", "detailed", "realistic", "3d"];
            const said = String(r.title || r.prompt || r.name).toLowerCase().replace(/^script:\s*/, "").replace(/\.(txt|effigy|py)\b/g, "");
            const words = said.replace(/[^a-z ]/g, " ").split(/ +/).filter(w => w.length > 1 && skip.indexOf(w) < 0);
            const noun = (words.slice(-2).join(" ") || "nothing").toUpperCase();
            const forms = ["THE BOOK OF %", "ON %", "A TREATISE ON %", "%, VOL. II", "NOTES ON %", "THE %",
                           "% & OTHERS", "A HISTORY OF %", "COLLECTED %", "THE LAST %", "% ILLUSTRATED", "UPON %"];
            return forms[rp.bookHash(r.dir + "t") % forms.length].replace("%", noun)
        }
        // every run building right now: first thing in the drawer, loud, one row each: who is on it,
        // what they asked for, the step it is on, and the keys. Each row is a fixed height, every line
        // one elided line, so a long prompt or a long step never spills out of the box.
        
        // the next run is a blank book lying open on the pile. You letter the page, the model is
        // the stamp in the margin, and START slams the cover: the gilt title is already on the spine,
        // and the run lands in the pile as a closed book. The same pale volume then falls open again.
        Item {
            id: newRun
            objectName: rp.tag === "" ? "newRun" : rp.tag + "NewRun"
            z: 1                                       // its eraser lies over the top book
            readonly property int grow: rp.popped ? 120 : 0     // the page gets room in its own window
            readonly property var spineG: (root.g0.books && root.g0.books.length > 4) ? root.g0.books[4] : ({ "w": 244, "h": 58, "labelX": 56, "labelY": 8, "labelW": 128, "labelH": 38 })
            readonly property int spineH: spineG.h
            readonly property int pageFull: 72 + grow
            readonly property int spreadFull: pageFull + 78     // the page, the stamp, then the key
            property real slam: 0                               // 0 open, 1 the cover has shut on the spine
            readonly property int shownH: Math.max(0, Math.round(spreadFull * (1 - slam)))
            readonly property bool photoSpine: Math.abs(width - spineG.w) < 30
            width: parent.width; height: 18 + shownH + spineH
            function shut() {
                if (slamAnim.running) return
                if (host.startResearch(promptBox.text)) slamAnim.start()
            }
            SequentialAnimation {
                id: slamAnim
                NumberAnimation { target: newRun; property: "slam"; to: 1; duration: 170; easing.type: Easing.InQuad }
                ScriptAction { script: promptBox.text = "" }
                PauseAnimation { duration: 80 }
                NumberAnimation { target: newRun; property: "slam"; to: 0; duration: 220; easing.type: Easing.OutCubic }
            }
            Shade { x: 4; y: 4; width: newRun.width; height: newRun.height }
            Rectangle { anchors.fill: parent; color: "#cbb892" }                          // the pale cloth, same volume as the blank spine
            Rectangle { anchors.fill: parent; color: "transparent"; border.width: 3; border.color: "#8d7348" }
            Px {
                x: parent.width - 70; y: 2; z: 2
                visible: newRun.slam < 0.15
                text: rp.popped ? "DOCK" : "POP OUT"; size: 6
                color: "#6a3a28"
                MouseArea {
                    anchors.fill: parent; anchors.margins: -4
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        var opening = !rp.popped;
                        root.researchOut = opening;
                        if (opening) root.paperOpen = false;   // the window takes it; the paper crumples
                    }
                }
            }
            Item {                                         // the open page: the cover eats it from the spine up
                id: spread
                x: 8; y: 18; z: 1
                width: parent.width - 16; height: newRun.shownH
                clip: true
                Rectangle {
                    width: spread.width; height: newRun.pageFull
                    color: "#f4efe2"
                    Repeater {
                        model: Math.max(0, Math.floor((newRun.pageFull - 8) / 16))
                        Rectangle { y: 20 + index * 16; x: 6; width: spread.width - 12; height: 1; color: "#e3d5b8" }
                    }
                    TextEdit {
                        id: promptBox
                        anchors.fill: parent; anchors.margins: 8; anchors.topMargin: 4
                        color: root.ink
                        enabled: newRun.slam === 0
                        font.family: root.mono; font.pixelSize: 14; font.bold: true
                        renderType: Text.NativeRendering
                        wrapMode: TextEdit.Wrap
                        clip: true
                    }
                    Px {
                        x: 8; y: 6; visible: promptBox.text === "" && !promptBox.activeFocus
                        text: "describe an asset..."; color: root.inkFaint
                    }
                }
                ModelSelect {
                    id: researchSelector
                    objectName: rp.tag === "" ? "researchSelector" : rp.tag + "Selector"
                    popupParent: rp.popupParent
                    x: 0; y: newRun.pageFull + 6; width: spread.width
                    model: host.researchModels; selectedId: host.aiModel
                    onPicked: function(modelId) { host.setAiModel(modelId) }
                }
                Text {
                    x: 2; y: newRun.pageFull + 48; width: spread.width - 90
                    text: host.catalogueBusy ? "Finding…" : "↻ Models"
                    color: root.ink; font.family: root.mono; font.pixelSize: 14
                    MouseArea { anchors.fill: parent; onClicked: host.refreshChat() }
                }
                Key {
                    x: spread.width - 84; y: newRun.pageFull + 42
                    label: "START"; lamp: true; lit: promptBox.text.trim() !== "" && host.aiModel !== "" && newRun.slam === 0
                    tip: "slam the cover: this becomes the next book"
                    onClicked: newRun.shut()
                }
            }
            Rectangle {                                    // the cover's leading edge, gilt, as it shuts
                visible: newRun.slam > 0.04 && newRun.slam < 1
                x: 3; y: 18 + newRun.shownH - 2; z: 2
                width: parent.width - 6; height: 2
                color: "#f0d68a"
            }
            Image {                                        // the real spine, when the book is the pile's width
                visible: newRun.photoSpine
                x: Math.round((newRun.width - newRun.spineG.w) / 2); y: newRun.height - newRun.spineH
                source: root.art + "book_4.png"; smooth: false
            }
            Item {                                         // the same spine, drawn, when the book is lifted out wide
                visible: !newRun.photoSpine
                y: newRun.height - newRun.spineH; width: parent.width; height: newRun.spineH
                Rectangle { anchors.fill: parent; color: "#b6a27a" }
                Rectangle { anchors.fill: parent; anchors.leftMargin: 8; anchors.rightMargin: 8; anchors.topMargin: 6; anchors.bottomMargin: 6; color: "#8e1a1a" }
                Rectangle { x: 4; y: 4; width: 3; height: parent.height - 8; color: "#f0d68a" }
                Rectangle { x: parent.width - 7; y: 4; width: 3; height: parent.height - 8; color: "#f0d68a" }
            }
            Text {
                x: newRun.photoSpine ? Math.round((newRun.width - newRun.spineG.w) / 2) + newRun.spineG.labelX + 4 : (parent.width - width) / 2
                y: newRun.height - newRun.spineH + (newRun.photoSpine ? newRun.spineG.labelY + 2 : 8)
                width: newRun.photoSpine ? newRun.spineG.labelW - 8 : parent.width * 0.62
                height: newRun.photoSpine ? newRun.spineG.labelH - 4 : newRun.spineH - 16
                text: promptBox.text.trim() === "" ? "BLANK" : promptBox.text.trim().toUpperCase()
                color: "#f0d68a"; style: Text.Raised; styleColor: "#2a1a06"
                font.family: root.mono; font.bold: true; font.pixelSize: 11
                fontSizeMode: Text.Fit; minimumPixelSize: 6
                horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                wrapMode: Text.WordWrap; elide: Text.ElideRight
            }
            // the eraser, lying in the gap between this and the pile, on the right: click and it rubs out
            // every finished run (to research/.cleared, nothing is deleted)
            Item {
                id: eraser
                objectName: rp.tag === "" ? "eraser" : rp.tag + "Eraser"
                readonly property var g: root.g0.eraser
                property real rub: 0                    // px it is pushed sideways while rubbing
                visible: !!g && host.runs.some(r => r.status !== "running")
                width: g ? g.w : 0; height: g ? g.h : 0
                x: newRun.width - width; y: newRun.height + Math.round((rp.spacing - height) / 2)
                SequentialAnimation {                  // rubbing hard, then the books are gone
                    id: wipe
                    SequentialAnimation {
                        loops: 3
                        NumberAnimation { target: eraser; property: "rub"; to: -8; duration: 70 }
                        NumberAnimation { target: eraser; property: "rub"; to: 3; duration: 70 }
                    }
                    NumberAnimation { target: eraser; property: "rub"; to: 0; duration: 60 }
                    ScriptAction { script: host.clearFinished() }
                }
                Image {
                    x: eraser.rub; y: eraserMouse.pressed ? 1 : 0
                    source: root.art + "eraser.png"; smooth: false
                }
                MouseArea {
                    id: eraserMouse
                    anchors.fill: parent; anchors.margins: -3
                    hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                    onContainsMouseChanged: root.keyTip = containsMouse
                        ? "erase every finished run from the drawer (kept in research/.cleared)" : ""
                    onClicked: if (!wipe.running) wipe.start()
                }
            }
        }
        // the pile: every run a book lying in the drawer spine up, a sliver apart, newest on top. They lie
        // on the drawer's own floor (inside its walls) and go by with it when it scrolls, under its far
        // wall and its front. Click: open it; double-click: open its model; right-click: letter its spine;
        // middle-click: clear a finished one; drag up/down: scroll the pile; drag sideways: onto a viewport pane
        Column {
            id: shelf
            objectName: rp.tag === "" ? "runBooks" : rp.tag + "RunBooks"
            readonly property var bk: root.g0.books || []
            property string editingDir: ""         // the book whose spine is being lettered
            // what the pile scrolls in: the drawer, or the popped-out window's own
            function scroller() { for (let p = shelf.parent; p; p = p.parent) if (p instanceof Flickable) return p; return null }
            x: rp.popped ? 0 : Math.floor((rp.width - (bk.length ? bk[0].w : 0)) / 2)   // centred on the drawer's floor
            spacing: -3                            // a book's shadow falls on the one below: no gap
            visible: host.runs.length > 0 && bk.length > 0
            Repeater {
                model: host.runs
                delegate: Item {
                    id: book
                    required property var modelData
                    required property int index
                    readonly property var g: shelf.bk[rp.bookIds[index] || 0]
                    readonly property bool editing: shelf.editingDir === modelData.dir
                    readonly property bool live: modelData.status === "running"
                    readonly property bool shown: modelData.pane > 0 || host.replay.dir === modelData.dir
                    width: g.w; height: g.bodyH + 2 * root.g0.S
                    Item {
                        id: spine
                        width: book.g.w; height: book.g.h
                        Image { source: root.art + "book_" + (rp.bookIds[book.index] || 0) + ".png"; smooth: false }
                        // the title, lettered in gilt along the lettering piece
                        Text {
                            visible: !book.editing
                            x: book.g.labelX + 4; y: book.g.labelY + 2
                            width: book.g.labelW - 8; height: book.g.labelH - 4
                            text: rp.bookTitle(book.modelData)
                            color: book.shown || bookMouse.containsMouse ? "#fff4c8" : "#f0d68a"; style: Text.Raised; styleColor: "#2a1a06"
                            font.family: root.mono; font.bold: true; font.pixelSize: 11
                            fontSizeMode: Text.Fit; minimumPixelSize: 6
                            wrapMode: Text.WordWrap; maximumLineCount: 2
                            horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                            opacity: book.live && !root.blinkOn ? 0.45 : 1
                        }
                        // lettering it yourself: Enter keeps it, Esc or clicking away leaves it, empty: its own title back
                        Loader {
                            active: book.editing
                            x: book.g.labelX + 2; y: book.g.labelY + 2
                            width: book.g.labelW - 4; height: book.g.labelH - 4
                            z: 5
                            sourceComponent: Rectangle {
                                color: "#2a1a06"; border.width: 1; border.color: "#f0d68a"
                                TextInput {
                                    id: spineEdit
                                    anchors.fill: parent; anchors.margins: 3
                                    text: book.modelData.spine || rp.bookTitle(book.modelData)
                                    color: "#fff4c8"; selectionColor: root.amber; selectedTextColor: "#2a1a06"
                                    font.family: root.mono; font.bold: true; font.pixelSize: 11
                                    font.capitalization: Font.AllUppercase
                                    horizontalAlignment: TextInput.AlignHCenter; verticalAlignment: TextInput.AlignVCenter
                                    maximumLength: 60; clip: true; selectByMouse: true
                                    Component.onCompleted: { forceActiveFocus(); selectAll() }
                                    property bool done: false
                                    function finish(keep) {
                                        if (done) return; done = true;
                                        if (keep) host.renameRun(book.modelData.dir, text);
                                        shelf.editingDir = ""
                                    }
                                    Keys.onReturnPressed: finish(true)
                                    Keys.onEnterPressed: finish(true)
                                    Keys.onEscapePressed: finish(false)
                                    onActiveFocusChanged: if (!activeFocus) finish(false)
                                }
                            }
                        }
                        // a researched run has its model sheet sticking out of the pages: a paper slip marked SHEET
                        Rectangle {
                            visible: !!book.modelData.sheet
                            x: book.g.w - width - 2; y: (book.g.h - height) / 2; width: 46; height: 16
                            color: root.sheetDir === book.modelData.dir ? "#fff4c8" : "#e8eddc"; border.width: 2; border.color: "#1d2318"
                            Text { anchors.centerIn: parent; text: "SHEET"; color: "#b3261c"; font.family: root.mono; font.bold: true; font.pixelSize: 10 }
                        }
                        // a live run has a red ribbon hanging out of its head
                        Rectangle {
                            visible: book.live
                            x: -8; y: book.g.bodyH / 2 - 1; width: 14; height: 6
                            color: root.inkRed; border.width: 1; border.color: "#2a0608"
                        }
                    }
                    MouseArea {
                        id: bookMouse
                        anchors.fill: parent
                        enabled: !book.editing
                        hoverEnabled: true
                        acceptedButtons: Qt.LeftButton | Qt.RightButton | Qt.MiddleButton
                        cursorShape: dragging ? Qt.ClosedHandCursor : Qt.PointingHandCursor
                        preventStealing: true
                        property real sx: 0
                        property real sy: 0
                        property real gy0: 0               // where the press was in the window, and the pile's scroll then
                        property real cy0: 0
                        property bool dragging: false      // sideways: the book onto a viewport pane
                        property bool scrolling: false     // up or down: the pile scrolls under the hand
                        property bool moved: false
                        readonly property var r: book.modelData
                        onContainsMouseChanged: root.keyTip = containsMouse
                            ? (r.prompt || r.name) + "  -  " + r.status + "  -  click: open  drag: scroll  drag sideways: onto a pane  right-click: rename  middle-click: clear"
                              + (r.score >= 0 ? "  " + Number(r.score).toFixed(1) + "/10" : "")
                            : ""
                        onPressed: function (m) {
                            sx = m.x; sy = m.y; dragging = false; scrolling = false; moved = false;
                            gy0 = mapToItem(root.contentItem, m.x, m.y).y;
                            const f = shelf.scroller(); cy0 = f ? f.contentY : 0
                        }
                        onPositionChanged: function (m) {
                            if (!pressed || !(pressedButtons & Qt.LeftButton)) return;
                            const dx = Math.abs(m.x - sx), dy = Math.abs(m.y - sy);
                            if (!moved && dx + dy > 10) {
                                moved = true;
                                if (dx > dy && r.latestRevision > 0) { dragging = true; runDrag.begin(r) } else scrolling = true
                            }
                            const p = mapToItem(root.contentItem, m.x, m.y);
                            if (dragging) runDrag.moveTo(p);
                            else if (scrolling) {
                                const f = shelf.scroller();
                                if (f) f.contentY = Math.max(0, Math.min(cy0 - (p.y - gy0), f.contentHeight - f.height))
                            }
                        }
                        onReleased: { if (dragging) runDrag.finish(); dragging = false; scrolling = false }
                        onCanceled: { if (dragging) runDrag.cancel(); dragging = false; scrolling = false }
                        onClicked: function (m) {
                            if (moved) return;
                            if (m.button === Qt.RightButton) { shelf.editingDir = r.dir; return }
                            if (m.button === Qt.MiddleButton) { if (!book.live) host.clearRun(r.dir); return }
                            root.sheetDir = root.sheetDir === r.dir ? "" : r.dir   // open the book: its research, and PLAY for what was modelled
                            if (book.live && r.pane <= 0) host.showRunIn(r.dir, root.activePane)
                        }
                        onDoubleClicked: if (r.best !== "") host.openModel(r.best)
                    }
                }
            }
        }
    }

    // replay of a run: its kept revisions shown one after another in the viewport (nothing is recorded),
    // a scrubber over the steps, the script line each step ran, and notes left on a step for the modeller
    // a transport key on the replay strip: a drawn icon, not a labelled key, so it reads apart from the camera keys
    component Transport: Item {
        id: tk
        property string kind: "play"      // play, pause, prev, next, first, last, close
        property string tip: ""
        signal clicked()
        width: 30; height: 26
        Rectangle { anchors.fill: parent; radius: 3; color: tkMouse.pressed ? "#3a3f45" : tkMouse.containsMouse ? "#2c3035" : "transparent" }
        Canvas {
            id: tkIcon
            anchors.centerIn: parent; width: 16; height: 14
            property string k: tk.kind
            onKChanged: requestPaint()
            onPaint: {
                const c = getContext("2d"); c.reset(); c.fillStyle = tk.kind === "close" ? "#c9ccd0" : root.amber
                function tri(x0, dir) { c.beginPath(); c.moveTo(x0, 1); c.lineTo(x0 + 7 * dir, 7); c.lineTo(x0, 13); c.closePath(); c.fill() }
                if (tk.kind === "play") { c.beginPath(); c.moveTo(3, 0); c.lineTo(15, 7); c.lineTo(3, 14); c.closePath(); c.fill() }
                else if (tk.kind === "pause") { c.fillRect(3, 1, 4, 12); c.fillRect(10, 1, 4, 12) }
                else if (tk.kind === "prev") tri(12, -1)
                else if (tk.kind === "next") tri(4, 1)
                else if (tk.kind === "first") { c.fillRect(2, 1, 3, 12); tri(13, -1) }
                else if (tk.kind === "last") { tri(3, 1); c.fillRect(11, 1, 3, 12) }
                else { c.strokeStyle = "#c9ccd0"; c.lineWidth = 2; c.beginPath(); c.moveTo(3, 1); c.lineTo(13, 13); c.moveTo(13, 1); c.lineTo(3, 13); c.stroke() }
            }
        }
        MouseArea {
            id: tkMouse
            anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
            onClicked: tk.clicked()
            onContainsMouseChanged: root.keyTip = containsMouse ? tk.tip : ""
        }
    }

    // a little lettered toggle (layout 1/2/4, a pane number): lit amber when it's the one in use
    // ---- fly camera, as in s&box: hold the right mouse button to look around, WASD to fly, Q/E down/up,
    // Shift fast, the wheel (still holding) for the speed; let go and the mouse orbits again, around
    // whatever is in front. One per pane, never linked: each pane flies its own camera
    // paneCmd is also every mouse move's path (orbit, pan, wheel dolly, double-click frame,
    // in pane 1 and in the side panes alike): the mouse is in one pane, so it moves that
    // pane only — LINK CAMS links the camera keys and commands, never the mouse
    function paneCmd(n, line) { if (n <= 1) host.cmd(line); else host.paneList[n - 2].cmd(line) }
    component FlyCam: QtObject {
        required property int n
        property bool on: false
        property var held: ({})
        property bool fast: false
        property int steps: 0                    // wheel notches on the speed, kept per pane
        readonly property real speed: Math.pow(1.25, steps)
        function start() {
            on = true; held = ({}); fast = false;
            root.paneCmd(n, "fly 1"); root.paneCmd(n, "flyspeed " + steps);
        }
        function stop() {
            if (!on) return;
            on = false; held = ({});
            root.paneCmd(n, "flymove 0 0 0 0"); root.paneCmd(n, "fly 0");
        }
        function look(dx, dy) { if (on) root.paneCmd(n, "look " + dx + " " + dy) }
        function push() {
            const h = held;
            root.paneCmd(n, "flymove " + ((h.w ? 1 : 0) - (h.s ? 1 : 0)) + " " + ((h.d ? 1 : 0) - (h.a ? 1 : 0))
                         + " " + ((h.e ? 1 : 0) - (h.q ? 1 : 0)) + " " + (fast ? 1 : 0));
        }
        // while flying every key is the camera's: WASD/QE never reach 1-4 or anything else
        function key(e, down) {
            if (!on) return false;
            e.accepted = true;
            if (e.isAutoRepeat) return true;
            const names = { [Qt.Key_W]: "w", [Qt.Key_A]: "a", [Qt.Key_S]: "s", [Qt.Key_D]: "d", [Qt.Key_Q]: "q", [Qt.Key_E]: "e" };
            if (e.key === Qt.Key_Shift) fast = down;
            else if (names[e.key] !== undefined) { const h = Object.assign({}, held); h[names[e.key]] = down; held = h; }
            else return true;
            push();
            return true;
        }
        function wheel(w) {
            steps = Math.max(-12, Math.min(12, steps + (w.angleDelta.y > 0 ? 1 : -1)));
            root.paneCmd(n, "flyspeed " + steps);
        }
    }
    component FlyStrip: Rectangle {             // what the keys do, and the speed, while flying
        required property var fly
        visible: false                          // the model stays clear; fly is still the right mouse button
        anchors.horizontalCenter: parent.horizontalCenter
        y: parent.height - height - 54
        width: flyText.implicitWidth + 20; height: 24; radius: 3
        color: "#d0101214"; border.color: root.amber
        Text {
            id: flyText
            anchors.centerIn: parent
            text: "FLY  WASD move  Q/E down/up  SHIFT fast  WHEEL speed x" + parent.fly.speed.toFixed(2)
            color: root.amber; font.family: root.mono; font.bold: true; font.pixelSize: 11
        }
    }

    component Chip: Item {
        id: ch
        property string label: ""
        property bool lit: false
        property string tip: ""
        signal clicked()
        width: Math.max(22, chT.implicitWidth + 12); height: Math.max(22, chT.implicitHeight + 6)
        Rectangle {
            anchors.fill: parent; radius: 3
            color: ch.lit ? root.amber : (chM.containsMouse ? "#3d424b" : "#1f2228"); border.color: "#0b0c0e"
        }
        Text {
            id: chT; anchors.centerIn: parent; text: ch.label
            color: ch.lit ? "#1f2228" : root.keyText
            font.family: root.mono; font.bold: true; font.pixelSize: 11
        }
        MouseArea {
            id: chM; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
            enabled: ch.enabled
            onClicked: ch.clicked()
            onContainsMouseChanged: { if (ch.tip) root.keyTip = containsMouse ? ch.tip : ""; ch.tipReady = false; if (containsMouse) chWait.restart(); else chWait.stop() }
        }
        property bool tipReady: false
        Timer { id: chWait; interval: 450; onTriggered: ch.tipReady = true }
        Tape {
            visible: ch.tipReady && chM.containsMouse && ch.tip !== ""
            z: 100; x: 0; y: -30
            text: ch.tip
        }
    }

    // One pane panel owns identity, telemetry and controls; no duplicate viewport overlays.
    

    // Controls used only inside PaneHeader.
    

    // Lane D: a stage checkpoint bar at the top of a pane. When the run it heads is gated at
    // a checkpoint (run.openState === "checkpoint", from live_runs.OPEN), it shows the
    // checkpoint prompt, the focus bodies and vars as chips, quick look scrubbers whose values
    // travel with the approve/redo direction, and APPROVE & CONTINUE / REQUEST REDO keys.
    // The prompt never clips or spills: it wraps, at most 2 lines, elides right, and the full
    // prompt is the hover tip. Approve/redo go through host.sendDirection (the cabinet slot
    // that reaches a run): ScriptLive's checkpoint gate takes a direction whose text starts
    // CHECKPOINT-APPROVE / CHECKPOINT-REDO. A future host.continueCheckpoint slot can call
    // live_runs.continue_checkpoint directly; until then this is the wired path. REDO unblocks
    // the gate too, with the redo request kept as a note for the modeller, so the run never
    // deadlocks waiting for a stage it cannot redo on its own; the modeller's replacement
    // lines then go in through the run's open loop.
    

    // Lane O: freehand draw-over layer for pane 1. Armed with DRAW (or the ToolCard DRAW
    // key), it captures a freehand stroke over the viewport and draws it back as a polyline.
    // Points are kept as fractions of the layer (fx, fy), so they survive a pane resize, and
    // strokeJson is the payload the host ray slot turns into 3D hits: the cabinet viewport
    // is a streamed serve image, it has no 3D camera in QML, so the ray per point comes
    // from the serve viewer's camera — host.drawOverStroke sends each point as a `drop`
    // probe (ServeMode ScreenRay + face pick, no selection change) and writes the stroke
    // as a note on the watched run. While disarmed the MouseArea is disabled, so normal
    // clicks, picks and orbits are untouched. The CheckpointBar above is not touched by this.
    component DrawOverLayer: Item {
        id: dl
        property bool armed: false
        property var points: []
        property bool strokeReady: false
        property string strokeJson: ""
        signal sendStroke(string json)
        Canvas {
            id: dlCanvas
            anchors.fill: parent
            onPaint: {
                var ctx = getContext("2d");
                ctx.clearRect(0, 0, width, height);
                if (dl.points.length < 2) return;
                ctx.strokeStyle = "#f2a91c"; ctx.lineWidth = 2; ctx.lineJoin = "round"; ctx.lineCap = "round";
                ctx.beginPath();
                ctx.moveTo(dl.points[0].fx * width, dl.points[0].fy * height);
                for (var i = 1; i < dl.points.length; i++) ctx.lineTo(dl.points[i].fx * width, dl.points[i].fy * height);
                ctx.stroke();
            }
        }
        MouseArea {
            anchors.fill: parent
            enabled: dl.armed
            property bool drawing: false
            onPressed: function (m) {
                drawing = true; dl.points = [{ fx: m.x / width, fy: m.y / height }];
                dl.strokeReady = false; dl.strokeJson = ""; dlCanvas.requestPaint();
            }
            onPositionChanged: function (m) {
                if (!drawing) return;
                var p = dl.points.slice();
                p.push({ fx: m.x / width, fy: m.y / height });
                dl.points = p; dlCanvas.requestPaint();
            }
            onReleased: function (m) {
                drawing = false;
                if (dl.points.length > 1) { dl.strokeReady = true; dl.strokeJson = JSON.stringify(dl.points); }
                dlCanvas.requestPaint();
            }
        }
        Row {
            anchors.left: parent.left; anchors.bottom: parent.bottom; anchors.margins: 8
            spacing: 4
            Chip {
                label: dl.armed ? "DRAW: ON" : "DRAW"; lit: dl.armed
                tip: "draw-over: drag a freehand stroke over the model; SEND turns it into a note on the watched run"
                onClicked: { dl.armed = !dl.armed; if (!dl.armed) { dl.points = []; dl.strokeReady = false; dlCanvas.requestPaint(); } }
            }
            Chip {
                visible: dl.strokeReady
                label: "SEND STROKE"; lit: true
                tip: "captured stroke payload (fractions of the pane); SEND asks the serve viewer for the face under each point"
                onClicked: dl.sendStroke(JSON.stringify(dl.points.map(function (pt) { return { x: Math.round(pt.fx * dl.width), y: Math.round(pt.fy * dl.height) }; })))
            }
            Chip {
                visible: dl.points.length > 0
                label: "CLEAR"
                tip: "drop this stroke"
                onClicked: { dl.points = []; dl.strokeReady = false; dl.strokeJson = ""; dlCanvas.requestPaint(); }
            }
        }
    }

    // what a live script run is doing, written out on the build note (the paper the run bar's NOTE key
    // tosses out): LINE x of n, the part, what the line does, the line itself, a held run's error, and
    // every step so far, newest first (click one to replay from it; the raw line shows under the pointer)
    component BuildSheet: Item {
        id: bs
        property var run: null
        property string hoverRaw: ""
        signal pick(int rev)
        signal shut()
        readonly property var w: run && run.watch ? run.watch : ({})
        readonly property bool held: !!run && (run.openState === "held" || !!w.error)
        readonly property color ink: "#3b2a18"
        readonly property color faint: "#8a7454"
        readonly property color red: "#a8281c"
        Column {
            id: bsHead
            width: parent.width; spacing: 4
            Item {
                width: parent.width; height: 16
                Text {
                    width: parent.width - 20; elide: Text.ElideMiddle
                    text: "BUILD NOTE" + (bs.run ? "  " + (bs.run.name || "") : "")
                    color: bs.faint; font.family: root.mono; font.bold: true; font.pixelSize: 10
                }
                Text {
                    objectName: "buildNoteShut"
                    anchors.right: parent.right
                    text: "x"; color: bsShutM.containsMouse ? bs.red : bs.faint
                    font.family: root.mono; font.bold: true; font.pixelSize: 13
                    MouseArea { id: bsShutM; anchors.fill: parent; anchors.margins: -6; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: bs.shut() }
                }
            }
            Text {
                objectName: "buildNoteLine"
                text: bs.w.line ? "LINE " + bs.w.line + " of " + bs.w.total : "STEP " + (bs.w.count || 0)
                color: bs.held ? bs.red : bs.ink; font.family: root.mono; font.bold: true; font.pixelSize: 17
            }
            Rectangle {
                width: parent.width; height: 5; radius: 2; color: "#e2d3b0"
                Rectangle {
                    height: parent.height; radius: 2; color: bs.held ? bs.red : "#b9852a"
                    width: bs.w.total ? parent.width * Math.min(1, bs.w.line / bs.w.total) : 0
                }
            }
            Text {                                  // what the line does, in plain words
                width: parent.width; wrapMode: Text.WordWrap; maximumLineCount: 3; elide: Text.ElideRight
                text: (bs.w.part ? bs.w.part + ": " : "") + (bs.w.say || bs.w.code || "")
                color: bs.ink; font.family: root.mono; font.bold: true; font.pixelSize: 12
            }
            Text {                                  // the line itself, for the technical
                width: parent.width; wrapMode: Text.WrapAnywhere; maximumLineCount: 3; elide: Text.ElideRight
                visible: !!bs.w.code && bs.w.code !== bs.w.say
                text: bs.w.code || ""
                color: bs.faint; font.family: root.mono; font.pixelSize: 11
            }
            Text {
                objectName: "buildNoteError"
                width: parent.width; visible: bs.held
                wrapMode: Text.WordWrap; maximumLineCount: 3; elide: Text.ElideRight
                text: "HELD: " + (bs.w.error || (bs.run ? bs.run.outcome : ""))
                color: bs.red; font.family: root.mono; font.bold: true; font.pixelSize: 11
            }
            Item { width: 1; height: 2 }
            Text {
                visible: (bs.w.steps || []).length > 0
                text: "STEPS  (click one to replay from it)"
                color: bs.faint; font.family: root.mono; font.bold: true; font.pixelSize: 10
            }
        }
        ListView {
            objectName: "buildNoteSteps"
            y: bsHead.height + 4; width: parent.width
            height: parent.height - y - (bsRaw.visible ? bsRaw.height + 4 : 0)
            clip: true; boundsBehavior: Flickable.StopAtBounds
            model: (bs.w.steps || []).slice().reverse()
            delegate: Rectangle {
                required property var modelData
                required property int index
                width: ListView.view.width; height: 16
                color: bsStep.containsMouse ? "#ecdcb4" : "transparent"
                Text {
                    x: 2; width: parent.width - 4; elide: Text.ElideRight
                    anchors.verticalCenter: parent.verticalCenter
                    text: ("R" + modelData.rev + "   ").slice(0, 5) + (modelData.say || modelData.code)
                    color: index === 0 ? "#8a5a10" : bs.ink
                    font.family: root.mono; font.bold: index === 0; font.pixelSize: 11
                }
                MouseArea {
                    id: bsStep
                    anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                    onClicked: bs.pick(modelData.rev)
                    onContainsMouseChanged: bs.hoverRaw = containsMouse ? (modelData.part ? modelData.part + ": " : "") + modelData.code : ""
                }
            }
        }
        Text {
            id: bsRaw
            anchors.bottom: parent.bottom; width: parent.width
            visible: bs.hoverRaw !== ""
            text: bs.hoverRaw
            color: bs.faint; font.family: root.mono; font.pixelSize: 10
            wrapMode: Text.WrapAnywhere; maximumLineCount: 2; elide: Text.ElideRight
        }
    }

