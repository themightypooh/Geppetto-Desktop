        }
        // Top-bar file/status text removed 2026-10-25: host.status kept internally, for a more elegant display elsewhere later.
        Row {
            id: buttons
            x: root.g0.bar.barW - width - 18
            y: root.g0.bar.faceY + 3
            spacing: 6
