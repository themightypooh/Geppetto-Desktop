                function clampScroll() {
                    scrollX = Math.max(0, Math.min(scrollX, last * ppf + 20 - laneW));
                    scrollY = Math.max(0, Math.min(scrollY, tracks.length * rowH - laneH));
                }
                function fit() { ppf = Math.max(0.4, Math.min(80, (laneW - 20) / last)); scrollX = 0; clampScroll(); lanes.requestPaint() }
                function xOf(f) { return Math.round(f * ppf - scrollX) + 6 }
                function frameAt(x) { return (x - 6 + scrollX) / ppf }
                function rowAt(y) { var r = Math.floor((y + scrollY) / rowH); return r >= 0 && r < tracks.length ? r : -1 }
                function keyAt(t, f) {                         // index of the pair at frame f, or -1
                    var k = tracks[t].keys, lo = 0, hi = k.length / 2 - 1;
                    while (lo <= hi) { var m = (lo + hi) >> 1, v = k[m * 2]; if (v === f) return m; if (v < f) lo = m + 1; else hi = m - 1; }
                    return -1;
                }
