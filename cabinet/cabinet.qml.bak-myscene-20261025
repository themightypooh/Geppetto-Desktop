                readonly property int rulerH: 16
                readonly property int laneW: width - gutter
                readonly property int laneH: height - laneTop - rulerH
                readonly property int last: Math.max(tlFloor.last, sheet.frames || 0, 1)
                readonly property var easeNames: ["SMOOTH", "LINEAR", "STEP", "IN", "OUT", "CUBIC", "MONO"]
                property real ppf: 4                           // pixels per frame
                property real scrollX: 0
                property real scrollY: 0
                property var sel: ({})                         // "track:frame" -> true
                property int selCount: 0
                property string primary: ""                    // the key last picked
                property int activeTrack: -1                   // the row KEY puts a key on
                property int dragDelta: 0
