    // A little 2D physics world for things lying loose on a drawer floor (Pinoch's junk
    // drawer, taught to work in a side drawer too): yank the drawer and its contents stay put
    // and slide to the back, slam it and they pile up at the front; they bump each other,
    // and can be picked up and thrown.
    component LooseWorld: Item {
        id: lw
        property var drawer: null
        property real minX: 0                    // the floor that stays behind the chest is out of reach
        property real minY: 0
        property var bodies: []
        readonly property bool sideways: drawer !== null && drawer.side !== "b"
        readonly property real drawerPos: drawer === null ? 0
            : sideways ? drawer.shutX + (drawer.openX - drawer.shutX) * drawer.open
                       : drawer.shutY + (drawer.openY - drawer.shutY) * drawer.open
        property real lastPos: NaN
        property real vs: 0                      // the drawer's own (smoothed) velocity
        property double lastT: 0
        property int calm: 0
        property real seenPos: drawerPos         // where the drawer was before its latest move
        // a drawer that moves while everything's asleep has to wake it from where it *was*
        onDrawerPosChanged: { wake(seenPos); seenPos = drawerPos }
        function add(b) { b.world = lw; bodies.push(b); wake() }
        function drop(b) { var i = bodies.indexOf(b); if (i >= 0) bodies.splice(i, 1) }
        function wake(from) {
            calm = 0;
            if (!tick.running) { lastT = Date.now() - 16; lastPos = from === undefined ? drawerPos : from; tick.start() }
        }
        Timer { id: tick; interval: 16; repeat: true; onTriggered: lw.step() }

        // a rod's segment ends: its long axis points (-sin h, -cos h) on screen, h counter-clockwise
        function ends(b) {
            var ax = -Math.sin(b.heading) * b.halfLen, ay = -Math.cos(b.heading) * b.halfLen;
            return [b.px - ax, b.py - ay, b.px + ax, b.py + ay];
        }
        // the point on segment (x0,y0)-(x1,y1) nearest (qx,qy)
        function nearest(x0, y0, x1, y1, qx, qy) {
            var ux = x1 - x0, uy = y1 - y0, l2 = ux * ux + uy * uy;
            var t = l2 > 1e-9 ? Math.max(0, Math.min(1, ((qx - x0) * ux + (qy - y0) * uy) / l2)) : 0;
            return [x0 + ux * t, y0 + uy * t];
        }
        // a rod against anything: find the rod's point nearest the other body and treat it as a ball
        // there, then hand back where they touch (cx, cy) so the push can turn the rod
        function rodContact(a, b) {
            var ea = ends(a), qa, qb, c;
            if (b.shape === "rod") {
                var eb = ends(b);
                // nearest points between two segments: alternate a few times, it settles fast
                qb = [b.px, b.py];
                for (var i = 0; i < 3; i++) {
                    qa = nearest(ea[0], ea[1], ea[2], ea[3], qb[0], qb[1]);
                    qb = nearest(eb[0], eb[1], eb[2], eb[3], qa[0], qa[1]);
                }
            } else {
                qa = nearest(ea[0], ea[1], ea[2], ea[3], b.px, b.py);
                qb = [b.px, b.py];
            }
            var ghostA = { shape: "circle", px: qa[0], py: qa[1], rad: a.rad };
            var ghostB = b.shape === "rod" ? { shape: "circle", px: qb[0], py: qb[1], rad: b.rad }
                       : { shape: b.shape, px: b.px, py: b.py, rad: b.rad, cw: b.cw, ch: b.ch };
            c = contact(ghostA, ghostB);
            if (!c) return null;
            c.cx = qa[0] + c.nx * (a.rad - c.p / 2); c.cy = qa[1] + c.ny * (a.rad - c.p / 2);
            return c;
        }
        // contact between two bodies: normal (from a to b) and depth, or null
        function contact(a, b) {
            if (a.shape === "rod") return rodContact(a, b);
            if (b.shape === "rod") {
                var r = rodContact(b, a);
                return r ? { nx: -r.nx, ny: -r.ny, p: r.p, cx: r.cx, cy: r.cy } : null;
            }
            var dx = b.px - a.px, dy = b.py - a.py, d, p;
            if (a.shape === "circle" && b.shape === "circle") {
                d = Math.hypot(dx, dy); p = a.rad + b.rad - d;
                if (p <= 0) return null;
                return d > 1e-6 ? { nx: dx / d, ny: dy / d, p: p } : { nx: 0, ny: 1, p: p };
            }
            if (a.shape === "box" && b.shape === "box") {
                var ox = (a.cw + b.cw) / 2 - Math.abs(dx), oy = (a.ch + b.ch) / 2 - Math.abs(dy);
                if (ox <= 0 || oy <= 0) return null;
                return ox < oy ? { nx: dx < 0 ? -1 : 1, ny: 0, p: ox } : { nx: 0, ny: dy < 0 ? -1 : 1, p: oy };
            }
            if (a.shape === "box") {
                var c = contact(b, a);
                return c ? { nx: -c.nx, ny: -c.ny, p: c.p } : null;
            }
            var hx = b.cw / 2, hy = b.ch / 2;
            var cx = Math.max(b.px - hx, Math.min(b.px + hx, a.px)) - a.px;
            var cy = Math.max(b.py - hy, Math.min(b.py + hy, a.py)) - a.py;
            d = Math.hypot(cx, cy);
            if (d > 1e-6) {
                if (d >= a.rad) return null;
                return { nx: cx / d, ny: cy / d, p: a.rad - d };
            }
            var qx = hx + a.rad - Math.abs(dx), qy = hy + a.rad - Math.abs(dy);
            return qx < qy ? { nx: dx < 0 ? -1 : 1, ny: 0, p: qx } : { nx: 0, ny: dy < 0 ? -1 : 1, p: qy };
        }
        function resolve(a, b) {
            var c = contact(a, b);
            if (!c) return;
            var ia = a.held ? 0 : 1 / a.mass, ib = b.held ? 0 : 1 / b.mass;
            if (ia + ib === 0) return;
            var k = c.p * 0.8 / (ia + ib);
            a.px -= c.nx * k * ia; a.py -= c.ny * k * ia;
            b.px += c.nx * k * ib; b.py += c.ny * k * ib;
            if (c.cx === undefined) { c.cx = (a.px + b.px) / 2; c.cy = (a.py + b.py) / 2 }
            hit(a, b, c.nx, c.ny, c.cx, c.cy);
            var rvx = (b.held ? 0 : b.vx) - (a.held ? 0 : a.vx);
            var rvy = (b.held ? 0 : b.vy) - (a.held ? 0 : a.vy);
            var tv = -rvx * c.ny + rvy * c.nx;
            if (a.shape === "circle" && a.rad > 0) a.spin += tv / a.rad * 0.45;
            if (b && b.shape === "circle" && b.rad > 0) b.spin -= tv / b.rad * 0.45;
        }
        // an impulse at the point where two bodies touch: it pushes them apart and, off-centre,
        // turns a rod (b null: a fixed wall). The velocity of a point r from a body's centre is
        // v + w x r, with w the spin (screen coords, counter-clockwise turns read as -w here)
        function hit(a, b, nx, ny, cx, cy) {
            var ia = a.held ? 0 : 1 / a.mass, ib = b && !b.held ? 1 / b.mass : 0;
            var Ia = a.held || a.inertia <= 0 ? 0 : 1 / a.inertia, Ib = b && !b.held && b.inertia > 0 ? 1 / b.inertia : 0;
            var rax = cx - a.px, ray = cy - a.py, rbx = b ? cx - b.px : 0, rby = b ? cy - b.py : 0;
            var wa = -a.spin, wb = b ? -b.spin : 0;
            var vax = a.vx - wa * ray, vay = a.vy + wa * rax;
            var vbx = b ? b.vx - wb * rby : 0, vby = b ? b.vy + wb * rbx : 0;
            var rvx = vbx - vax, rvy = vby - vay, rv = rvx * nx + rvy * ny;
            if (rv >= 0) return;
            var ran = rax * ny - ray * nx, rbn = rbx * ny - rby * nx;
            var den = ia + ib + ran * ran * Ia + rbn * rbn * Ib;
            if (den <= 0) return;
            var e = b ? (a.bounce + b.bounce) / 2 : a.bounce;
            var j = -(1 + e) * rv / den;
            push(a, -j * nx, -j * ny, rax, ray, ia, Ia);
            if (b) push(b, j * nx, j * ny, rbx, rby, ib, Ib);
            // a little grip along the contact, so a glancing knock spins it too
            var tx = -ny, ty = nx, tv = rvx * tx + rvy * ty;
            var rat = rax * ty - ray * tx, rbt = rbx * ty - rby * tx;
            var dt2 = ia + ib + rat * rat * Ia + rbt * rbt * Ib;
            if (dt2 <= 0) return;
            var jt = Math.max(-Math.abs(j) * 0.3, Math.min(Math.abs(j) * 0.3, -tv / dt2));
            push(a, -jt * tx, -jt * ty, rax, ray, ia, Ia);
            if (b) push(b, jt * tx, jt * ty, rbx, rby, ib, Ib);
        }
        function push(o, jx, jy, rx, ry, im, Im) {
            o.vx += jx * im; o.vy += jy * im;
            o.spin -= (rx * jy - ry * jx) * Im;
        }
        function walls(b) {
            if (b.shape === "rod") {
                var e2 = ends(b), r = b.rad;
                for (var q = 0; q < 4; q += 2) {
                    var ex = e2[q], ey = e2[q + 1], d;
                    if ((d = minX - (ex - r)) > 0) { b.px += d; ex += d; hit(b, null, -1, 0, ex - r, ey) }
                    if ((d = (ex + r) - width) > 0) { b.px -= d; ex -= d; hit(b, null, 1, 0, ex + r, ey) }
                    if ((d = minY - (ey - r)) > 0) { b.py += d; ey += d; hit(b, null, 0, -1, ex, ey - r) }
                    if ((d = (ey + r) - height) > 0) { b.py -= d; ey -= d; hit(b, null, 0, 1, ex, ey + r) }
                    e2 = ends(b);
                }
                return;
            }
            var hx = b.shape === "box" ? b.cw / 2 : b.rad, hy = b.shape === "box" ? b.ch / 2 : b.rad;
            var e = b.bounce, r = b.shape === "circle" ? b.rad : 0;
            if (b.px - hx < minX) {
                b.px = minX + hx;
                if (b.vx < 0) {
                    if (r) b.spin -= b.vy / r * 0.4;
                    b.vx = -b.vx * e;
                }
            }
            if (b.px + hx > width) {
                b.px = width - hx;
                if (b.vx > 0) {
                    if (r) b.spin += b.vy / r * 0.4;
                    b.vx = -b.vx * e;
                }
            }
            if (b.py - hy < minY) {
                b.py = minY + hy;
                if (b.vy < 0) {
                    if (r) b.spin += b.vx / r * 0.4;
                    b.vy = -b.vy * e;
                }
            }
            if (b.py + hy > height) {
                b.py = height - hy;
                if (b.vy > 0) {
                    if (r) b.spin -= b.vx / r * 0.4;
                    b.vy = -b.vy * e;
                }
            }
        }
        function step() {
            if (width <= minX || height <= minY) return;            // not laid out yet
            var now = Date.now(), dt = Math.min(0.033, Math.max(0.004, (now - lastT) / 1000));
            lastT = now;
            // whatever speed the drawer gains, the loose stuff in it doesn't: inertia
            var v = (drawerPos - lastPos) / dt;
            lastPos = drawerPos;
            var nvs = 0.6 * vs + 0.4 * v;
            var kick = Math.max(-1600, Math.min(1600, nvs - vs));
            vs = nvs;
            var i, j, b, n = bodies.length, moving = Math.abs(vs) > 2;
            for (i = 0; i < n; i++) {
                b = bodies[i];
                if (b.held) {
                    b.vx = 0.5 * b.vx + 0.5 * (b.px - b.lx) / dt;
                    b.vy = 0.5 * b.vy + 0.5 * (b.py - b.ly) / dt;
                    b.lx = b.px; b.ly = b.py;
                    if (b.shape === "rod") { b.spin = 0.5 * b.spin + 0.5 * (b.heading - b.lh) / dt; b.lh = b.heading }
                    moving = true;
                    continue;
                }
                var kickX = sideways ? kick : 0;
                var kickY = sideways ? 0 : kick;
                var vx = b.vx - kickX, vy = b.vy - kickY;
                if (b.shape === "rod") {
                    // a rod rolls across its length and skids along it, whichever way it lies
                    var ux = -Math.sin(b.heading), uy = -Math.cos(b.heading);
                    var al = vx * ux + vy * uy, ac = vx * -uy + vy * ux;
                    al -= Math.sign(al) * Math.min(Math.abs(al), b.dragY * dt);
                    ac -= Math.sign(ac) * Math.min(Math.abs(ac), b.dragX * dt);
                    vx = al * ux - ac * uy; vy = al * uy + ac * ux;
                    if (b.rollR > 0) b.roll += ac * dt / b.rollR;
                    b.spin -= Math.sign(b.spin) * Math.min(Math.abs(b.spin), b.spinDrag * dt);
                    b.spin = Math.max(-25, Math.min(25, b.spin));
                    b.heading += b.spin * dt;
                    if (Math.abs(b.spin) > 0.05) moving = true;
                } else if (b.shape === "circle") {
                    // Isotropic friction: decelerates speed smoothly
                    var sp = Math.hypot(vx, vy);
                    if (sp > 0) {
                        var f = Math.min(sp, b.drag * dt) / sp;
                        vx -= vx * f;
                        vy -= vy * f;
                    }
                    b.spin *= Math.pow(0.2, dt);
                    if (Math.abs(b.spin) < 0.05) b.spin = 0;
                    if (Math.abs(b.spin) > 0.05) moving = true;
                } else {
                    // friction per axis
                    vx -= Math.sign(vx) * Math.min(Math.abs(vx), b.dragX * dt);
                    vy -= Math.sign(vy) * Math.min(Math.abs(vy), b.dragY * dt);
                }
                var sp = Math.hypot(vx, vy);
                if (sp > 2000) { vx *= 2000 / sp; vy *= 2000 / sp }
                b.vx = vx; b.vy = vy;
                b.px += vx * dt; b.py += vy * dt;
                if (b.rollR > 0) {
                    b.rollA += vx * dt / b.rollR;
                    b.rollB -= vy * dt / b.rollR;
                }
                if (b.settles) {
                    var qt = Math.PI / 2;
                    var dA = Math.round(b.rollA / qt) * qt - b.rollA;
                    var dB = Math.round(b.rollB / qt) * qt - b.rollB;
                    if (sp < 90) {
                        var k = Math.min(1, dt * 14);
                        b.rollA += dA * k;
                        b.rollB += dB * k;
                        if (Math.abs(dA) + Math.abs(dB) > 0.005) moving = true;
                    }
                    if (sp < 5 && Math.abs(b.spin) < 0.1) {
                        b.rollA = Math.round(b.rollA / qt) * qt;
                        b.rollB = Math.round(b.rollB / qt) * qt;
                        b.vx = 0; b.vy = 0; b.spin = 0;
                    }
                }
                if (b.ball && b.rollR > 0) {
                    // the roll axis lies across the way it goes, folded to one half-turn: rolling
                    // back the way it came unrolls it rather than flipping it round
                    if (sp > 4) {
                        var bh = Math.atan2(-vy, vx);
                        b.heading = bh >= Math.PI / 2 ? bh - Math.PI : bh < -Math.PI / 2 ? bh + Math.PI : bh;
                    }
                    b.roll += (-vx * -Math.cos(b.heading) + vy * -Math.sin(b.heading)) * dt / b.rollR;
                } else if (b.shape !== "rod" && b.rollR > 0) b.roll += (b.rollAcross ? vy : vx) * dt / b.rollR;
                if (sp > 0.5) moving = true;
            }
            for (var it = 0; it < 3; it++) {
                for (i = 0; i < n; i++)
                    for (j = i + 1; j < n; j++) resolve(bodies[i], bodies[j]);
                for (i = 0; i < n; i++) walls(bodies[i]);
            }
            calm = moving ? 0 : calm + 1;
            if (calm > 20) {
                for (i = 0; i < n; i++) {
                    var sb = bodies[i];
                    if (sb.settles) {
                        sb.rollA = Math.round(sb.rollA / (Math.PI / 2)) * (Math.PI / 2);
                        sb.rollB = Math.round(sb.rollB / (Math.PI / 2)) * (Math.PI / 2);
                        sb.vx = 0; sb.vy = 0; sb.spin = 0;
                    }
                }
                vs = 0; tick.stop()
            }
        }
    }

    // anything lying loose in a LooseWorld: it slides and bumps, can be picked up and
    // thrown, and a click that doesn't move it is a tap
    component Loose: Item {
        id: lo
        property string shape: "box"            // box, circle, or rod (a capsule that turns and rolls any way)
        property real cw: width                 // box collider
        property real ch: height
        property real rad: 10                   // circle collider
        property real density: 1
        property real bounce: 0.3
        property real drag: 900                 // floor friction, px/s/s
        property real dragX: drag
        property real dragY: drag
        property real rollR: 0                  // > 0: it rolls about its long (vertical) axis
        property bool ball: false               // rolls whichever way it goes: heading is its roll axis
        property bool rollAcross: false         // its long axis lies across (x): it rolls as it moves in y
        property real roll: 0                   // radians rolled so far
        property real rollA: 0                  // roll angle along x (rad)
        property real rollB: 0                  // roll angle along y (rad)
        property bool settles: false            // rolls to rest on flat faces (die)
        property real halfLen: 0                // rod: half its segment (the ends are rad round)
        property real heading: 0                // rod: which way it lies, radians counter-clockwise from point-up
        property real spin: 0                   // rod: radians/s counter-clockwise
        property real spinDrag: 9
        property real lh: 0
        property int turns: 16                  // rod: headings it was rendered at
        // rod: the rendered frame nearest its heading, and its roll frame
        readonly property int turnFrame: { var f = Math.round(heading / (2 * Math.PI / turns)) % turns; return f < 0 ? f + turns : f }
        function rollFrame(n) { var f = Math.floor(roll / (2 * Math.PI / n)) % n; return f < 0 ? f + n : f }
        function pad2(n) { return (n < 10 ? "0" : "") + n }
        // a rod is only where it is, not its whole square: x, y local
        function onBody(x, y) {
            if (shape !== "rod") return true;
            var qx = x - width / 2, qy = y - height / 2;
            var ux = -Math.sin(heading), uy = -Math.cos(heading);
            var t = Math.max(-halfLen, Math.min(halfLen, qx * ux + qy * uy));
            return Math.hypot(qx - ux * t, qy - uy * t) <= rad + 4;
        }
        property real px: 0                     // collider centre, world coords
        property real py: 0
        property real vx: 0
        property real vy: 0
        property bool held: false
        property real lx: 0
        property real ly: 0
        property real lift: 0                   // a little hop when tapped
        property var world: null
        readonly property real mass: (shape === "box" ? cw * ch : Math.PI * rad * rad + 4 * halfLen * rad) * density
        readonly property real inertia: shape === "rod" ? mass * ((2 * halfLen) * (2 * halfLen) / 12 + rad * rad / 4)
                                      : shape === "circle" ? 0.5 * mass * rad * rad : 0
        function scatter(sx, sy, sSpin) {
            vx = sx !== undefined ? sx : (Math.random() - 0.5) * 500;
            vy = sy !== undefined ? sy : (Math.random() - 0.5) * 500;
            spin = sSpin !== undefined ? sSpin : (Math.random() - 0.5) * 20;
            if (world) world.wake();
        }
        readonly property real ox: shape === "box" ? cw / 2 : shape === "rod" ? width / 2 : rad
        readonly property real oy: shape === "box" ? ch / 2 : shape === "rod" ? height / 2 : rad
        property string tip: ""               // a label that shows while the pointer rests on it
        signal tapped()
        x: Math.round((px - ox) / 2) * 2 - (held ? 2 : 0)
        y: Math.round((py - oy) / 2) * 2 - (held ? 2 : 0) - Math.round(lift / 2) * 2
        z: held ? 10 : 0
        Component.onCompleted: parent.add(lo)
        Component.onDestruction: if (world) world.drop(lo)
        function hop() { hopAnim.restart() }
        SequentialAnimation {
            id: hopAnim
            NumberAnimation { target: lo; property: "lift"; to: 10; duration: 90; easing.type: Easing.OutQuad }
            NumberAnimation { target: lo; property: "lift"; to: 0; duration: 220; easing.type: Easing.OutBounce }
        }
        Tape {
            id: loTip
            visible: lo.tip !== "" && loHover.over && !loHover.pressed && loTipWait.done
            z: 30
            x: Math.round((lo.width - width) / 4) * 2; y: -30
            text: lo.tip
        }
        Timer {
            id: loTipWait
            property bool done: false
            interval: 350
            running: loHover.over
            onRunningChanged: if (running) done = false
            onTriggered: done = true
        }
        MouseArea {
            id: loHover
            anchors.fill: parent
            hoverEnabled: true
            property real hx: 0
            property real hy: 0
            readonly property bool over: containsMouse && lo.onBody(hx, hy)
            cursorShape: pressed ? Qt.ClosedHandCursor : over ? Qt.OpenHandCursor : Qt.ArrowCursor
            property real gx: 0
            property real gy: 0
            property real sx: 0
            property real sy: 0
            property double t0: 0
            property bool moved: false
            property real gu: 0                 // rod: where it was grabbed, along and across its axis
            property real gv: 0
            onPressed: function (m) {
                if (!lo.onBody(m.x, m.y)) { m.accepted = false; return }
                var p = mapToItem(lo.world, m.x, m.y);
                gx = p.x - lo.px; gy = p.y - lo.py; sx = p.x; sy = p.y;
                var ux = -Math.sin(lo.heading), uy = -Math.cos(lo.heading);
                gu = gx * ux + gy * uy; gv = -gx * uy + gy * ux;
                lo.lh = lo.heading; lo.spin = 0;
                t0 = Date.now(); moved = false;
                lo.lx = lo.px; lo.ly = lo.py; lo.vx = 0; lo.vy = 0;
                lo.held = true;
                lo.world.wake();
            }
            onPositionChanged: function (m) {
                hx = m.x; hy = m.y;
                if (!pressed) return;
                var p = mapToItem(lo.world, m.x, m.y);
                if (Math.abs(p.x - sx) + Math.abs(p.y - sy) > 5) moved = true;
                if (lo.shape === "rod" && Math.hypot(gu, gv) > 6) {
                    // the grab point follows the hand; the rest trails behind it, so the rod
                    // turns until its centre hangs back along the way it was dragged from
                    var gl = Math.hypot(gu, gv);
                    var ux = -Math.sin(lo.heading), uy = -Math.cos(lo.heading);
                    var wx = gu * ux - gv * uy, wy = gu * uy + gv * ux;      // grab offset, world
                    var dx = lo.px - p.x, dy = lo.py - p.y, dl = Math.hypot(dx, dy);
                    if (dl < 1e-3) return;
                    var da = Math.atan2(-dy, -dx) - Math.atan2(wy, wx);
                    da = Math.atan2(Math.sin(da), Math.cos(da));
                    lo.heading -= da;
                    lo.px = p.x + dx / dl * gl; lo.py = p.y + dy / dl * gl;
                    return;
                }
                lo.px = p.x - gx; lo.py = p.y - gy;
            }
            onReleased: {
                lo.held = false;
                if (!moved && Date.now() - t0 < 500) { lo.vx = 0; lo.vy = 0; lo.tapped() }
                if (lo.shape === "circle" && lo.rad > 0) {
                    var r2 = gx * gx + gy * gy + lo.rad * lo.rad;
                    var addedSpin = (gx * lo.vy - gy * lo.vx) / r2 * 0.9;
                    lo.spin += addedSpin;
                    lo.vx += -gy * addedSpin * 0.25;
                    lo.vy += gx * addedSpin * 0.25;
                }
            }
        }
    }

    // =====================================================================================
    // the scene, back to front: drawers, viewport, chest, plates, lid
    // =====================================================================================

    Drawer {
        id: research
        objectName: "research"
        img: "drawer_research.png"; g: root.g0.research; side: "l"
        floorExtra: 8                     // the book pile sits right down where the floor meets the wall
        shutX: root.cabX - root.peek - g.bodyX
        openX: root.cabX + root.tuck - g.bodyW - g.bodyX
        shutY: root.cabY + (root.frameH - g.bodyH) / 2 - g.bodyY
        openY: shutY
        onIsOpenChanged: {
            if (isOpen) {
                host.refreshChat();
                testBoneDie.scatter(280 + Math.random() * 80, -(160 + Math.random() * 100), 14 + Math.random() * 8);
                testRedDie.scatter(340 + Math.random() * 80, (180 + Math.random() * 100), -(14 + Math.random() * 8));
            }
        }
        // Physical drawer world: button moves about with physics like Pinoch's junk drawer
        LooseWorld {
            id: researchWorld
            objectName: "researchWorld"
            drawer: research
            anchors.fill: parent

            Loose {
                id: claudeKey
                objectName: "claudeKey"
                shape: "box"
                width: 148
                height: root.g0.nameplate.h
                cw: width
                ch: height
                density: 1.2
                bounce: 0.35
                drag: 800
                px: 120
                py: 60
                tip: "talk to " + claudePanel.who + ", in its own window (Ctrl+L)"

                readonly property bool lit: root.claudeOpen
                readonly property string who: claudePanel.who

                onTapped: {
                    hop();
                    root.claudeOpen = !root.claudeOpen
                }

                Image {                               // the drop shadow it sits on, gone when pressed/held
                    visible: !claudeKey.held
                    x: 2; y: 2; width: claudeKey.width; height: claudeKey.height
                    source: root.art + "shadow.png"; fillMode: Image.Tile; smooth: false
                }
                BorderImage {                          // the badge
                    x: claudeKey.held ? 1 : 0; y: claudeKey.held ? 1 : 0
                    width: claudeKey.width; height: claudeKey.height
                    source: root.art + "nameplate.png"; smooth: false
                    border { left: 12; right: 12 }
                    horizontalTileMode: BorderImage.Repeat
                    Image {
                        x: 8; y: (parent.height - 14) / 2
                        source: root.art + (claudeKey.lit ? "lamp_on.png" : "lamp_off.png"); smooth: false
                    }
                    Px {
                        id: icLabel; x: 26; y: 7
                        text: "TALK"; color: claudeKey.lit ? root.amber : root.tapeText
                    }
                    Px {
                        x: icLabel.x + icLabel.width + 6; y: 7
                        maxWidth: parent.width - x - 8; maxLines: 1
                        text: claudeKey.who.split(" ")[0].toUpperCase()
                        color: claudeKey.held || claudeKey.lit ? root.keyText : "#8a8f96"
                    }
                }
            }

            // ---- The Rolling Tray / Felt Coaster Background ----
            Rectangle {
                x: 14; y: 90
                width: parent.width - 28; height: 260
                radius: 12
                color: "#161c18" // dark vintage gaming baize green
                border.width: 2
                border.color: "#2a362e"
                opacity: 0.9

                // Embossed inner boundary line
                Rectangle {
                    anchors.fill: parent; anchors.margins: 4
                    radius: 8
                    color: "transparent"
                    border.width: 1
                    border.color: "#3a4c40"
                    opacity: 0.5
                }

                // Subdued corner brass rivets
                Repeater {
                    model: [[8, 8], [parent.width - 14, 8], [8, parent.height - 14], [parent.width - 14, parent.height - 14]]
                    Rectangle {
                        x: modelData[0]; y: modelData[1]
                        width: 6; height: 6; radius: 3
                        color: "#8a7442"
                        border.width: 1; border.color: "#4a3e20"
                    }
                }

                Px {
                    anchors.horizontalCenter: parent.horizontalCenter
                    y: 12
                    text: "ROLL THE BONES TO TALK"
                    size: 5
                    color: "#526859"
                }
            }

            // ---- HERO MODEL 1: The Heavy Carved Bone Die ----
            Loose {
                id: testBoneDie
                objectName: "testBoneDie"
                shape: "circle"
                rad: 28
                width: 56; height: 56
                rollR: 20
                settles: true
                density: 1.2
                bounce: 0.38
                drag: 520
                px: 78; py: 172
                tip: "CARVED BONE DIE: Click to toss & roll • Fling to bounce off walls"

                property real airLift: 0
                property real grabLift: held ? 26 : 0
                Behavior on grabLift { NumberAnimation { duration: 140; easing.type: Easing.OutQuad } }
                readonly property real totalLift: lift + airLift + grabLift

                function wrap(a) { var k = Math.floor(a / (2 * Math.PI) * 16) % 16; return k < 0 ? k + 16 : k }
                readonly property int col: wrap(rollA)
                readonly property int row: wrap(rollB)

                // Parabolic 3D toss animation on tap
                SequentialAnimation {
                    id: boneTossAnim
                    ParallelAnimation {
                        NumberAnimation { target: testBoneDie; property: "airLift"; from: 0; to: 42; duration: 200; easing.type: Easing.OutQuad }
                    }
                    ParallelAnimation {
                        NumberAnimation { target: testBoneDie; property: "airLift"; from: 42; to: 0; duration: 240; easing.type: Easing.OutBounce }
                    }
                }

                onTapped: {
                    boneTossAnim.restart();
                    var ang = Math.random() * 2 * Math.PI;
                    var mag = 400 + Math.random() * 450;
                    vx = Math.cos(ang) * mag;
                    vy = Math.sin(ang) * mag;
                    spin = (Math.random() - 0.5) * 24;
                    world.wake();
                }

                // Dynamic 3D ground drop shadow (stays on floor, grows and blurs when die lifts up)
                Rectangle {
                    x: (testBoneDie.width - width) / 2 + 4 + testBoneDie.totalLift * 0.15
                    y: (testBoneDie.height - height) / 2 + 8 + testBoneDie.totalLift
                    width: 44 * (1 + testBoneDie.totalLift * 0.012)
                    height: 44 * (1 + testBoneDie.totalLift * 0.012)
                    radius: width / 2
                    color: "#000000"
                    opacity: Math.max(0.12, 0.42 - testBoneDie.totalLift * 0.007)
                }

                // The 3D Ray-cast Die Image (256 frames of 3D tumbling)
                Image {
                    anchors.centerIn: parent
                    y: (parent.height - height) / 2 - testBoneDie.totalLift
                    width: 64; height: 64
                    smooth: false
                    source: root.art + (testBoneDie.hot ? "junk_die_bone_off_hi.png" : "junk_die_bone_off.png")
