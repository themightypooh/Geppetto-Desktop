import QtQuick
import QtQuick.Controls as C
import QtQuick.Dialogs as D

Item {
    id: menu
    objectName: "hangingFileMenu"
    required property var cabinetRoot
    property bool open: false
    property bool naming: false
    // Menu growth: add a row here and only here for size — measuredRows re-measures
    // the longest label (panelWidth) and rows re-flows (panel height), so the sign
    // grows wider/taller with the list. Then add one branch for its action in the
    // row onClicked below. Nothing else in this file needs a size change.
    property var entries: [ { t: "OPEN...", a: "open" }, { t: "SAVE", a: "save" }, { t: "SAVE AS...", a: "as" } ]

    readonly property real chainLength: 42
    readonly property real sideMargin: 24
    property real angle: 0
    property real angularVelocity: 0
    property real pitch: 0
    property real pitchVelocity: 0
    property bool held: false
    property double lastTick: 0
    property real pressX: 0
    property real pressY: 0
    property real pressAngle: 0
    property real pressPitch: 0
    property real lastAngle: 0
    property real lastPitch: 0
    property double lastDragTime: 0

    readonly property real dx: chainLength * Math.sin(angle)
    readonly property real dy: chainLength * Math.cos(angle) * Math.cos(pitch)
    readonly property real labelWidth: {
        var longest = 0
        for (var i = 0; i < measuredRows.count; i++) {
            var row = measuredRows.itemAt(i)
            if (row) longest = Math.max(longest, row.implicitWidth)
        }
        return longest
    }
    readonly property real panelWidth: Math.max(150, Math.min(260, labelWidth + 28))
    readonly property real leftAnchor: sideMargin + (panelWidth - 150) / 2 + 16
    readonly property real rightAnchor: leftAnchor + 118

    width: panelWidth + sideMargin * 2
    height: open ? dy + panel.height + 2 : 0
    visible: open
    clip: false

    function startDrag(area, point) {
        held = true
        swing.stop()
        pressX = area.mapToItem(menu, point.x, point.y).x
        pressY = area.mapToItem(menu, point.x, point.y).y
        pressAngle = angle
        pressPitch = pitch
        lastAngle = angle
        lastPitch = pitch
        lastDragTime = Date.now()
    }
    function moveDrag(area, point) {
        if (!held) return
        var current = area.mapToItem(menu, point.x, point.y)
        var currentX = current.x
        var nextAngle = Math.max(-0.48, Math.min(0.48,
                        pressAngle + (currentX - pressX) / chainLength))
        var nextPitch = Math.max(-0.85, Math.min(0.85,
                        pressPitch + (current.y - pressY) / chainLength))
        var now = Date.now()
        angularVelocity = Math.max(-5, Math.min(5,
                          (nextAngle - lastAngle) / Math.max(0.008, (now - lastDragTime) / 1000)))
        pitchVelocity = Math.max(-5, Math.min(5,
                        (nextPitch - lastPitch) / Math.max(0.008, (now - lastDragTime) / 1000)))
        angle = nextAngle
        pitch = nextPitch
        lastAngle = nextAngle
        lastPitch = nextPitch
        lastDragTime = now
    }
    function endDrag() {
        held = false
        lastTick = Date.now()
        swing.start()
    }

    onOpenChanged: {
        if (open) {
            held = false
            angle = -0.11
            angularVelocity = 0
            pitch = 0.68
            pitchVelocity = 0
            lastTick = Date.now()
            swing.start()
        } else {
            swing.stop()
            naming = false
            angle = 0
            angularVelocity = 0
            pitch = 0
            pitchVelocity = 0
        }
    }

    Timer {
        id: swing
        interval: 16
        repeat: true
        onTriggered: {
            if (menu.held) return
            var now = Date.now()
            var remaining = Math.min(0.05, Math.max(0, (now - menu.lastTick) / 1000))
            menu.lastTick = now
            while (remaining > 0) {
                var dt = Math.min(0.008, remaining)
                menu.angularVelocity += (-1300 / menu.chainLength * Math.sin(menu.angle)
                                         - 2.8 * menu.angularVelocity) * dt
                menu.angle += menu.angularVelocity * dt
                menu.pitchVelocity += (-1300 / menu.chainLength * Math.sin(menu.pitch)
                                       - 2.2 * menu.pitchVelocity) * dt
                menu.pitch += menu.pitchVelocity * dt
                remaining -= dt
            }
            if (Math.abs(menu.angle) < 0.002 && Math.abs(menu.angularVelocity) < 0.02
                    && Math.abs(menu.pitch) < 0.002 && Math.abs(menu.pitchVelocity) < 0.02) {
                menu.angle = 0
                menu.angularVelocity = 0
                menu.pitch = 0
                menu.pitchVelocity = 0
                swing.stop()
            }
        }
    }

    Item {
        visible: false
        Repeater {
            id: measuredRows
            model: menu.entries
            delegate: Text {
                text: modelData.t
                font.family: menu.cabinetRoot.mono
                font.pixelSize: 14
            }
        }
    }

    // The two upper plates stay fixed on the nameplate. The linked spans turn around
    // their centers, and the lower mounts travel with the level sign.
    Repeater {
        model: 2
        delegate: Image {
            width: 14; height: 24
            x: (index === 0 ? menu.leftAnchor : menu.rightAnchor) - width / 2
            y: -15
            source: index === 0 ? "model/hanging-menu/upper_left.png"
                                : "model/hanging-menu/upper_right.png"
            smooth: false
        }
    }
    Repeater {
        model: 2
        delegate: Item {
            readonly property real anchorX: index === 0 ? menu.leftAnchor : menu.rightAnchor
            x: anchorX - width / 2
            y: 5 * Math.cos(menu.pitch)
            width: 18; height: 34 * Math.cos(menu.pitch)
            transformOrigin: Item.Top
            rotation: -menu.angle * 180 / Math.PI
            Image {
                x: 2; y: 0; width: 14; height: parent.height
                source: index === 0 ? "model/hanging-menu/chain_left.png"
                                    : "model/hanging-menu/chain_right.png"
                smooth: true
            }
            MouseArea {
                anchors.fill: parent
                cursorShape: pressed ? Qt.ClosedHandCursor : Qt.OpenHandCursor
                onPressed: function(point) { menu.startDrag(this, point) }
                onPositionChanged: function(point) { if (pressed) menu.moveDrag(this, point) }
                onReleased: menu.endDrag()
                onCanceled: menu.endDrag()
            }
        }
    }

    Item {
        id: panel
        objectName: "hangingFilePanel"
        x: menu.sideMargin + menu.dx
        y: menu.dy
        width: menu.panelWidth
        height: rows.height + 22
        transform: Rotation {
            origin.x: panel.width / 2
            origin.y: 0
            axis.x: 1; axis.y: 0; axis.z: 0
            angle: menu.pitch * 180 / Math.PI
        }

        Rectangle {
            anchors.fill: parent
            radius: 3
            color: "#ad8345"
            border.color: "#d5ad6d"
            border.width: 1
            Rectangle {
                anchors.fill: parent
                anchors.margins: 3
                radius: 1
                color: "#171e23"
                border.color: "#644d30"
                border.width: 1
            }
        }
        MouseArea {
            x: 0; y: 0; width: parent.width; height: 12
            z: 4
            cursorShape: pressed ? Qt.ClosedHandCursor : Qt.OpenHandCursor
            onPressed: function(point) { menu.startDrag(this, point) }
            onPositionChanged: function(point) { if (pressed) menu.moveDrag(this, point) }
            onReleased: menu.endDrag()
            onCanceled: menu.endDrag()
        }
        Column {
            id: rows
            x: 10; y: 14; width: parent.width - 20; spacing: 4
            Repeater {
                model: menu.entries
                delegate: Item {
                    objectName: "fileMenuRow_" + modelData.a
                    width: rows.width
                    height: Math.max(22, label.implicitHeight + 4)
                    Rectangle {
                        anchors.fill: parent
                        color: rowMouse.containsMouse ? "#534027" : "transparent"
                        radius: 2
                    }
                    Text {
                        id: label
                        x: 4; width: parent.width - 8
                        anchors.verticalCenter: parent.verticalCenter
                        text: modelData.t
                        color: rowMouse.containsMouse ? menu.cabinetRoot.amber : "#f2e9d4"
                        font.family: menu.cabinetRoot.mono
                        font.pixelSize: 14
                        wrapMode: Text.Wrap
                        maximumLineCount: 2
                        elide: Text.ElideRight
                    }
                    MouseArea {
                        id: rowMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            if (modelData.a === "open") {
                                // Do NOT close the menu yet: the dialog lives under
                                // it, and closing first would hide it. onAccepted
                                // below closes the menu once a file is picked.
                                // onRejected leaves the menu open, so the user can
                                // pick another row instead of reopening the sign.
                                openDialog.open()
                            } else if (modelData.a === "save") {
                                host.benchKeep("")
                                menu.open = false
                            } else if (modelData.a === "as") {
                                menu.naming = true
                                nameInput.text = ""
                                nameInput.forceActiveFocus()
                            }
                            // New entries: add their branch here, matching a above.
                        }
                        C.ToolTip.visible: containsMouse && label.truncated
                        C.ToolTip.text: modelData.t
                    }
                }
            }
            Rectangle {
                visible: menu.naming
                width: rows.width
                height: visible ? 24 : 0
                color: "#f8f0db"
                border.color: "#c39b59"
                TextInput {
                    id: nameInput
                    anchors.fill: parent
                    anchors.margins: 3
                    font.family: menu.cabinetRoot.mono
                    font.pixelSize: 14
                    color: "#211a11"
                    clip: true
                    Keys.onReturnPressed: {
                        if (text.trim()) host.benchKeep(text.trim())
                        menu.open = false
                    }
                    Keys.onEscapePressed: menu.open = false
                }
            }
        }
        Repeater {
            model: 2
            delegate: Image {
                width: 14; height: 20
                x: (index === 0 ? menu.leftAnchor : menu.rightAnchor) - menu.sideMargin - width / 2
                y: -9
                source: index === 0 ? "model/hanging-menu/lower_left.png"
                                    : "model/hanging-menu/lower_right.png"
                smooth: true
            }
        }
    }

    // OPEN's file picker. Starts in the MODELING folder (host.modelingFolder),
    // filtered to models, and loads the picked file into pane 1 via host.openModel.
    // It is not a row, so it does not affect panel size.
    D.FileDialog {
        id: openDialog
        title: "Open model"
        nameFilters: ["Models (*.effigy *.fbx)", "All files (*)"]
        currentFolder: host.modelingFolder
        onAccepted: { menu.open = false; host.openModel(selectedFile.toString()) }
    }
}
