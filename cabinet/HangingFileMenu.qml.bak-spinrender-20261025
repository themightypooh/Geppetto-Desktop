import QtQuick
import QtQuick.Controls as C
import QtQuick.Dialogs as D

Item {
    id: menu
    objectName: "hangingFileMenu"
    required property var cabinetRoot
    property bool open: false
    property bool naming: false
    // Menu growth: add a row here and only here for size — measuredRows re-measures
    // the longest label (panelWidth) and rows re-flows (panel height), so the sign
    // grows wider/taller with the list. Then add one branch for its action in the
    // row onClicked below. Nothing else in this file needs a size change.
    property var entries: [ { t: "OPEN...", a: "open" }, { t: "SAVE", a: "save" }, { t: "SAVE AS...", a: "as" }, { t: "SETTINGS", a: "settings" } ]
    // Flip: false = file side, true = settings side. No 3D rotation:
    // the sign squeezes to a vertical line on its centre axis, swaps
    // faces at that thin point, then expands back. Clean, no spin,
    // and the back face is just normal text, so it always shows.
    property bool flipped: false
    property real flipScale: 1
    function flipTo(toFlipped) {
        if (flipped === toFlipped && flipScale === 1) return
        angle = 0; angularVelocity = 0; lift = 0; dropVelocity = 0; swing.stop()
        flipTarget = toFlipped
        flipAnim.start()
    }
    property bool flipTarget: false
    SequentialAnimation {
        id: flipAnim
        NumberAnimation { target: menu; property: "flipScale"; duration: 250; to: 0; easing.type: Easing.InOutQuad }
        ScriptAction { script: menu.flipped = menu.flipTarget }
        NumberAnimation { target: menu; property: "flipScale"; duration: 250; to: 1; easing.type: Easing.InOutQuad }
    }

    readonly property real chainLength: 42
    readonly property real sideMargin: 24
    // No forward/back tilt: the sign stays level, always. It can only sway
    // side to side (angle) and be picked up and dropped (lift).
    property real angle: 0
    property real angularVelocity: 0
    property real lift: 0
    property real dropVelocity: 0
    property bool held: false
    property double lastTick: 0
    property real pressX: 0
    property real pressY: 0
    property real pressAngle: 0
    property real pressLift: 0
    property real lastAngle: 0
    property real lastLift: 0
    property double lastDragTime: 0

    readonly property real dx: chainLength * Math.sin(angle)
    readonly property real dy: chainLength * Math.cos(angle)
    readonly property real labelWidth: {
        var longest = 0
        for (var i = 0; i < measuredRows.count; i++) {
            var row = measuredRows.itemAt(i)
            if (row) longest = Math.max(longest, row.implicitWidth)
        }
        return longest
    }
    readonly property real panelWidth: Math.max(150, Math.min(260, labelWidth + 28))
    // One hanger in the middle: the left set, moved to the centre. The
    // sign's pivot, sway and lift all work off this one point now.
    readonly property real centerAnchor: sideMargin + panelWidth / 2

    width: panelWidth + sideMargin * 2
    height: open ? dy + panel.height + 2 : 0
    visible: open
    clip: false

    function startDrag(area, point) {
        held = true
        swing.stop()
        pressX = area.mapToItem(menu, point.x, point.y).x
        pressY = area.mapToItem(menu, point.x, point.y).y
        pressAngle = angle
        pressLift = lift
        lastAngle = angle
        lastLift = lift
        lastDragTime = Date.now()
    }
    function moveDrag(area, point) {
        if (!held) return
        var current = area.mapToItem(menu, point.x, point.y)
        var currentX = current.x
        var nextAngle = Math.max(-0.48, Math.min(0.48,
                        pressAngle + (currentX - pressX) / chainLength))
        // Pick it up: dragging up lifts the sign, dragging down lowers it
        // back toward hanging. It never goes below its hanging rest, and
        // never lifts so far the chains would disconnect (36px max).
        var nextLift = Math.max(0, Math.min(36,
                        pressLift + (pressY - current.y)))
        var now = Date.now()
        var dt = Math.max(0.008, (now - lastDragTime) / 1000)
        angularVelocity = Math.max(-5, Math.min(5,
                          (nextAngle - lastAngle) / dt))
        // Downward flick on release keeps falling; upward flick slows the drop.
        dropVelocity = Math.max(-800, Math.min(800,
                          (lastLift - nextLift) / dt))
        angle = nextAngle
        lift = nextLift
        lastAngle = nextAngle
        lastLift = nextLift
        lastDragTime = now
    }
    function endDrag() {
        held = false
        lastTick = Date.now()
        swing.start()
    }

    onOpenChanged: {
        if (open) {
            held = false
            angle = -0.11
            angularVelocity = 0
            lift = 0
            dropVelocity = 0
            lastTick = Date.now()
            swing.start()
        } else {
            swing.stop()
            naming = false
            angle = 0
            angularVelocity = 0
            lift = 0
            dropVelocity = 0
            flipped = false
            flipScale = 1
        }
    }

    Timer {
        id: swing
        interval: 16
        repeat: true
        onTriggered: {
            if (menu.held) return
            var now = Date.now()
            var remaining = Math.min(0.05, Math.max(0, (now - menu.lastTick) / 1000))
            menu.lastTick = now
            while (remaining > 0) {
                var dt = Math.min(0.008, remaining)
                menu.angularVelocity += (-1300 / menu.chainLength * Math.sin(menu.angle)
                                         - 2.8 * menu.angularVelocity) * dt
                menu.angle += menu.angularVelocity * dt
                // Drop: gravity pulls the lifted sign back to hanging, with
                // one damped bounce, then it settles level. No tilt anywhere.
                if (menu.lift > 0 || menu.dropVelocity !== 0) {
                    menu.dropVelocity += 2600 * dt
                    menu.lift -= menu.dropVelocity * dt
                    if (menu.lift <= 0) {
                        menu.lift = 0
                        menu.dropVelocity = -menu.dropVelocity * 0.3
                        if (Math.abs(menu.dropVelocity) < 80)
                            menu.dropVelocity = 0
                    }
                }
                remaining -= dt
            }
            if (Math.abs(menu.angle) < 0.002 && Math.abs(menu.angularVelocity) < 0.02
                    && menu.lift === 0 && menu.dropVelocity === 0) {
                menu.angle = 0
                menu.angularVelocity = 0
                swing.stop()
            }
        }
    }

    Item {
        visible: false
        Repeater {
            id: measuredRows
            model: menu.entries
            delegate: Text {
                text: modelData.t
                font.family: menu.cabinetRoot.mono
                font.pixelSize: 14
            }
        }
    }

    // The one upper plate stays fixed on the nameplate, in the middle.
    // The chain turns around its top, and the lower mount travels with
    // the level sign. Sway and lift pivot off this one point.
    Image {
        width: 14; height: 24
        x: menu.centerAnchor - width / 2
        y: -15
        source: "model/hanging-menu/upper_left.png"
        smooth: false
    }
    Item {
        x: menu.centerAnchor - width / 2
        y: 5
        // Chain shortens as the sign is lifted, so it stays attached
        // to it, bunching at the top at full lift instead of stretching.
        width: 18; height: Math.max(6, menu.dy - menu.lift - 8)
        transformOrigin: Item.Top
        rotation: -menu.angle * 180 / Math.PI
        Image {
            x: 2; y: 0; width: 14; height: parent.height
            source: "model/hanging-menu/chain_left.png"
            smooth: true
        }
        MouseArea {
            anchors.fill: parent
            cursorShape: pressed ? Qt.ClosedHandCursor : Qt.OpenHandCursor
            onPressed: function(point) { menu.startDrag(this, point) }
            onPositionChanged: function(point) { if (pressed) menu.moveDrag(this, point) }
            onReleased: menu.endDrag()
            onCanceled: menu.endDrag()
        }
    }

    Item {
        id: panel
        objectName: "hangingFilePanel"
        x: menu.sideMargin + menu.dx
        y: menu.dy - menu.lift
        width: menu.panelWidth
        height: rows.height + 22
        // Squeeze on the vertical centre axis while flipping.
        transform: Scale {
            origin.x: panel.width / 2
            origin.y: panel.height / 2
            xScale: menu.flipScale
            yScale: 1
        }

        MouseArea {
            x: 0; y: 0; width: parent.width; height: 12
            z: 4
            cursorShape: pressed ? Qt.ClosedHandCursor : Qt.OpenHandCursor
            onPressed: function(point) { menu.startDrag(this, point) }
            onPositionChanged: function(point) { if (pressed) menu.moveDrag(this, point) }
            onReleased: menu.endDrag()
            onCanceled: menu.endDrag()
        }
        // Front face: the file rows. Hidden while flipped.
        Item {
            anchors.fill: parent
            visible: !menu.flipped
            Rectangle {
                anchors.fill: parent
                radius: 3
                color: "#ad8345"
                border.color: "#d5ad6d"
                border.width: 1
                Rectangle {
                    anchors.fill: parent
                    anchors.margins: 3
                    radius: 1
                    color: "#171e23"
                    border.color: "#644d30"
                    border.width: 1
                }
            }
        Column {
            id: rows
            x: 10; y: 14; width: parent.width - 20; spacing: 4
            Repeater {
                model: menu.entries
                delegate: Item {
                    objectName: "fileMenuRow_" + modelData.a
                    width: rows.width
                    height: Math.max(22, label.implicitHeight + 4)
                    Rectangle {
                        anchors.fill: parent
                        color: rowMouse.containsMouse ? "#534027" : "transparent"
                        radius: 2
                    }
                    Text {
                        id: label
                        x: 4; width: parent.width - 8
                        anchors.verticalCenter: parent.verticalCenter
                        text: modelData.t
                        color: rowMouse.containsMouse ? menu.cabinetRoot.amber : "#f2e9d4"
                        font.family: menu.cabinetRoot.mono
                        font.pixelSize: 14
                        wrapMode: Text.Wrap
                        maximumLineCount: 2
                        elide: Text.ElideRight
                    }
                    MouseArea {
                        id: rowMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            if (modelData.a === "open") {
                                // Do NOT close the menu yet: the dialog lives under
                                // it, and closing first would hide it. onAccepted
                                // below closes the menu once a file is picked.
                                // onRejected leaves the menu open, so the user can
                                // pick another row instead of reopening the sign.
                                openDialog.open()
                            } else if (modelData.a === "save") {
                                host.benchKeep("")
                                menu.open = false
                            } else if (modelData.a === "as") {
                                menu.naming = true
                                nameInput.text = ""
                                nameInput.forceActiveFocus()
                            } else if (modelData.a === "settings") {
                                menu.flipTo(true)
                            }
                            // New entries: add their branch here, matching a above.
                        }
                        C.ToolTip.visible: containsMouse && label.truncated
                        C.ToolTip.text: modelData.t
                    }
                }
            }
            Rectangle {
                visible: menu.naming
                width: rows.width
                height: visible ? 24 : 0
                color: "#f8f0db"
                border.color: "#c39b59"
                TextInput {
                    id: nameInput
                    anchors.fill: parent
                    anchors.margins: 3
                    font.family: menu.cabinetRoot.mono
                    font.pixelSize: 14
                    color: "#211a11"
                    clip: true
                    Keys.onReturnPressed: {
                        if (text.trim()) host.benchKeep(text.trim())
                        menu.open = false
                    }
                    Keys.onEscapePressed: menu.open = false
                }
            }
        }
        } // end front face
        // Back face: settings, to be figured out. Normal text, no
        // rotation at all, so it cannot come out mirrored or blank.
        Item {
            anchors.fill: parent
            visible: menu.flipped
            Rectangle {
                anchors.fill: parent
                radius: 3
                color: "#ad8345"
                border.color: "#d5ad6d"
                border.width: 1
                Rectangle {
                    anchors.fill: parent
                    anchors.margins: 3
                    radius: 1
                    color: "#171e23"
                    border.color: "#644d30"
                    border.width: 1
                }
            }
            Column {
                x: 10; y: 14; width: parent.width - 20; spacing: 4
                Text {
                    text: "SETTINGS"
                    color: menu.cabinetRoot.amber
                    font.family: menu.cabinetRoot.mono
                    font.pixelSize: 14
                }
                Text {
                    text: "to be figured out"
                    color: "#9ba8b8"
                    font.family: menu.cabinetRoot.mono
                    font.pixelSize: 12
                }
                Item {
                    width: parent.width; height: 22
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: "← FILE"
                        color: "#f2e9d4"
                        font.family: menu.cabinetRoot.mono
                        font.pixelSize: 14
                    }
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: menu.flipTo(false)
                    }
                }
            }
        }
        // One lower mount, in the middle, travelling with the sign.
        Image {
            width: 14; height: 20
            x: menu.centerAnchor - menu.sideMargin - width / 2
            y: -9
            source: "model/hanging-menu/lower_left.png"
            smooth: true
        }
    }

    // OPEN's file picker. Starts in the MODELING folder (host.modelingFolder),
    // filtered to models, and loads the picked file into pane 1 via host.openModel.
    // It is not a row, so it does not affect panel size.
    D.FileDialog {
        id: openDialog
        title: "Open model"
        nameFilters: ["Models (*.effigy *.fbx)", "All files (*)"]
        currentFolder: host.modelingFolder
        onAccepted: { menu.open = false; host.openModel(selectedFile.toString()) }
    }
}
