    d = os.path.dirname(os.path.abspath(path))
    while d.startswith(PROJECTS) and d != PROJECTS:
        try:
            if any(n.endswith(".sbproj") for n in os.listdir(d)):
                return d
        except OSError:
            pass
        d = os.path.dirname(d)
