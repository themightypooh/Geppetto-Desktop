    @Slot(int)
    def faceOpen(self, n):
        """open the Face Poser on pane n (0 shuts it); the viewer answers with a face event"""
        self._face_pane = n
        self._face = {}
        self.faceChanged.emit()
        if n:
            self._viewer(n).cmd("face")

    @Slot(str)
    def faceCmd(self, line):
        """face set NAME V [BAL] | preset NAME | zero | random | scale S | save NAME | export PATH, to the posed pane"""
        if self._face_pane:
            self._viewer(self._face_pane).cmd(("face " + line).strip())

    def on_face(self, n, ev):
        if ev.get("message"):
            self.set_status("face: " + ev["message"])
