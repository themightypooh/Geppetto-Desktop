def _extra_system(model):
    """A model's own extra system prompt: inline text, or a file it points at (read fresh each call)."""
    extra = str(model.get('system') or '')
    path = str(model.get('system_file') or '')
    if path:
        try:
            extra = (extra + '\n\n' + Path(path).expanduser().read_text()).strip()
        except OSError:
            pass
    return extra.strip()


def _chat_system(model):
    extra = _extra_system(model)
    return CLAUDE_CHAT + ('\n\n' + extra if extra else '')

def _claude_cli(model, history, cancel, timeout, session=''):
    """Claude via `claude -p` on its own login (the Max plan), with modelling tools, one CLI session per chat."""
    history = [h for h in history if h['role'] in ('you', 'model')][-16:]
    while history and history[0]['role'] != 'you':
        history = history[1:]
    resume = bool(session) and session in _claude_sessions
    if resume or len(history) == 1:
        prompt = _said(history[-1])
    else:     # the chat began with another model: hand Claude what was said so far
        prompt = ('The conversation so far:\n\n' +
                  '\n\n'.join(('User: ' if h['role'] == 'you' else 'Assistant: ') + _said(h) for h in history[:-1]) +
                  '\n\nReply to the user\'s latest message:\n\n' + _said(history[-1]))
    env = child_env()     # allowlist (audit C2): no ANTHROPIC_API_KEY etc. — the CLI's own login is used
    args = [CLAUDE, '-p', '--model', model['model'], '--output-format', 'stream-json', '--include-partial-messages',
            '--verbose', '--setting-sources', 'user', '--append-system-prompt', _chat_system(model),
            '--allowedTools', *CLAUDE_TOOLS]
    if session:
        args += ['--resume', session] if resume else ['--session-id', session]
    else:
        args.append('--no-session-persistence')
    os.makedirs(CLAUDE_HOME, exist_ok=True)
    p = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,
                         cwd=CLAUDE_HOME, text=True)
    timer = threading.Timer(max(timeout, 3600), p.kill)     # a build can take a while
    timer.start()
    said = False
    try:
        p.stdin.write(prompt)
        p.stdin.close()
        for line in p.stdout:
            if cancel is not None and cancel.is_set():
                return
            try:
                data = json.loads(line)
            except ValueError:
                continue
            if session and data.get('type') == 'system':
                _claude_sessions.add(session)
            if data.get('type') == 'stream_event':
                event = data['event']
                delta = event.get('delta', {})
                if delta.get('type') == 'text_delta':
                    said = True
                    yield delta.get('text', '')
                elif event.get('type') == 'content_block_start' and event.get('content_block', {}).get('type') == 'tool_use':
                    yield ('\n\n' if said else '') + '[' + event['content_block'].get('name', 'tool') + ']\n\n'
                    said = False
            elif data.get('type') == 'result' and data.get('is_error'):
                raise RuntimeError('Claude: ' + str(data.get('result') or 'the request failed'))
        if p.wait() != 0:
            raise RuntimeError('claude CLI failed: ' + (p.stderr.read().strip()[-300:] or 'exit %d' % p.returncode))
    finally:
        timer.cancel()
        if p.poll() is None:
            p.kill()


def _grok_cli(model, history, cancel, timeout, session=''):
    """Grok via `grok -p` on its grok.com login, one CLI session per chat."""
    history = [h for h in history if h['role'] in ('you', 'model')][-16:]
    while history and history[0]['role'] != 'you':
        history = history[1:]
    resume = bool(session) and session in _grok_sessions
    if resume or len(history) == 1:
        prompt = _said(history[-1])
    else:
        prompt = ('The conversation so far:\n\n' +
                  '\n\n'.join(('User: ' if h['role'] == 'you' else 'Assistant: ') + _said(h) for h in history[:-1]) +
                  '\n\nReply to the user\'s latest message:\n\n' + _said(history[-1]))
    env = child_env()     # allowlist (audit C2): no GROK_SESSION_ID/XAI_API_KEY etc. — its own login is used
    os.makedirs(CLAUDE_HOME, exist_ok=True)
    # The prompt goes in a 0600 file, not argv (audit G1): argv is world-visible in `ps` /
    # /proc/<pid>/cmdline to every same-user process. grok's --prompt-file is its single-turn
    # file contract, the equivalent of Claude's stdin feed above.
    fd, prompt_path = tempfile.mkstemp(prefix='geppetto-grok-prompt-', dir=CLAUDE_HOME)
    with os.fdopen(fd, 'w') as f:
        f.write(prompt)
    args = [GROK, '--prompt-file', prompt_path, '--model', model['model'], '--output-format', 'streaming-messages-json',
            '--include-partial-messages', '--no-alt-screen', '--no-subagents', '--permission-mode', 'auto',
            '--rules', _chat_system(model), '--cwd', CLAUDE_HOME]
    if session:
        args += ['--resume', session] if resume else ['--session-id', session]
    p = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,
                         cwd=CLAUDE_HOME, text=True)
    timer = threading.Timer(max(timeout, 3600), p.kill)
    timer.start()
    said = False
    try:
        for line in p.stdout:
            if cancel is not None and cancel.is_set():
                return
            try:
                data = json.loads(line)
            except ValueError:
                continue
            if session and data.get('type') == 'system':
                _grok_sessions.add(session)
            if data.get('type') == 'stream_event':
                event = data.get('event') or {}
                delta = event.get('delta') or {}
                if delta.get('type') == 'text_delta':
                    said = True
                    yield delta.get('text', '')
                elif event.get('type') == 'content_block_start' and event.get('content_block', {}).get('type') == 'tool_use':
                    yield ('\n\n' if said else '') + '[' + event['content_block'].get('name', 'tool') + ']\n\n'
                    said = False
            elif data.get('type') == 'result' and data.get('is_error'):
                raise RuntimeError('Grok: ' + str(data.get('result') or 'the request failed'))
        if p.wait() != 0:
            raise RuntimeError('grok CLI failed: ' + (p.stderr.read().strip()[-300:] or 'exit %d' % p.returncode))
    finally:
        timer.cancel()
        if p.poll() is None:
            p.kill()
        try:
            os.unlink(prompt_path)
        except OSError:
            pass


def stream(model, history, cancel=None, timeout=120, notes='', api='', session=''):
    """Yield answer text; native Ollama NDJSON and OpenAI SSE stream immediately."""
    if cancel is not None and cancel.is_set():
        return
    kind = model['kind']
    if kind == 'claude-cli':
        yield from _claude_cli(model, history, cancel, timeout, session)
        return
    if kind == 'grok-cli':
        yield from _grok_cli(model, history, cancel, timeout, session)
        return
    streaming = kind in ('ollama', 'openai')
    try:
        with urllib.request.urlopen(_request(model, history, streaming, notes, api), timeout=timeout) as response:
            ctype = response.headers.get('Content-Type', '')
            if not streaming or ('event-stream' not in ctype and kind != 'ollama'):
                data = json.load(response)
                if cancel is None or not cancel.is_set():
                    yield _reply(kind, data)
                return
            for line in response:
                if cancel is not None and cancel.is_set():
                    return
                line = line.decode().strip()
                if not line or line.startswith(('event:', ':')):
                    continue
                if line.startswith('data:'):
                    line = line[5:].strip()
                if line == '[DONE]':
                    break
                data = json.loads(line)
                if data.get('error'):
                    raise RuntimeError('Model server rejected the request. Check model compatibility and available memory.')
                if kind == 'ollama':
                    yield _reply(kind, data)
                else:
                    yield ((data.get('choices') or [{}])[0].get('delta') or {}).get('content') or ''
    except urllib.error.HTTPError as e:
        e.close()
        raise RuntimeError('%s returned HTTP %d. Check model, credentials and quota.' % (model['label'], e.code)) from None
    except (urllib.error.URLError, socket.timeout, TimeoutError):
        raise RuntimeError('Cannot reach %s or request timed out. Check its model server.' % model['label']) from None
    except (ValueError, KeyError, TypeError):
        raise RuntimeError('%s returned an invalid response.' % model['label']) from None


def complete(model, history, timeout=120):
    text = ''.join(stream(model, history, timeout=timeout)).strip()
    if not text:
        raise RuntimeError(model['label'] + ' sent back no text')
    return text


