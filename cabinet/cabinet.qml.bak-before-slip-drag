            x: buttons.x - width - 14; y: root.g0.bar.faceY + 5
            label: "VIEWPORTS " + (host.autoLayout ? "AUTO " + root.layoutN : root.layoutN) + (vpMenu.open ? " ^" : " v")
            lit: vpMenu.open
