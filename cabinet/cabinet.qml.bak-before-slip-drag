                                }
                            }
                        }
                    }
                }
                Image {                                 // the cover: tips open on hover, drops flat when opened
                    source: root.art + "modelfolder_cover.png"; smooth: false
                    transform: Rotation {
                        origin.x: modelFolder.width / 2; origin.y: modelFolder.height
                        axis { x: 1; y: 0; z: 0 }
                        angle: -folderView.rise * 68
                    }
                }
                MouseArea {                             // the folder itself: hover to peek, click to open it out
                    id: folderMouse
                    objectName: "modelingOpen"
                    anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                    z: -1
                    onClicked: folderView.open = !folderView.open
                }
                SequentialAnimation {
                    id: folderBump
                    NumberAnimation { target: modelFolder; property: "bump"; to: 4; duration: 70; easing.type: Easing.OutQuad }
                    NumberAnimation { target: modelFolder; property: "bump"; to: 0; duration: 240; easing.type: Easing.OutBounce }
                }
            }
        }
    }

    Drawer {
        id: timeline
        objectName: "timeline"
        img: "drawer_timeline.png"; g: root.g0.timeline; side: "b"
        shutX: root.cabX + (root.frameW - g.bodyW) / 2 - g.bodyX
        openX: shutX
        shutY: root.cabY + root.frameH + root.peek - g.bodyH - g.bodyY
        openY: root.cabY + root.frameH - root.tuck - g.bodyY
        Item {
            id: tlFloor
            objectName: "timelineFloor"
            anchors.fill: parent
            anchors.topMargin: root.tuck - timeline.g.floorY + 6
            anchors.leftMargin: 8; anchors.rightMargin: 8
            readonly property real rate: root.clip.rate > 0 ? root.clip.rate : 30
            readonly property int last: Math.max(0, Math.round(root.clip.frames || 0))
            readonly property bool hasClip: last > 0
            // The viewer is the truth, but it answers a frame late: a frame we've asked for is
            // shown straight away, so stepping and scrubbing build on it instead of a stale reply.
            property int want: -1
            readonly property bool waiting: want >= 0
            readonly property int shown: waiting ? want : Math.max(0, Math.min(last, Math.round(root.ph.frame || 0)))
            readonly property bool playing: !waiting && root.ph.playing === true
            readonly property bool looping: root.ph.loop !== false
            readonly property int playX: xOf(shown)
            property real wheelAcc: 0
            // which page is in: 0 the timeline, 1 the dope sheet. The other is slid out of
            // sight past the drawer's side, under the wall.
            property int page: 0
            property real slide: page
            readonly property int gap: 40
            Behavior on slide { NumberAnimation { duration: 280; easing.type: Easing.InOutQuad } }
            onPageChanged: if (page === 1) Qt.callLater(function () { lanes.forceActiveFocus() })

            // one mapping, frame <-> x, for the cursor, the ticks and the mouse alike
            function xOf(f) { return Math.round(f / Math.max(1, last) * (rule.width - 4) / 2) * 2 }
            function frameAt(mx) { return Math.round(Math.max(0, Math.min(1, (mx - 2) / Math.max(1, rule.width - 4))) * last) }
            function seek(f) {
                if (!hasClip) return;
                f = Math.max(0, Math.min(last, Math.round(f)));
                settle.restart();
                if (f === want) return;               // already asked for: don't flood the viewer
                want = f;
                host.cmd("time " + (f / rate).toFixed(5));
            }
            function step(n) { seek(shown + n) }
            function setPlaying(on) {                // no clip still plays: a rig can have a procedural idle
                want = -1;
                host.cmd("play " + (on ? 1 : 0));
            }
            function secs(t) { return t.toFixed(2) + "S" }

            // the reply to what we asked for has arrived (or a new clip has): back to the viewer
            Connections {
                target: host
                function onPlayheadChanged() {
                    if (tlFloor.waiting && !scrub.pressed && !root.ph.playing && root.ph.frame === tlFloor.want) tlFloor.want = -1;
                }
                function onInfoChanged() { if (!scrub.pressed) tlFloor.want = -1 }
            }
            // ...or, if the viewer never says so (rounding, no clip, gone), stop waiting for it
            Timer { id: settle; interval: 800; onTriggered: if (!scrub.pressed) tlFloor.want = -1 }

            Item {
            id: timePage
            objectName: "timePage"
            x: Math.round(-tlFloor.slide * (tlFloor.width + tlFloor.gap) / 2) * 2
            width: tlFloor.width; height: tlFloor.height
            visible: tlFloor.slide < 1
            // ---- row 1: the transport, and the readout
            Row {
                id: transport
                objectName: "transport"
                spacing: 6
                Key { small: true; label: "|<"; onClicked: tlFloor.seek(0) }
                Key { small: true; label: "<"; onClicked: tlFloor.step(-1) }
                Key {
                    objectName: "playKey"
                    label: tlFloor.playing ? "PAUSE" : "PLAY"; lamp: true; lit: tlFloor.playing
                    onClicked: tlFloor.setPlaying(!tlFloor.playing)
                }
                Key { small: true; label: ">"; onClicked: tlFloor.step(1) }
                Key { small: true; label: ">|"; onClicked: tlFloor.seek(tlFloor.last) }
                Key {
                    objectName: "loopKey"
                    label: "LOOP"; lamp: true; lit: tlFloor.looping
                    onClicked: host.cmd("loop " + (tlFloor.looping ? 0 : 1))
                }
            }
            Rectangle {                                  // the LCD
                id: lcd
                x: transport.width + 14; y: 0
                width: tlFloor.width - x; height: 34
                color: "#0b0c0e"; border.width: 2; border.color: "#3a3d41"
                Rectangle { x: 2; y: 2; width: parent.width - 4; height: 2; color: "#000000" }
                Px {
                    x: 10; y: 8; maxWidth: Math.max(0, parent.width - lcdRight.width - 36); maxLines: 1
                    text: tlFloor.hasClip ? (root.clip.name || "clip").toUpperCase() : "NO CLIP"
                    color: tlFloor.hasClip ? root.amber : "#7a5a1c"
                }
                Row {
                    id: lcdRight
                    anchors.right: parent.right; anchors.rightMargin: 10; y: 8
                    spacing: 16
                    Px { objectName: "frameReadout"; text: "F " + tlFloor.shown + "/" + tlFloor.last; color: root.amber }
                    Px {
                        text: tlFloor.secs(tlFloor.shown / tlFloor.rate) + " / " + tlFloor.secs(tlFloor.last / tlFloor.rate)
                        color: "#b07a14"
                    }
                    Px { text: Math.round(tlFloor.rate) + " FPS"; color: "#7a5a1c" }
                }
            }

            // ---- row 2: the steel rule: click or drag to scrub, wheel or arrow keys to step
            Item {
                id: rule
                objectName: "rule"
                y: 44; width: tlFloor.width; height: 44
                activeFocusOnTab: true
                // ticks: every `every` frames, a long one each tenth, so there are never more than ~120
                readonly property int every: {
                    var e = 1;
                    while (tlFloor.last / e > 120) e = e < 2 ? 2 : e < 5 ? 5 : e < 10 ? 10 : e * 2;
                    return e;
                }
                // labels: on long ticks, spaced at least 44 px apart
                readonly property int labelStep: {
                    var e = every * 10;
                    while (tlFloor.hasClip && e / tlFloor.last * width < 44) e *= 2;
                    return e;
                }
                Keys.onPressed: function (e) {
                    var big = (e.modifiers & Qt.ShiftModifier) ? 10 : 1;
                    if (e.key === Qt.Key_Left) tlFloor.step(-big);
                    else if (e.key === Qt.Key_Right) tlFloor.step(big);
                    else if (e.key === Qt.Key_Home) tlFloor.seek(0);
                    else if (e.key === Qt.Key_End) tlFloor.seek(tlFloor.last);
                    else if (e.key === Qt.Key_Space || e.key === Qt.Key_K) tlFloor.setPlaying(!tlFloor.playing);
                    else return;
                    e.accepted = true;
                }
                Image { y: 10; width: parent.width; height: 24; source: root.art + "rule.png"; fillMode: Image.Tile; smooth: false }
                Rectangle {                              // what has played, burnt in amber
                    visible: tlFloor.hasClip
                    y: 4; width: tlFloor.playX + 2; height: 4; color: root.amber
                }
                Repeater {
                    objectName: "ticks"
                    model: tlFloor.hasClip ? Math.floor(tlFloor.last / rule.every) + 1 : 0
                    Rectangle {
                        required property int index
                        readonly property int f: index * rule.every
                        x: tlFloor.xOf(f) + 1; y: 10; width: 2
                        height: f % (rule.every * 10) === 0 ? 14 : f % (rule.every * 5) === 0 ? 9 : 5
                        color: "#1d2128"
                    }
                }
                Rectangle {                              // the end stop, wherever the ticks run out
                    visible: tlFloor.hasClip
                    x: tlFloor.xOf(tlFloor.last) + 1; y: 10; width: 2; height: 14; color: "#1d2128"
                }
                Repeater {
                    id: labels
                    model: tlFloor.hasClip ? Math.floor(tlFloor.last / rule.labelStep) + 1 : 0
                    Px {
                        required property int index
                        x: tlFloor.xOf(index * rule.labelStep) + 4
                        visible: x + width <= rule.width
                        y: 22; size: 6; text: index * rule.labelStep; color: "#1d2128"
                    }
                }
                Px {
                    visible: !tlFloor.hasClip
                    anchors.centerIn: parent; anchors.verticalCenterOffset: 2
                    text: "NO CLIP LOADED"; color: "#1d2128"
                }
                // the playhead: a red cursor with its frame on a flag
                Item {
                    objectName: "playhead"
                    visible: tlFloor.hasClip
                    x: tlFloor.playX; y: 0; width: 4; height: rule.height
                    Rectangle { y: 6; width: 4; height: parent.height - 6; color: root.inkRed }
                    Rectangle { x: -4; y: 6; width: 12; height: 6; color: root.inkRed }
                    Rectangle {
                        readonly property bool flip: tlFloor.playX + width + 8 > rule.width
                        x: flip ? -width + 4 : 0; y: -10
                        width: flagText.width + 10; height: 16; color: root.inkRed
                        Px { id: flagText; x: 5; y: 2; size: 6; text: tlFloor.shown; color: "#f4e9d8" }
                    }
                }
                Rectangle {                              // keyboard focus: arrows, Home/End, Space
                    visible: rule.activeFocus
                    anchors.fill: parent; anchors.topMargin: 8; anchors.bottomMargin: 8
                    color: "transparent"; border.width: 2; border.color: root.amber; opacity: 0.6
                }
                MouseArea {
                    id: scrub
                    objectName: "scrub"
                    anchors.fill: parent
                    enabled: tlFloor.hasClip
                    preventStealing: true
                    cursorShape: Qt.SizeHorCursor
                    property bool resume: false          // a playing clip pauses while scrubbed, then carries on
                    onPressed: function (m) {
                        rule.forceActiveFocus();
                        resume = tlFloor.playing;
                        tlFloor.seek(tlFloor.frameAt(m.x));
                    }
                    onPositionChanged: function (m) { if (pressed) tlFloor.seek(tlFloor.frameAt(m.x)) }
                    onReleased: if (resume) tlFloor.setPlaying(true)
                    onCanceled: if (resume) tlFloor.setPlaying(true)
                    onWheel: function (w) {
                        // a notch is 120; a touchpad sends many small deltas, so add them up
                        tlFloor.wheelAcc += w.angleDelta.y !== 0 ? w.angleDelta.y : w.angleDelta.x;
                        var n = tlFloor.wheelAcc > 0 ? Math.floor(tlFloor.wheelAcc / 120) : Math.ceil(tlFloor.wheelAcc / 120);
                        if (n === 0) return;
                        tlFloor.wheelAcc -= n * 120;
                        tlFloor.step(-n * ((w.modifiers & Qt.ShiftModifier) ? 10 : 1));
                    }
                }
            }

            // ---- row 3: the view switches, then this project's clips as Dymo labels
            Row {
                id: viewKeys
                objectName: "viewKeys"
                y: 98; spacing: 6
                Key { label: "BONES"; lamp: true; lit: root.showBones; onClicked: { root.showBones = !root.showBones; host.cmd("bones " + (root.showBones ? 1 : 0)) } }
                Key { label: "GRID"; lamp: true; lit: root.showGrid; onClicked: { root.showGrid = !root.showGrid; host.cmd("grid " + (root.showGrid ? 1 : 0)) } }
                Key {
                    label: ["SOLID", "WIRE", "BOTH"][root.wire]; lamp: true; lit: root.wire > 0
                    onClicked: { root.wire = (root.wire + 1) % 3; host.cmd("wire " + root.wire) }
                }
                Key { label: "FRAME"; onClicked: host.cmd("frame") }
            }
            Rectangle { x: viewKeys.width + 10; y: 98; width: 2; height: 34; color: "#000000"; opacity: 0.35 }
            Flickable {
                x: viewKeys.width + 22; y: 98
                width: tlFloor.width - x; height: tlFloor.height - y
                contentWidth: clipRow.width
                flickableDirection: Flickable.HorizontalFlick
                boundsBehavior: Flickable.StopAtBounds
                clip: true
                Row {
                    id: clipRow
                    y: 5
                    spacing: 10
                    Tape { visible: host.clips.length === 0; text: "NO CLIPS IN THIS PROJECT" }
                    Repeater {
                        model: host.clips
                        Item {
                            required property var modelData
                            width: ct.width; height: 30
                            Tape { id: ct; text: modelData.name.toUpperCase(); opacity: modelData.fits ? 1 : 0.45 }
                            Rectangle {
                                visible: root.clip.path === modelData.path
                                y: 26; width: ct.width; height: 4; color: root.amber
                            }
                            MouseArea {
                                anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                onClicked: host.playClip(modelData.path)
                            }
                        }
                    }
                }
                WheelHandler {
                    orientation: Qt.Vertical
                    onWheel: function (e) { parent.contentX = Math.max(0, Math.min(parent.contentWidth - parent.width, parent.contentX - e.angleDelta.y)) }
                }
            }
            }

            // ---- page 2: the dope sheet, Geppetto's RigTimeline in the drawer: a row per
            // track, a key per frame keyed, its shape its ease. Click a key to pick it and jump
            // there, drag to move (everything picked moves together), drag empty space to lasso,
            // Delete removes. Ctrl+wheel zooms about the mouse, Shift+wheel pans, the wheel scrolls rows.
            Item {
                id: keyPage
                objectName: "keyPage"
                x: timePage.x + tlFloor.width + tlFloor.gap
                width: tlFloor.width; height: tlFloor.height
                visible: tlFloor.slide > 0

                readonly property var sheet: host.keys
                readonly property var tracks: sheet.tracks || []
                readonly property int rowH: 18
                readonly property int gutter: 132
                readonly property int laneTop: 40                 // under the key row
                readonly property int rulerH: 16
                readonly property int laneW: width - gutter
                readonly property int laneH: height - laneTop - rulerH
                readonly property int last: Math.max(tlFloor.last, sheet.frames || 0, 1)
                readonly property var easeNames: ["SMOOTH", "LINEAR", "STEP", "IN", "OUT", "CUBIC", "MONO"]
                property real ppf: 4                           // pixels per frame
                property real scrollX: 0
                property real scrollY: 0
                property var sel: ({})                         // "track:frame" -> true
                property int selCount: 0
                property string primary: ""                    // the key last picked
                property int activeTrack: -1                   // the row KEY puts a key on
                property int dragDelta: 0
                property bool dragging: false
                property bool committing: false                // a drag sent, its keys not back yet
                property var marquee: null                     // {x0, y0, x1, y1, base} in lane space
                property string hover: ""
                readonly property int selEase: selCount ? easeOf(primary || Object.keys(sel)[0]) : -1   // what the EASE key reads

                function clampScroll() {
                    scrollX = Math.max(0, Math.min(scrollX, last * ppf + 20 - laneW));
                    scrollY = Math.max(0, Math.min(scrollY, tracks.length * rowH - laneH));
                }
                function fit() { ppf = Math.max(0.4, Math.min(80, (laneW - 20) / last)); scrollX = 0; clampScroll(); lanes.requestPaint() }
                function xOf(f) { return Math.round(f * ppf - scrollX) + 6 }
                function frameAt(x) { return (x - 6 + scrollX) / ppf }
                function rowAt(y) { var r = Math.floor((y + scrollY) / rowH); return r >= 0 && r < tracks.length ? r : -1 }
                function keyAt(t, f) {                         // index of the pair at frame f, or -1
                    var k = tracks[t].keys, lo = 0, hi = k.length / 2 - 1;
                    while (lo <= hi) { var m = (lo + hi) >> 1, v = k[m * 2]; if (v === f) return m; if (v < f) lo = m + 1; else hi = m - 1; }
                    return -1;
                }
                function firstFrom(t, f) {                     // first pair at or after frame f
                    var k = tracks[t].keys, lo = 0, hi = k.length / 2;
                    while (lo < hi) { var m = (lo + hi) >> 1; if (k[m * 2] < f) lo = m + 1; else hi = m; }
                    return lo;
                }
                function hit(x, y) {                           // "t:f" of the key under a point
                    var t = rowAt(y);
                    if (t < 0) return "";
                    var k = tracks[t].keys, i = firstFrom(t, Math.floor(frameAt(x - 6))), best = "", bd = 7;
                    for (; i < k.length / 2; i++) {
                        var d = Math.abs(xOf(k[i * 2]) - x);
                        if (xOf(k[i * 2]) - x > bd) break;
                        if (d < bd) { bd = d; best = t + ":" + k[i * 2]; }
                    }
                    return best;
                }
                function setSel(m, p) {
                    var n = 0; for (var key in m) n++;
                    sel = m; selCount = n; primary = p === undefined ? (m[primary] ? primary : "") : p;
                    lanes.requestPaint();
                }
                function refs() { return Object.keys(sel).join(" ") }
                function selectAll() {
                    var m = {};
                    for (var t = 0; t < tracks.length; t++) for (var i = 0; i < tracks[t].keys.length; i += 2) m[t + ":" + tracks[t].keys[i]] = true;
                    setSel(m, "");
                }
                // what the viewer sent back is the truth: a picked key that no longer exists is dropped
                function prune() {
                    var m = {};
                    for (var key in sel) { var p = key.split(":"); if (+p[0] < tracks.length && keyAt(+p[0], +p[1]) >= 0) m[key] = true; }
                    setSel(m);
                }
                function edit(line) { if (tracks.length) host.cmd(line) }
                function deleteSel() { if (selCount) { edit("kdel " + refs()); setSel({}, "") } }
                function easeOf(key) { var p = key.split(":"), i = keyAt(+p[0], +p[1]); return i < 0 ? -1 : tracks[+p[0]].keys[i * 2 + 1] }
                function cycleEase() {
                    if (!selCount) return;
                    var e = easeOf(primary || Object.keys(sel)[0]);
                    edit("kease " + ((e + 1) % 7) + " " + refs());
                }
                function insertKey() {
                    var rows = {};
                    if (activeTrack >= 0) rows[activeTrack] = true;
                    for (var key in sel) rows[key.split(":")[0]] = true;
                    var list = Object.keys(rows);
                    if (!list.length) return;
                    edit("kins " + tlFloor.shown + " " + list.join(" "));
                    var m = {}; for (var i = 0; i < list.length; i++) m[list[i] + ":" + tlFloor.shown] = true;
                    setSel(m, list[0] + ":" + tlFloor.shown);
                }
                function pickRow(t) {
                    activeTrack = t;
                    if (t >= 0 && tracks[t].bone >= 0) host.cmd("select " + tracks[t].bone);
                    lanes.requestPaint();
                }
                function showRow(t) {
                    if (t * rowH < scrollY) scrollY = t * rowH;
                    else if ((t + 1) * rowH > scrollY + laneH) scrollY = (t + 1) * rowH - laneH;
                    clampScroll();
                }
                function zoomAt(x, factor) {                   // the frame under the mouse stays under it
                    var f = frameAt(x);
                    ppf = Math.max(0.4, Math.min(80, ppf * factor));
                    scrollX = f * ppf - (x - 6);
                    clampScroll();
                }

                property string clipPath: root.clip.path || ""
                onClipPathChanged: { activeTrack = -1; setSel({}, ""); scrollY = 0; Qt.callLater(fit) }
                onLaneWChanged: if (laneW > 0) Qt.callLater(fit)
                onScrollXChanged: { lanes.requestPaint(); ruler.requestPaint() }
                onScrollYChanged: lanes.requestPaint()
                onPpfChanged: ruler.requestPaint()
                Connections {
                    target: host
                    function onKeysChanged() { keyPage.committing = false; keyPage.dragDelta = 0; keyPage.prune(); keyPage.clampScroll(); keyPage.lanes_dirty() }
                    function onInfoChanged() {                 // the viewport picked a bone: follow it here
                        var b = host.sel.bone;
                        if (b === undefined || b < 0) return;
                        for (var t = 0; t < keyPage.tracks.length; t++)
                            if (keyPage.tracks[t].bone === b) { keyPage.activeTrack = t; keyPage.showRow(t); break; }
                        keyPage.lanes_dirty();
                    }
                    function onPlayheadChanged() { lanes.requestPaint(); ruler.requestPaint() }
                }
                function lanes_dirty() { lanes.requestPaint(); ruler.requestPaint() }
                // a drag the viewer never answered (it died, or refused): stop waiting for it
                Timer { running: keyPage.committing; interval: 1500; onTriggered: { keyPage.committing = false; keyPage.dragDelta = 0; keyPage.lanes_dirty() } }

                // ---- the key row
                Row {
                    id: keyKeys
                    objectName: "keyKeys"
                    spacing: 6
                    Key { objectName: "keyInsert"; label: "KEY"; opacity: keyPage.activeTrack >= 0 || keyPage.selCount ? 1 : 0.5; onClicked: keyPage.insertKey() }
                    Key { objectName: "keyDelete"; label: "DEL"; opacity: keyPage.selCount ? 1 : 0.5; onClicked: keyPage.deleteSel() }
                    Key {
                        objectName: "keyEase"
                        label: keyPage.selEase >= 0 ? keyPage.easeNames[keyPage.selEase] : "EASE"; opacity: keyPage.selCount ? 1 : 0.5
                        onClicked: keyPage.cycleEase()
                    }
                    Key { objectName: "keyUndo"; label: "UNDO"; opacity: keyPage.sheet.undo > 0 ? 1 : 0.5; onClicked: keyPage.edit("undo") }
                    Key { objectName: "keyRedo"; label: "REDO"; opacity: keyPage.sheet.redo > 0 ? 1 : 0.5; onClicked: keyPage.edit("redo") }
                    Key {
                        objectName: "keySave"
                        label: "SAVE"; lamp: true; lit: keyPage.sheet.dirty === true
                        opacity: keyPage.sheet.saveable ? 1 : 0.5
                        onClicked: if (keyPage.sheet.saveable) keyPage.edit("save")
                    }
                }
                Rectangle {                                    // its LCD
                    x: keyKeys.width + 14
                    width: keyPage.width - x; height: 34
                    color: "#0b0c0e"; border.width: 2; border.color: "#3a3d41"
                    Rectangle { x: 2; y: 2; width: parent.width - 4; height: 2; color: "#000000" }
                    Px {
                        objectName: "keyReadout"
                        x: 10; y: 8; maxWidth: parent.width - 20; maxLines: 1
                        text: !keyPage.tracks.length ? "NO KEYS"
                            : "F " + tlFloor.shown + "  " + keyPage.selCount + " SEL  " + keyPage.tracks.length + " TRK" + (keyPage.sheet.dirty ? "  *" : "")
                        color: keyPage.tracks.length ? root.amber : "#7a5a1c"
                    }
                }

                // ---- the frame ruler: click or drag to scrub
                Rectangle { x: 0; y: keyPage.laneTop; width: keyPage.width; height: keyPage.height - keyPage.laneTop; color: "#121417"; border.width: 2; border.color: "#000000" }
                Canvas {
                    id: ruler
                    objectName: "keyRuler"
                    x: keyPage.gutter; y: keyPage.laneTop
                    width: keyPage.laneW; height: keyPage.rulerH
                    onPaint: {
                        var c = getContext("2d");
                        c.reset();
                        c.fillStyle = "#1d2128"; c.fillRect(0, 0, width, height);
                        var steps = [1, 2, 5, 10, 25, 50, 100, 250, 500, 1000], step = 1000;
                        for (var s = 0; s < steps.length; s++) if (steps[s] * keyPage.ppf >= 38) { step = steps[s]; break; }
                        c.font = "bold 11px '" + root.mono + "'";
                        c.fillStyle = "#8a8f96";
                        for (var f = Math.floor(keyPage.frameAt(0) / step) * step; f <= keyPage.last; f += step) {
                            var x = keyPage.xOf(f);
                            if (x > width) break;
                            if (x < 0) continue;
                            c.fillRect(x, 10, 1, 6);
                            c.fillText(f, x + 3, 10);
                        }
                        var px = keyPage.xOf(tlFloor.shown);
                        c.fillStyle = root.inkRed; c.fillRect(px - 1, 0, 3, height);
                    }
                    MouseArea {
                        anchors.fill: parent
                        preventStealing: true
                        cursorShape: Qt.SizeHorCursor
                        onPressed: function (m) { lanes.forceActiveFocus(); tlFloor.seek(Math.round(keyPage.frameAt(m.x))) }
                        onPositionChanged: function (m) { if (pressed) tlFloor.seek(Math.round(keyPage.frameAt(m.x))) }
                    }
                }

                // ---- the names
                Item {
                    id: names
                    x: 2; y: keyPage.laneTop + keyPage.rulerH
                    width: keyPage.gutter - 4; height: keyPage.laneH - 2
                    clip: true
                    Repeater {
                        model: keyPage.tracks.length
                        Item {
                            required property int index
                            readonly property var track: keyPage.tracks[index]
                            readonly property bool picked: index === keyPage.activeTrack
                            y: index * keyPage.rowH - keyPage.scrollY
                            visible: y > -keyPage.rowH && y < names.height
                            width: names.width; height: keyPage.rowH
                            Rectangle { anchors.fill: parent; color: picked ? "#3a2a0c" : index % 2 ? "#181b1f" : "transparent" }
                            Rectangle { visible: picked; width: 3; height: parent.height; color: root.amber }
                            Px {
                                x: 7; y: 0; size: 6; maxWidth: parent.width - 10; maxLines: 1
                                text: (track.kind === "Bone" ? "" : track.kind.toUpperCase() + " ") + track.name
                                color: picked ? root.amber : track.bone >= 0 || track.kind !== "Bone" ? root.keyText : "#6b6f75"
                            }
                            MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: { lanes.forceActiveFocus(); keyPage.pickRow(index) } }
                        }
                    }
                    WheelHandler { onWheel: function (e) { keyPage.scrollY -= e.angleDelta.y / 120 * keyPage.rowH; keyPage.clampScroll() } }
                }
                Rectangle { x: keyPage.gutter - 2; y: keyPage.laneTop; width: 2; height: keyPage.height - keyPage.laneTop; color: "#000000" }

                // ---- the lanes
                Canvas {
                    id: lanes
                    objectName: "keyLanes"
                    x: keyPage.gutter; y: keyPage.laneTop + keyPage.rulerH
                    width: keyPage.laneW - 2; height: keyPage.laneH - 2
                    activeFocusOnTab: true
                    renderStrategy: Canvas.Cooperative
                    readonly property var segColor: ["#5fae5a", "#5a8fd0", "#6b6f75", "#4c8a48", "#4c8a48", "#d9b13a", "#a88a34"]
                    function shape(c, x, y, r, e) {
                        c.beginPath();
                        if (e === 1) { c.moveTo(x, y - r); c.lineTo(x + r, y); c.lineTo(x, y + r); c.lineTo(x - r, y); }
                        else if (e === 5 || e === 6) {
                            var sq = e === 6 ? 0.7 : 1;
                            for (var i = 0; i < 6; i++) { var a = Math.PI / 3 * i; c.lineTo(x + Math.cos(a) * r, y + Math.sin(a) * r * sq); }
                        } else if (e === 2) { var s = r * 0.85; c.rect(x - s, y - s, s * 2, s * 2); }
                        else c.arc(x, y, r, 0, Math.PI * 2);
                        c.closePath(); c.fill();
                    }
                    function eased(e, t) { return e === 0 ? (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2) : e === 3 ? t * t : e === 4 ? 1 - (1 - t) * (1 - t) : t }
                    onPaint: {
                        var c = getContext("2d"), K = keyPage, tr = K.tracks;
                        c.reset();
                        c.fillStyle = "#121417"; c.fillRect(0, 0, width, height);
                        var r0 = Math.max(0, Math.floor(K.scrollY / K.rowH)), r1 = Math.min(tr.length - 1, Math.floor((K.scrollY + height) / K.rowH));
                        var f0 = Math.floor(K.frameAt(-10)), f1 = Math.ceil(K.frameAt(width + 10));
                        for (var t = r0; t <= r1; t++) {
                            var top = t * K.rowH - K.scrollY;
                            if (t === K.activeTrack) { c.fillStyle = "#2a2010"; c.fillRect(0, top, width, K.rowH); }
                            else if (t % 2) { c.fillStyle = "#181b1f"; c.fillRect(0, top, width, K.rowH); }
                        }
