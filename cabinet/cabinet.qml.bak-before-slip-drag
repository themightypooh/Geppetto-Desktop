            text: (runDrag.run ? (runDrag.run.prompt || runDrag.run.name || "").slice(0, 32) : "")
                  + (runDrag.over ? "  -> PANE " + runDrag.over : "  (drop on a pane)")
            color: runDrag.over ? root.amber : root.keyText; font.family: root.mono; font.pixelSize: 11
        }
