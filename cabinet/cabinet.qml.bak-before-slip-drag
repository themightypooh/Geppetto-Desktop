                Row {
                    x: 4; y: 26; spacing: Math.max(0, Math.floor((toolFloor.width - 8 - liveRow.keys.length * root.g0.keyS.w) / (liveRow.keys.length - 1)))
                    Repeater {                           // each key pops up a beat after the last
                        model: liveRow.keys
                        Item {
