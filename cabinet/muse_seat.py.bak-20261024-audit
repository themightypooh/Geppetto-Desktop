#!/usr/bin/env python3
"""Muse seat for Geppetto — NO API key, NO muse CLI, NO network.

How it works (file bridge, modelled on Roundtable's zoobie_seat.py, because
this Muse personal agent has no CLI/API that Geppetto can call directly, and
the local `muse` CLI still returns a 402 billing error as of 2026-10-24):

  Geppetto's cabinet/chat.py runs this script as a roundtable-cli seat,
  prompt on stdin, via roundtable_catalog.command() which passes:
    --provider muse --model muse-bridge [--act]

  This script writes the prompt to cabinet/muse-seat/requests/<turn>.json
  and polls for cabinet/muse-seat/responses/<turn>.json.
  The Muse session (over Tailscale SSH, already connected to this machine)
  reads the request, answers, edits files in the request's workspace when
  asked, and writes the response file. This script then prints
  Claude-style stream-json that cabinet/chat.py already understands:
    {"type": "system", "session_id": ...}
    {"type": "result", "result": "...", "session_id": ...}

Timeout: 19 minutes, just inside Geppetto's long-turn window, so a late
Muse answer fails cleanly instead of racing the app's kill.
No secrets, no API keys, no subprocesses, no network calls in this script.
The responder (Muse) is the only side that touches files, and only in the
workspace recorded in the request — never outside it.

Build mode (v2, 2026-10-24): when Geppetto runs this seat in Build mode,
cabinet/chat.py goes through build_execution.checked_stream, which creates
a BuildTurn and injects GEPPETTO_BUILD_RECEIPTS / GEPPETTO_BUILD_TOKEN
into this process's environment (via build_execution.child_environment).
This script forwards those two values, plus mode="build", in the request
JSON — they are per-turn, on the user's own machine, and are exactly what
geppetto-live needs to call build_execution.record() after a real live
run. The responder MUST export them when running geppetto-live, run a
real Effigy build script, and only then write the response file, so the
receipt is already written before this script prints the result and
checked_stream checks for it. A text-only reply in Build mode produces
no receipt and checked_stream will reject it, by design. In Plan mode
those env vars are absent and the request is unchanged apart from
mode="plan".
"""
import argparse
import json
import os
import sys
import time
import uuid
from pathlib import Path

BASE = Path(__file__).resolve().parent / "muse-seat"
REQ = BASE / "requests"
RES = BASE / "responses"
STATUS = BASE / "status"


def write_status(turn, session, mode, stage, sent_at, extra=None):
    try:
        STATUS.mkdir(parents=True, exist_ok=True)
        now = time.time()
        data = {"turn_id": turn, "session_id": session, "mode": mode, "stage": stage,
                "sent_at": sent_at, "last_check": now}
        if extra:
            data.update(extra)
        # Preserve worker-set stage/times if a later seat poll would overwrite them.
        for f in (STATUS / f"{turn}.json", STATUS / "latest.json"):
            try:
                old_data = json.loads(f.read_text(encoding="utf-8")) if f.exists() else {}
            except (OSError, ValueError):
                old_data = {}
            merged = dict(old_data)
            merged.update(data)
            # Worker stages win over seat polling: never downgrade Picked up/Thinking/Building.
            if old_data.get("stage") in ("Picked up", "Thinking", "Building", "Reply written") and stage in ("Sent", "Queued"):
                merged["stage"] = old_data["stage"]
            for k in ("picked_up_at", "replied_at"):
                if old_data.get(k) and not merged.get(k):
                    merged[k] = old_data[k]
            f.write_text(json.dumps(merged, ensure_ascii=False), encoding="utf-8")
    except OSError:
        pass
POLL_SECS = 5
TIMEOUT_SECS = 19 * 60


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--provider", default="muse")
    ap.add_argument("--model", default="muse-bridge")
    ap.add_argument("--act", action="store_true",
                    help="Build mode was requested; recorded for the responder, "
                         "Geppetto itself gates Build mode by model capabilities.")
    ap.add_argument("--session", default="")
    a = ap.parse_args()
    prompt = sys.stdin.read()
    if not prompt.strip():
        print("muse_seat: empty prompt on stdin", file=sys.stderr)
        return 1
    turn = uuid.uuid4().hex[:12]
    session = a.session or ("muse-" + turn)
    REQ.mkdir(parents=True, exist_ok=True)
    RES.mkdir(parents=True, exist_ok=True)
    req_file = REQ / f"{turn}.json"
    res_file = RES / f"{turn}.json"
    mode = "build" if a.act else "plan"
    receipts = os.environ.get("GEPPETTO_BUILD_RECEIPTS")
    token = os.environ.get("GEPPETTO_BUILD_TOKEN")
    if mode == "build" and not (receipts and token):
        print("muse_seat: Build mode but no GEPPETTO_BUILD_RECEIPTS/TOKEN in "
              "environment; a Build receipt cannot be produced for this turn.",
              file=sys.stderr)
    req_file.write_text(json.dumps({
        "turn_id": turn, "session_id": session,
        "prompt": prompt, "status": "pending",
        "provider": a.provider, "model": a.model, "act": bool(a.act),
        "mode": mode,
        "build_receipts": receipts, "build_token": token,
        "cwd": os.getcwd(),
    }, ensure_ascii=False), encoding="utf-8")
    sent_at = time.time()
    write_status(turn, session, mode, "Sent", sent_at)
    write_status(turn, session, mode, "Queued", sent_at)
    print(json.dumps({"type": "system", "session_id": session}), flush=True)
    deadline = time.time() + TIMEOUT_SECS
    while time.time() < deadline:
        if res_file.exists():
            try:
                data = json.loads(res_file.read_text(encoding="utf-8"))
                text = (data.get("result") or data.get("text") or "").strip()
            except (OSError, ValueError) as e:
                print(f"muse_seat: bad response file: {e}", file=sys.stderr)
                return 1
            if text:
                write_status(turn, session, mode, "Reply written", sent_at, {"replied_at": time.time()})
                print(json.dumps({"type": "result", "result": text,
                                  "session_id": session}), flush=True)
                return 0
            print("muse_seat: empty response file", file=sys.stderr)
            return 1
        write_status(turn, session, mode, "Queued", sent_at)
        time.sleep(POLL_SECS)
    print("muse_seat: timed out waiting for Muse (19 min, no response file). "
          "Muse was not watching the queue, or the reply is still being written — "
          "check cabinet/muse-seat/requests/ and try again.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
