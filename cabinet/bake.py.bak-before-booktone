    geom["folder"] = bake_folder("folder.png")
    geom["scroll3d"] = bake_scroll3d("scroll3d")
    geom["chisel3d"] = bake_turning("chisel3d", "chisel", 60, CHISEL_PARTS, 2)
    geom["modelfolder"] = bake_modelfolder("modelfolder")
