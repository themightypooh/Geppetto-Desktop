# On Wayland a window can't put itself in front; KWin can, through a one-shot script.
RAISE_JS = """
for (const w of workspace.windowList()) {
    if (w.resourceClass === "geppetto") { w.minimized = false; workspace.activeWindow = w; }
}
"""


def kwin_raise():
    """bring the chest to the front even when it doesn't have focus (KDE; silently nothing elsewhere)"""
    def go():
        try:
            path = os.path.join(tempfile.gettempdir(), "geppetto-raise-%d.js" % os.getuid())
            with open(path, "w") as f:
                f.write(RAISE_JS)
            q = ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting."]
            subprocess.run(q[:3] + [q[3] + "unloadScript", "geppetto-raise"], capture_output=True, timeout=3)
            subprocess.run(q[:3] + [q[3] + "loadScript", path, "geppetto-raise"], capture_output=True, timeout=3)
            subprocess.run(q[:3] + [q[3] + "start"], capture_output=True, timeout=3)
            time.sleep(0.5)
            subprocess.run(q[:3] + [q[3] + "unloadScript", "geppetto-raise"], capture_output=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            pass
    threading.Thread(target=go, daemon=True).start()


def any_script_running():
    """some marionette-desktop is running a live script (for older runs that recorded no pid)"""
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                with open("/proc/%s/cmdline" % pid, "rb") as f:
                    cmd = f.read()
            except OSError:
                continue
            if b"marionette-desktop" in cmd and b"--script" in cmd:
                return True
    return False


def run_is_live(d, state):
    """a run still building: not finished, and its journal moved in the last 10 minutes (a crashed run goes quiet)"""
    if not state or state.get("state") in TERMINAL:
        return False
    # a script run records its pid beside the folder: once that process is gone the run is dead,
    # however fresh its journal still looks
    try:
        pid = int(json.load(open(d.rstrip("/") + ".json")).get("pid", 0))
    except (OSError, ValueError, TypeError, AttributeError):
        pid = 0
    if pid > 0:
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                if b"marionette-desktop" not in f.read():
                    return False
        except OSError:
            return False
    elif not any_script_running():
        return False
    try:
        return time.time() - os.stat(os.path.join(d, ".live", "events.jsonl")).st_mtime < 600
    except OSError:
        return False


def send(msg):
    """send a command to a running chest; True if one answered"""
    s = QLocalSocket()
    s.connectToServer(SOCK)
    if not s.waitForConnected(500):
        return False
    s.write(msg.encode())
    s.flush()
    s.waitForBytesWritten(500)
    s.waitForReadyRead(3000)
    print(bytes(s.readAll()).decode() or "ok")
    s.disconnectFromServer()
    return True


def project_root(path):
    """the s&box project a file belongs to: the nearest folder up with a .sbproj in it"""
    d = os.path.dirname(os.path.abspath(path))
    while d.startswith(PROJECTS) and d != PROJECTS:
        try:
            if any(n.endswith(".sbproj") for n in os.listdir(d)):
                return d
        except OSError:
            pass
        d = os.path.dirname(d)
    return None


def filed_stickers():
    """what's in the MODELING folder, newest first: finished runs' stickers and the models you kept"""
    return sorted(stickerlib.filed(RUNS) + stickerlib.filed(MODELING), key=os.path.getmtime, reverse=True)


def kept_model(d):
    return os.path.join(d, os.path.basename(d) + ".effigy")


def folder_entry(sticker):
    """one slip in the MODELING folder: its picture, its name, and what opening it puts on screen"""
    d = os.path.dirname(sticker)
    if os.path.dirname(d) == MODELING:
        try:
            name = json.load(open(os.path.join(d, "kept.json"))).get("name", "")
        except (OSError, ValueError, AttributeError):
            name = ""
        return {"sticker": "file://" + sticker, "name": name or os.path.basename(d), "kind": "model", "path": kept_model(d)}
    return {"sticker": "file://" + sticker, "name": run_name(d), "kind": "run", "path": d}


def run_name(d):
    """what a run made, in a word or two: its prompt, or for a build script the folder it lives in"""
    try:
        meta = json.load(open(d + ".json"))
        name = meta.get("prompt", "")
        if meta.get("script") and name.startswith("script:"):
            name = os.path.basename(os.path.dirname(meta["script"]))
            if name.lower() in ("run", "runs", "scratchpad", "tmp", "build", "scripts", "out", ""):
                name = os.path.splitext(os.path.basename(meta["script"]))[0]   # a throwaway folder: the script's own name
    except (OSError, ValueError, AttributeError):
        name = ""
    if not name or name.startswith("script:"):
        name = re.sub(r"-?\d{8}-\d{6}", "", os.path.basename(d)) or os.path.basename(d)
    return name[:60]


def walk(root, exts, limit, skip=("backups", ".sbox", "obj", "bin", "node_modules", ".git")):
    out = []
    for d, dirs, files in os.walk(root):
        dirs[:] = sorted(x for x in dirs if x not in skip and not x.startswith("."))
        for f in sorted(files):
            if f.lower().endswith(exts):
                out.append(os.path.join(d, f))
                if len(out) >= limit:
                    return out
    return out


def clip_source(clip, root):
    """the model a .riganim was authored on (its SourceModel), as a file the viewer can load:
    the .fbx/.effigy next to the .vmdl, else the .vmdl path itself. None if it doesn't say."""
    try:
        with open(clip, encoding="utf-8", errors="replace") as f:
            m = re.search(r'"SourceModel"\s*:\s*"([^"]*)"', f.read(4096))
    except OSError:
        return None
    if not m or not m.group(1):
        return None
    rel = m.group(1)
    stem = os.path.splitext(os.path.join(root, "Assets", rel))[0]
    for ext in (".fbx", ".effigy", ".FBX"):
        if os.path.isfile(stem + ext):
            return stem + ext
    return stem + os.path.splitext(rel)[1]


def same_model(a, b):
    return bool(b) and os.path.splitext(os.path.abspath(a))[0] == os.path.splitext(os.path.abspath(b))[0]



LAST_OPEN = os.path.expanduser("~/.cache/geppetto/chest-last.json")

def remember_open(model, clip=""):
    """the model (and clip) on screen, so a restarted chest reopens them"""
    try:
        os.makedirs(os.path.dirname(LAST_OPEN), exist_ok=True)
        with open(LAST_OPEN, "w") as f:
            json.dump({"model": model, "clip": clip}, f)
    except OSError:
        pass

def last_open():
    try:
        with open(LAST_OPEN) as f:
            d = json.load(f)
        if os.path.isfile(d.get("model", "")):
            if d.get("clip") and not os.path.isfile(d["clip"]): d["clip"] = ""
            return d
    except (OSError, ValueError):
        pass
    return None

class Viewport(QQuickPaintedItem):
    """shows the latest frame from the serve process, 1:1; `pane` 1 is the host's viewer, 2-4 the split panes"""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setOpaquePainting(True)
        self._pane = 1
        HOST.frameReady.connect(self.update)
        for pane in HOST.panes:
            pane.frameReady.connect(self._pane_frame)

    def _pane_frame(self):
        if self._pane > 1 and self.sender() is HOST.panes[self._pane - 2]:
            self.update()

    def _set_pane(self, n):
        self._pane = max(1, min(1 + len(HOST.panes), int(n)))
        self.update()
    pane = Property(int, lambda self: self._pane, _set_pane)

    def paint(self, p):
        img = HOST.image if self._pane == 1 else HOST.panes[self._pane - 2].image
        if img is None:
            p.fillRect(0, 0, int(self.width()), int(self.height()), Qt.black)
            return
        p.drawImage(QRect(0, 0, int(self.width()), int(self.height())), img)


