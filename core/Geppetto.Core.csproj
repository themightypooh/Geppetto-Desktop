<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kernel parity provenance (2026-11-13, define-shared-kernel-provenance-and-parity-merge-contract):
       Desktop core/ is canonical for itself and consumes the kernel only via
       the ProjectReference below. Inventory: handoffs/kernel-parity-inventory.json.
       Policy: handoffs/kernel-parity-contract.md. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Marionette.Desktop</RootNamespace>
    <AssemblyName>Geppetto.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../kernel/Effigy.Kernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>marionette-desktop</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Desktop.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
